00098B  1  A9 88                lda #RIGHTW - PADW
00098D  1  8D 2E 0F     @c:     sta px
000990  1  18                   clc                     ; sprites 1 and 2 (16 + 4 pixels)
000991  1  69 10                adc #16
000993  1  8D 08 D4             sta SPR+8
000996  1  69 10                adc #16
000998  1  8D 10 D4             sta SPR+16
00099B  1  A9 CA                lda #PADY + 16
00099D  1  8D 09 D4             sta SPR+9
0009A0  1  8D 11 D4             sta SPR+17
0009A3  1  60                   rts
0009A4  1               
0009A4  1               ; The ball sprite at bx, by (the integer parts)
0009A4  1               ballspr:
0009A4  1  AD 27 0F             lda bx+1
0009A7  1  18                   clc
0009A8  1  69 10                adc #16
0009AA  1  8D 00 D4             sta SPR
0009AD  1  AD 29 0F             lda by+1
0009B0  1  18                   clc
0009B1  1  69 10                adc #16
0009B3  1  8D 01 D4             sta SPR+1
0009B6  1  60                   rts
0009B7  1               
0009B7  1               ; --- the ball moving: walls, paddle, bricks, out ----------------------------------------
0009B7  1               moveball:
0009B7  1  AD 26 0F             lda bx                  ; bx += vx
0009BA  1  18                   clc
0009BB  1  6D 2A 0F             adc vx
0009BE  1  8D 26 0F             sta bx
0009C1  1  AD 27 0F             lda bx+1
