000000r 1               ;=============================================================================
000000r 1               ; breakout.asm - a small Breakout for mini6502             (main RAM, $0800)
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Public domain. 160x200 graphics with the text layer on top for the score,
000000r 1               ; the mouse moves the paddle, a click launches the ball, Esc quits.
000000r 1               ;
000000r 1               ;   from the desktop: double-click BREAKOUT
000000r 1               ;   from the monitor: L BREAKOUT  then  0800R
000000r 1               ;   from BASIC:       LOAD with the monitor first, then CALL $0800 (it loads
000000r 1               ;                     over BASIC's program area)
000000r 1               ; Uses no zero page and nothing outside $0800-its end, so it can return to
000000r 1               ; whoever called it.
000000r 1               ;=============================================================================
000000r 1               
000000r 1               SYSCTL  = $D000
000000r 1               FRAME   = $D001
000000r 1               KBD     = $D010
000000r 1               KBDCR   = $D011
000000r 1               DSP     = $D012
000000r 1               CURX    = $D015
000000r 1               CURY    = $D016
000000r 1               COLOR   = $D021
000000r 1               NOTE    = $D030         ; voice 1: NOTE, VOL, WAVE, DUR
000000r 1               VOL     = $D031
000000r 1               WAVE    = $D032
000000r 1               DUR     = $D033
000000r 1               NOTE2   = $D034         ; voice 2
000000r 1               VOL2    = $D035
000000r 1               WAVE2   = $D036
000000r 1               DUR2    = $D037
000000r 1               PADR    = $D200         ; port A
000000r 1               PDATA   = $D203
000000r 1               PSTEP   = $D204
000000r 1               MODE    = $D300
000000r 1               BX0     = $D310         ; blitter
000000r 1               BY0     = $D311
000000r 1               BX1     = $D312
000000r 1               BY1     = $D313
000000r 1               BCOL    = $D314
000000r 1               BCMD    = $D318
000000r 1               SPR     = $D400         ; sprite N: X, Y, IMAGE, FLAGS at $D400 + 8N
000000r 1               CLICKS  = $D506
000000r 1               PTR     = $D508
000000r 1               MOUSEX  = $D550         ; mouse X in 160x200 pixels
000000r 1               
000000r 1               C_CLEAR = 1
000000r 1               C_BOXF  = 5
000000r 1               
000000r 1               COLS    = 12            ; bricks: 12 x 6, 11 x 5 pixels, 12 x 6 apart
000000r 1               BROWS   = 6
000000r 1               NBRICKS = COLS * BROWS
000000r 1               BRX     = 8             ; first brick's left edge
000000r 1               BRY     = 24            ; first brick's top edge
000000r 1               LEFTW   = 4             ; the walls: x 0-3 and 156-159, y 8-11 at the top
000000r 1               RIGHTW  = 156
000000r 1               TOPW    = 12
000000r 1               PADY    = 186           ; paddle: 20 x 3 at y 186
000000r 1               PADW    = 20
000000r 1               BALLW   = 2             ; ball: 2 x 3
000000r 1               BALLH   = 3
000000r 1               
000000r 1                       .org $0800
000800  1               
000800  1               start:
000800  1  D8                   cld
000801  1  BA                   tsx                     ; to return from anywhere (Esc)
000802  1  8E 25 0F             stx savesp
000805  1  A9 03                lda #3                  ; video and sound as at power-on
000807  1  8D 00 D0             sta SYSCTL
00080A  1  A9 0F                lda #$0F                ; text layer cleared: see-through (black
00080C  1  8D 21 D0             sta COLOR               ; background = TRANSP 0)
00080F  1  A9 02                lda #2
000811  1  8D 00 D0             sta SYSCTL
000814  1  20 C2 0D             jsr images
000817  1  A9 01                lda #1                  ; paddle: sprites 1 and 2, images 1 and 2
000819  1  8D 0A D4             sta SPR+10
00081C  1  8D 0B D4             sta SPR+11
00081F  1  8D 13 D4             sta SPR+19
000822  1  A9 02                lda #2
000824  1  8D 12 D4             sta SPR+18
000827  1  A9 00                lda #0                  ; ball: sprite 0, image 0
000829  1  8D 02 D4             sta SPR+2
00082C  1  A9 02                lda #2                  ; graphics, the text layer on top
00082E  1  8D 00 D3             sta MODE
000831  1  A9 0C                lda #12                 ; sound: voice 1 square, voice 2 triangle
000833  1  8D 31 D0             sta VOL
000836  1  8D 35 D0             sta VOL2
000839  1  A9 00                lda #0
00083B  1  8D 32 D0             sta WAVE
00083E  1  A9 01                lda #1
000840  1  8D 36 D0             sta WAVE2
000843  1               
000843  1               newgame:
000843  1  A9 03                lda #3
000845  1  8D 31 0F             sta lives
000848  1  A9 01                lda #1
00084A  1  8D 32 0F             sta level
00084D  1  A9 00                lda #0
00084F  1  8D 33 0F             sta score
000852  1  8D 34 0F             sta score+1
000855  1               newlevel:
000855  1  20 8C 0B             jsr setbricks
000858  1  20 9C 0B             jsr drawfield
00085B  1  20 58 0C             jsr status
00085E  1  20 08 09             jsr serve
000861  1               
000861  1               ; --- the game loop: once a frame ---------------------------------------------------
000861  1  AD 01 D0     loop:   lda FRAME
000864  1  CD 01 D0     @w:     cmp FRAME
000867  1  F0 FB                beq @w
000869  1  AD 11 D0             lda KBDCR               ; Esc quits
00086C  1  10 0C                bpl @nokey
00086E  1  AD 10 D0             lda KBD
000871  1  29 7F                and #$7F
000873  1  C9 1B                cmp #27
000875  1  D0 03                bne @nokey
000877  1  4C F4 08             jmp quit
00087A  1  20 77 09     @nokey: jsr paddle
00087D  1  AD 2F 0F             lda stuck
000880  1  F0 10                beq @move
000882  1  20 23 09             jsr onpaddle            ; waiting on the paddle for a click
000885  1  AD 06 D5             lda CLICKS
000888  1  29 01                and #1
00088A  1  F0 11                beq @show
00088C  1  20 3A 09             jsr launch
00088F  1  4C 9D 08             jmp @show
000892  1  20 B7 09     @move:  jsr moveball
000895  1  AD 30 0F             lda lost
000898  1  F0 03                beq @show
00089A  1  4C B0 08             jmp loseball
00089D  1  20 A4 09     @show:  jsr ballspr
0008A0  1  AD 35 0F             lda left
0008A3  1  D0 BC                bne loop
0008A5  1  EE 32 0F             inc level               ; all gone: next level, a little faster
0008A8  1  A9 54                lda #84
0008AA  1  20 83 0B             jsr sound2
0008AD  1  4C 55 08             jmp newlevel
0008B0  1               
0008B0  1               ; A ball lost: one life less; none left: game over
0008B0  1               loseball:
0008B0  1  A9 24                lda #36
0008B2  1  A2 1E                ldx #30
0008B4  1  20 7C 0B             jsr sound
0008B7  1  CE 31 0F             dec lives
0008BA  1  20 58 0C             jsr status
0008BD  1  AD 31 0F             lda lives
0008C0  1  F0 06                beq gameover
0008C2  1  20 08 09             jsr serve
0008C5  1  4C 61 08             jmp loop
0008C8  1               
0008C8  1               gameover:
0008C8  1  A9 00                lda #0                  ; ball away
0008CA  1  8D 03 D4             sta SPR+3
0008CD  1  A9 75                lda #<s_over
0008CF  1  A2 0D                ldx #>s_over
0008D1  1  A0 18                ldy #24
0008D3  1  20 AC 0C             jsr message
0008D6  1  AD 06 D5             lda CLICKS
0008D9  1  AD 11 D0     @w:     lda KBDCR
0008DC  1  10 09                bpl @m
0008DE  1  AD 10 D0             lda KBD
0008E1  1  29 7F                and #$7F
0008E3  1  C9 1B                cmp #27
0008E5  1  F0 0D                beq quit
0008E7  1  AD 06 D5     @m:     lda CLICKS
0008EA  1  29 01                and #1
0008EC  1  F0 EB                beq @w
0008EE  1  20 D7 0C             jsr clearmsg
0008F1  1  4C 43 08             jmp newgame
0008F4  1               
0008F4  1  AE 25 0F     quit:   ldx savesp
0008F7  1  9A                   txs
0008F8  1  A9 03                lda #3                  ; everything as at power-on: text mode
0008FA  1  8D 00 D0             sta SYSCTL
0008FD  1  A9 07                lda #$07
0008FF  1  8D 21 D0             sta COLOR
000902  1  A9 02                lda #2
000904  1  8D 00 D0             sta SYSCTL              ; clear the screen
000907  1  60                   rts
000908  1               
000908  1               ; --- the ball waiting on the paddle ----------------------------------------------------
000908  1  A9 01        serve:  lda #1
00090A  1  8D 2F 0F             sta stuck
00090D  1  A9 00                lda #0
00090F  1  8D 30 0F             sta lost
000912  1  A9 01                lda #1                  ; the ball sprite on
000914  1  8D 03 D4             sta SPR+3
000917  1  AD 06 D5             lda CLICKS              ; (forget older clicks)
00091A  1  A9 65                lda #<s_click
00091C  1  A2 0D                ldx #>s_click
00091E  1  A0 1F                ldy #31
000920  1  4C AC 0C             jmp message
000923  1               
000923  1               onpaddle:
000923  1  AD 2E 0F             lda px                  ; on the middle of the paddle
000926  1  18                   clc
000927  1  69 09                adc #(PADW - BALLW) / 2
000929  1  8D 27 0F             sta bx+1
00092C  1  A9 B7                lda #PADY - BALLH
00092E  1  8D 29 0F             sta by+1
000931  1  A9 00                lda #0
000933  1  8D 26 0F             sta bx
000936  1  8D 28 0F             sta by
000939  1  60                   rts
00093A  1               
00093A  1  A9 00        launch: lda #0
00093C  1  8D 2F 0F             sta stuck
00093F  1  20 D7 0C             jsr clearmsg
000942  1  20 50 09             jsr speed               ; up, a little to the right
000945  1  A9 80                lda #<128
000947  1  8D 2A 0F             sta vx
00094A  1  A9 00                lda #>128
00094C  1  8D 2B 0F             sta vx+1
00094F  1  60                   rts
000950  1               
000950  1               ; vy = -(1.25 + level / 4) pixels a frame (8.8), at most 3
000950  1  AD 32 0F     speed:  lda level
000953  1  0A                   asl
000954  1  0A                   asl
000955  1  0A                   asl
000956  1  0A                   asl
000957  1  0A                   asl
000958  1  0A                   asl                     ; level * 64 = level / 4 in 8.8
000959  1  18                   clc
00095A  1  69 40                adc #<320
00095C  1  8D 2C 0F             sta vy
00095F  1  A9 01                lda #>320
000961  1  69 00                adc #0
000963  1  8D 2D 0F             sta vy+1
000966  1  C9 03                cmp #3
000968  1  90 0A                bcc @ok
00096A  1  A9 00                lda #0
00096C  1  8D 2C 0F             sta vy
00096F  1  A9 03                lda #3
000971  1  8D 2D 0F             sta vy+1
000974  1  4C 30 0B     @ok:    jmp negvy               ; upwards
000977  1               
000977  1               ; --- paddle: follows the mouse ------------------------------------------------------------
000977  1  AD 50 D5     paddle: lda MOUSEX
00097A  1  38                   sec
00097B  1  E9 0A                sbc #PADW / 2
00097D  1  B0 02                bcs @a
00097F  1  A9 00                lda #0
