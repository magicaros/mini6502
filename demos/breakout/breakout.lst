0009E0  1  C9 04                cmp #LEFTW
0009E2  1  B0 0B                bcs @r
0009E4  1  A9 04                lda #LEFTW
0009E6  1  8D 27 0F             sta bx+1
0009E9  1  20 5D 0B             jsr posvx
0009EC  1  20 78 0B             jsr tick
0009EF  1  AD 27 0F     @r:     lda bx+1                ; right wall
0009F2  1  C9 9B                cmp #RIGHTW - BALLW + 1
0009F4  1  90 0B                bcc @t
0009F6  1  A9 9A                lda #RIGHTW - BALLW
0009F8  1  8D 27 0F             sta bx+1
0009FB  1  20 54 0B             jsr negvx
0009FE  1  20 78 0B             jsr tick
000A01  1  AD 29 0F     @t:     lda by+1                ; top wall
000A04  1  C9 0C                cmp #TOPW
000A06  1  B0 0B                bcs @p
000A08  1  A9 0C                lda #TOPW
000A0A  1  8D 29 0F             sta by+1
