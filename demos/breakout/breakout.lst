000A10  1  20 78 0B             jsr tick
000A13  1  AD 2D 0F     @p:     lda vy+1                ; the paddle, if going down
000A16  1  30 68                bmi @br
000A18  1  AD 29 0F             lda by+1
000A1B  1  18                   clc
000A1C  1  69 03                adc #BALLH
000A1E  1  C9 BA                cmp #PADY
000A20  1  90 5E                bcc @br
000A22  1  C9 BE                cmp #PADY + 4
000A24  1  B0 48                bcs @out
000A26  1  AD 27 0F             lda bx+1                ; ball's right > paddle's left
000A29  1  18                   clc
000A2A  1  69 02                adc #BALLW
000A2C  1  CD 2E 0F             cmp px
000A2F  1  90 3D                bcc @out
000A31  1  F0 3B                beq @out
