00E14C  1  20 6C E1             jsr at
00E14F  1  A2 2F                ldx #<l3
00E151  1  A0 E2                ldy #>l3
00E153  1  A9 12                lda #ROW0+6
00E155  1  20 6C E1             jsr at
00E158  1  A9 09                lda #$09                ; light blue
00E15A  1  8D 21 D0             sta COLOR
00E15D  1  A2 37                ldx #<t5
00E15F  1  A0 E2                ldy #>t5
00E161  1  A9 16                lda #22
00E163  1  20 6C E1             jsr at
00E166  1  A9 07                lda #$07
00E168  1  8D 21 D0             sta COLOR
00E16B  1  60                   rts
00E16C  1               
00E16C  1               ; Prints the zero-terminated string at YX on row A, column 2
00E16C  1               at:
00E16C  1  8D 16 D0             sta CURY
00E16F  1  A9 02                lda #2
00E171  1  8D 15 D0             sta CURX
00E174  1  86 E2                stx P
00E176  1  84 E3                sty P+1
00E178  1  A0 00                ldy #0
