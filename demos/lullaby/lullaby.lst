00E135  1  20 6C E1             jsr at
00E138  1  A9 0E                lda #$0E                ; labels in yellow
00E13A  1  8D 21 D0             sta COLOR
00E13D  1  A2 23                ldx #<l1
00E13F  1  A0 E2                ldy #>l1
00E141  1  A9 0C                lda #ROW0
00E143  1  20 6C E1             jsr at
00E146  1  A2 2A                ldx #<l2
00E148  1  A0 E2                ldy #>l2
