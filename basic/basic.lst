000000r 2               ; numbers
000000r 2               IRQ_FRAME   = 1
000000r 2               IRQ_KEY     = 2
000000r 2               IRQ_MOUSE   = 4
000000r 2               V_NOTE      = 0
000000r 2               V_VOL       = 1
000000r 2               V_WAVE      = 2
