000000r 1               ;=============================================================================
000000r 1               ; mini6502_basic.asm - EhBASIC for mini6502                    (RAM $A000-$CFFF)
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Derived from EhBASIC. EhBASIC is (c) Lee Davison, free for non-commercial
000000r 1               ; use; see README.txt. This file is the mini6502 glue: start-up, keyboard and
000000r 1               ; terminal routines. The interpreter itself is ehbasic.asm.
000000r 1               ;
000000r 1               ; Start it from the monitor:
000000r 1               ;   A000R   cold start: clears the screen, uses all of $0400-$9FFF (39935 bytes)
000000r 1               ;   A003R   warm start: back to BASIC with the program kept (after F1 / RESET)
000000r 1               ;   SYSTEM  (in BASIC) goes back to the monitor; G (or A003R) returns
000000r 1               ;
000000r 1               ; Disk (the "disk" folder next to mini6502, shared with the monitor):
000000r 1               ;   SAVE "NAME"     saves the program
000000r 1               ;   LOAD "NAME"     loads a program saved by SAVE (wherever BASIC's program
000000r 1               ;                   memory starts), clears the variables, back to Ready
000000r 1               ;   DIR or CAT      lists the disk (CALL $A006 does the same)
000000r 1               ;   KILL "NAME"     deletes a file
000000r 1               ;
000000r 1               ; DESKTOP and EDIT are constants like PI: CALL DESKTOP ($CC90), CALL EDIT
000000r 1               ; ($CC18, far-call entry 2: the editor with its text kept).
000000r 1               ; CLS clears the screen (with the current COLOR) and homes the cursor.
000000r 1               ; LOCATE row[,column] moves the cursor (1-25, 1-80, as in QBasic); the next
000000r 1               ; PRINT starts there. Without a column the cursor stays in its column.
000000r 1               ;   The name can be any string expression: SAVE N$, LOAD "GAME"+STR$(I)...
000000r 1               ;
000000r 1               ; Extensions (wedge): a statement that starts with "!" is an extension
000000r 1               ; command, and "!" in an expression an extension function (X=!MOUSEX),
000000r 1               ; handled by an extension in banks $00-$07 (see basicx/README.txt):
000000r 1               ; a bank whose $E000 starts with "BX". BASIC finds them at every cold or
000000r 1               ; warm start (SYSTEM, L GFX E000 00, G installs one). The jump table below
000000r 1               ; ($A009-$A038) is what extensions call; it stays at these addresses.
000000r 1               ;
000000r 1               ; Memory used: $00-$EF zero page except $E2-$EE ($F0-$FF are left to the
000000r 1               ; extensions), $0100 stack, $0300-$036F
000000r 1               ; (BASIC variables, vectors and input line), $0400-$9FFF program and data.
000000r 1               ; The monitor keeps $E6-$ED and $0200-$0287, so you can go back and forth.
000000r 1               ;=============================================================================
000000r 1               
000000r 1                       .include "mini6502.inc"     ; the registers (hw/mini6502.inc)
000000r 2               ; mini6502.inc - made by hw/gen.py from hw/mini6502.def: edit that, not this.
000000r 2               ; The mini6502's registers, banks, far-call entries and system calls.
000000r 2               ; In a program: .include "mini6502.inc" (ca65 -I path/to/hw). Including it
000000r 2               ; twice is fine.
000000r 2               
000000r 2               .ifndef MINI6502_INC
000000r 2               MINI6502_INC = 1
000000r 2               
