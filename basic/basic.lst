000000r 2               C_LINE      = 3
000000r 2               C_BOX       = 4
000000r 2               C_BOXF      = 5
000000r 2               C_COPY      = 6
000000r 2               C_COPYT     = 7
000000r 2               C_DIM       = 8
000000r 2               C_UNDIM     = 9
000000r 2               C_STAMP     = $0A
000000r 2               C_CHAR      = $0B
000000r 2               VTAB        = $CC00
000000r 2               VTCOUNT     = $CC02
000000r 2               VTENTRY     = $CC08
000000r 2               VTMAX       = $28
000000r 2               VTNAMES     = $CD48
000000r 2               BANKMAP     = $CF00
000000r 2               FARCALL     = $FFD0
000000r 2               ; bank zones (first, last)
000000r 2               Z_BASICEXT  = 0       ; BASIC extensions, "!" commands (basicx/README.txt)
000000r 2               Z_BASICEXT_END= 7
000000r 2               Z_USER      = 8       ; yours: load by hand; never handed out
000000r 2               Z_USER_END  = $0F
000000r 2               Z_SYSTEM    = $10     ; the system's programs
000000r 2               Z_SYSTEM_END= $1F
000000r 2               Z_PROGRAMS  = $20     ; programs (the allocator hands these out)
000000r 2               Z_PROGRAMS_END= $7F
000000r 2               Z_DOCUMENTS = $80     ; documents, songs, data (handed out too)
000000r 2               Z_DOCUMENTS_END= $BF
000000r 2               Z_SWAP      = $C0     ; the fixed RAM's copies while programs swap it
000000r 2               Z_SWAP_END  = $FF
000000r 2               ; fixed banks
000000r 2               B_GFX       = 0       ; the BASIC extension GFX: !commands (DESKTOP.TXT loads it)
000000r 2               B_LULLABY   = 8       ; the lullaby demo (BOOT.TXT loads it)
000000r 2               B_TK1       = $10     ; the toolkit, part 1 (TK1)
000000r 2               B_TK2       = $11     ; the toolkit, part 2 (TK2)
000000r 2               B_MUSIC     = $12     ; the music engine (MUSIC)
000000r 2               B_EDIT      = $13     ; the editor (EDIT)
000000r 2               B_DESK1     = $14     ; the desktop, part 1 (DESK1)
000000r 2               B_DESK2     = $15     ; the desktop, part 2 (DESK2)
000000r 2               B_DESK3     = $16     ; the desktop, part 3: icons (DESK3)
000000r 2               B_LAUNCH    = $20     ; where the desktop loads bank programs
000000r 2               B_DESKSAVE  = $C0     ; the desktop's RAM while a program runs
000000r 2               B_TKSWAP    = $D0     ; the caller's RAM while a toolkit program runs
000000r 2               B_EDITIMG   = $E0     ; the editor's RAM while away
000000r 2               B_EDITWORLD = $F0     ; the caller's RAM while editing
000000r 2               ; far-call entries: E_NAME = its address (JSR E_NAME), EN_NAME = its number
000000r 2               E_LULLABY   = $CC08   ; plays the lullaby
000000r 2               EN_LULLABY  = 0
000000r 2               E_EDITNEW   = $CC10   ; the editor, with an empty text
000000r 2               EN_EDITNEW  = 1
000000r 2               E_EDIT      = $CC18   ; the editor, with the text as it was (BASIC: CALL EDIT)
000000r 2               EN_EDIT     = 2
000000r 2               E_TOOLKIT   = $CC88   ; the toolkit: LDA #function, JSR
000000r 2               EN_TOOLKIT  = $10
000000r 2               E_DESKTOP   = $CC90   ; the desktop (BASIC: CALL DESKTOP)
000000r 2               EN_DESKTOP  = $11
000000r 2               E_MUSIC     = $CCD0   ; the music engine: LDA #function, LDX #arg, JSR
000000r 2               EN_MUSIC    = $19
000000r 2               E_MUSICB    = $CCD8   ; the music engine from BASIC (mailbox $CCDE)
000000r 2               EN_MUSICB   = $1A
000000r 2               E_RESUME    = $CC98   ; the desktop: back from a program (G after F1)
000000r 2               EN_RESUME   = $12
000000r 2               E_LAUNCH    = $CCA0   ; the desktop: calls a program, then RESUME
000000r 2               EN_LAUNCH   = $13
000000r 2               E_TARGET    = $CCB0   ; the desktop: the program being started
000000r 2               EN_TARGET   = $15
000000r 2               E_BANKLD    = $CCB8   ; the desktop: disk LOAD into the launch bank
000000r 2               EN_BANKLD   = $16
000000r 2               ; bank map owners
000000r 2               OWN_FREE    = 0       ; free
000000r 2               OWN_MAIN    = $FD     ; a main-RAM program (started from the desktop)
000000r 2               OWN_HAND    = $FE     ; loaded by hand (L ... BB in the monitor)
000000r 2               OWN_SYSTEM  = $FF     ; reserved: zones and banks that are never handed out
000000r 2               ; system calls in the ROM
000000r 2               BALLOC      = $FFB0   ; A = owner, X = how many banks (next to each other), Y = 0 pr
000000r 2               BFREE       = $FFB3   ; A = bank
000000r 2               BFREEALL    = $FFB6   ; A = owner
000000r 2               BCLAIM      = $FFB9   ; A = owner, X = bank
000000r 2               VFIND       = $FFBC   ; X/Y = address of a name (low, high; up to 8 characters, endi
000000r 2               BOWNER      = $FFBF   ; A = bank
000000r 2               
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               MONITOR = $FF1F         ; the monitor's prompt (Woz Monitor GETLINE address)
000000r 1               ECHO    = $FFEF         ; the monitor's character output (keeps A, X, Y)
000000r 1               
000000r 1               SAVCOL  = $030E         ; COLOR before the sign-on message (in the unused
000000r 1                                       ; IRQ/NMI code space after VEC_SV)
000000r 1               BGCOL   = $030F         ; its background nibble
000000r 1               XMASK   = $0310         ; extensions: bit N = an extension in bank N
000000r 1               XBANK   = $0311         ; the bank selected when the "!" statement began
000000r 1               XIN     = $0312         ; nonzero while an extension runs
000000r 1               XTRY    = $0313         ; banks still to ask
000000r 1               XSAVB   = $0314         ; (XDISK)
000000r 1               XNUM    = $0315         ; the extension being asked
000000r 1               XVEC    = $0316         ; 2: its entry
000000r 1               
000000r 1                       .org $A000
00A000  1               
00A000  1  4C B8 C8             jmp cold                ; $A000
00A003  1  4C 10 C9             jmp warm                ; $A003
00A006  1  4C 1A CA             jmp dir                 ; $A006: CALL $A006 lists the disk
00A009  1               ; --- the extension API ($A009...): fixed addresses, see basicx/bx.inc ---------
00A009  1  4C BC 00             jmp LAB_IGBY            ; $A009 XCHRGET  next character (A; Z at the end)
00A00C  1  4C C2 00             jmp LAB_GBYT            ; $A00C XCHRGOT  this character again
00A00F  1  4C CE B4             jmp LAB_GTBY            ; $A00F XGETBYTE a 0-255 expression: X
00A012  1  4C 28 AC             jmp LAB_1C01            ; $A012 XCOMMA   a "," or Syntax error
00A015  1  4C 71 CB             jmp xgetword            ; $A015 XGETWORD an expression: Itempl/h (16 bits)
00A018  1  4C 77 CB             jmp xgetstr             ; $A018 XGETSTR  a string: A = length, X/Y = address
00A01B  1  4C 7D CB             jmp xgetvar             ; $A01B XGETVAR  a numeric variable to set (XSETVAR)
00A01E  1  4C 8E CB             jmp xsetvar             ; $A01E XSETVAR  it = Y/A (Y low, A high, signed)
00A021  1  4C 5F A1             jmp xerror              ; $A021 XERROR   error X (BASIC's codes), Ready
00A024  1  88 C5                .word LAB_KEYT          ; $A024 XKEYT    BASIC's keyword table (for bxmatch.inc)
00A026  1  00                   .byte 0
00A027  1  4C 94 CB             jmp xdisk               ; $A027 XDISK    disk command A with bank X selected
00A02A  1  4C 11 A9             jmp LAB_PRNA            ; $A02A XPRINT   print the character A
00A02D  1  4C B6 A8             jmp LAB_CRLF            ; $A02D XCRLF    new line
00A030  1  4C F0 AA             jmp LAB_EVNM            ; $A030 XGETNUM  a numeric expression: FAC1
00A033  1  4C 2C AC             jmp LAB_SNER            ; $A033 XSYNTAX  Syntax error
00A036  1  4C 61 AF             jmp LAB_FCER            ; $A036 XFUNC    Function call error (a bad value)
00A039  1               
00A039  1               ; the interpreter first, so the glue below can use its zero page names
00A039  1                       .include "ehbasic.asm"
00A039  2               
00A039  2               ; mini6502 changes to this file (this list is the only place they are noted):
00A039  2               ; mini6502 changes (marked nowhere else, all listed here):
00A039  2               ;   ccflag   $0200 -> $0300 (page 2 belongs to the mini6502 monitor)
00A039  2               ;   Ram_base $0300 -> $0400, Ram_top $C000 -> $A000 (BASIC itself is at $A000)
00A039  2               ;   PG2_TABS: ctrl-c vector CTRLC -> mini_cc (keeps type-ahead, see
00A039  2               ;            mini6502_basic.asm)
00A039  2               ;   new command DIR (alias CAT), token TK_DIR after TK_NMI: TK_DIR, the
00A039  2               ;            LAB_CTBL entry (mini_dir), LBB_DIR, LBB_CAT and the LAB_KEYT
00A039  2               ;            entry. Same for CLS (TK_CLS, mini_cls, LBB_CLS) and KILL
00A039  2               ;            (TK_KILL, mini_kill, LBB_KILL, plus "K" in TAB_1STC / TAB_CHRT
00A039  2               ;            and a new TAB_ASCK keyword table), SYSTEM (TK_SYSTEM,
00A039  2               ;            mini_system, LBB_SYSTEM) and LOCATE (TK_LOCATE, mini_locate,
00A039  2               ;            LBB_LOCATE). Tokens from TAB on are five
00A039  2               ;            higher than in EhBASIC.
00A039  2               ;   constants DESKTOP ($CC90) and EDIT ($CC18), like PI: tokens TK_DESKTOP
00A039  2               ;            and TK_EDIT after TK_MIDS (the last token, so no other token
00A039  2               ;            moves), LAB_FTPL / LAB_FTBL entries (mini_desktop, mini_edit),
00A039  2               ;            LBB_DESKTOP, LBB_EDIT and their LAB_KEYT entries
00A039  2               ;   LAB_236F: return address increment now carries into the high byte
00A039  2               ;            (MID$ failed when its JSR LAB_236F ended a page)
00A039  2               ;   SWAP: BPL -> BMI (it raised "Type mismatch" for two variables of the
00A039  2               ;            same type, the opposite of what it should do)
00A039  2               ;   cold start: the "Memory size ?" question is skipped (all RAM is used)
00A039  2               ;   cold start: no blank lines between the sign-on, "Bytes free", the
00A039  2               ;            version and Ready (a CR/LF and two LFs removed)
00A039  2               ;   *= $C000 removed; [ ] in expressions -> ( ), == -> = (ca65 syntax)
00A039  2               ;   Assemble with: ca65 --feature labels_without_colons (see build.sh)
00A039  2               ;   Source: Lee Davison's EhBASIC 2.22 with Klaus Dormann's patches (2.22p5),
00A039  2               ;   https://github.com/Klaus2m5/6502_EhBASIC_V2.22 - see README.txt for the licence.
00A039  2               
00A039  2               
00A039  2               ; $E7E1 $E7CF $E7C6 $E7D3 $E7D1 $E7D5 $E7CF $E81E $E825
00A039  2               
00A039  2               ; 2.00      new revision numbers start here
00A039  2               ; 2.01      fixed LCASE$() and UCASE$()
00A039  2               ; 2.02      new get value routine done
00A039  2               ; 2.03      changed RND() to galoise method
00A039  2               ; 2.04      fixed SPC()
00A039  2               ; 2.05      new get value routine fixed
00A039  2               ; 2.06      changed USR() code
00A039  2               ; 2.07      fixed STR$()
00A039  2               ; 2.08      changed INPUT and READ to remove need for $00 start to input buffer
00A039  2               ; 2.09      fixed RND()
00A039  2               ; 2.10      integrated missed changes from an earlier version
00A039  2               ; 2.20      added ELSE to IF .. THEN and fixed IF .. GOTO <statement> to cause error
00A039  2               ; 2.21      fixed IF .. THEN RETURN to not cause error
00A039  2               ; 2.22      fixed RND() breaking the get byte routine
00A039  2               ; 2.22p     patched to disable use of decimal mode and fix Ibuff issues
00A039  2               ;              (bugsnquirks.txt notes 2, 4 and 5)
00A039  2               ;              tabs converted to spaces, tabwidth=6
00A039  2               ; 2.22p2    fixed can't continue error on 1st statement after direct mode
00A039  2               ;              changed INPUT to throw "break in line ##" on empty line input
00A039  2               ; 2.22p3    fixed RAM above code / Ibuff above EhBASIC patch breaks STR$()
00A039  2               ;              fix provided by github user mgcaret
00A039  2               ; 2.22p4    fixed string compare of equal strings in direct mode returns FALSE
00A039  2               ;              fixed FALSE stored to a variable after a string compare
00A039  2               ;                 is > 0 and < 1E-16
00A039  2               ;              added additional stack floor protection for background interrupts
00A039  2               ;              fixed conditional LOOP & NEXT cannot find their data strucure on stack
00A039  2               ; 2.22p5    fixes issues reported by users Ruud and dclxvi on the 6502.org forum
00A039  2               ;      5.0     http://forum.6502.org/viewtopic.php?f=5&t=5500
00A039  2               ;              sanity check for RAM top allows values below RAM base
00A039  2               ;      5.1-7   http://forum.6502.org/viewtopic.php?f=5&t=5606
00A039  2               ;              1-7 coresponds to the bug# in the thread
00A039  2               ;      5.1     TO expression with a subtract may evaluate with the sign bit flipped
00A039  2               ;      5.3     call to LAB_1B5B may return to an address -$100 (page not incremented)
00A039  2               ;      5.4     string concatenate followed by MINUS or NOT() crashes EhBASIC
00A039  2               ;      5.5     garbage collection may cause an overlap with temporary strings
00A039  2               ;      5.6     floating point multiply rounding bug
00A039  2               ;      5.7     VAL() may cause string variables to be trashed
00A039  2               
00A039  2               ; zero page use ..
00A039  2               
00A039  2               ; the following locations are bulk initialized from StrTab at LAB_GMEM
00A039  2               LAB_WARM          = $00       ; BASIC warm start entry point
00A039  2               Wrmjpl            = LAB_WARM+1; BASIC warm start vector jump low byte
00A039  2               Wrmjph            = LAB_WARM+2; BASIC warm start vector jump high byte
00A039  2               
00A039  2               Usrjmp            = $0A       ; USR function JMP address
00A039  2               Usrjpl            = Usrjmp+1  ; USR function JMP vector low byte
00A039  2               Usrjph            = Usrjmp+2  ; USR function JMP vector high byte
00A039  2               Nullct            = $0D       ; nulls output after each line
00A039  2               TPos              = $0E       ; BASIC terminal position byte
00A039  2               TWidth            = $0F       ; BASIC terminal width byte
00A039  2               Iclim             = $10       ; input column limit
00A039  2               Itempl            = $11       ; temporary integer low byte
00A039  2               Itemph            = Itempl+1  ; temporary integer high byte
