00C8B8  2               AA_end_basic
00C8B8  2               
00C8B8  1               
00C8B8  1               ; --- start-up ------------------------------------------------------------------
00C8B8  1               cold:
00C8B8  1  D8                   cld
00C8B9  1  A2 FF                ldx #$FF
00C8BB  1  9A                   txs
00C8BC  1  20 20 C9             jsr setvec
00C8BF  1  A9 02                lda #2                  ; clear the screen (current COLOR), cursor home
00C8C1  1  8D 00 D0             sta SYSCTL
00C8C4  1               
00C8C4  1               ; sign-on message in rainbow colours: each visible character gets the next
00C8C4  1               ; character colour 1-15 (black is skipped, and so is the colour of the
00C8C4  1               ; background, which would hide it); the background is kept, and after the
00C8C4  1               ; message the characters are light grey (7)
00C8C4  1  AD 21 D0             lda COLOR
00C8C7  1  8D 0E 03             sta SAVCOL
00C8CA  1  29 F0                and #$F0
00C8CC  1  8D 0F 03             sta BGCOL
00C8CF  1  A2 00                ldx #0                  ; last colour used
00C8D1  1  A0 00                ldy #0
00C8D3  1  B9 B7 CB     @msg:   lda signon,y
00C8D6  1  F0 24                beq @end
00C8D8  1  C9 21                cmp #'!'                ; spaces and control codes: no colour change
00C8DA  1  90 1A                bcc @out
00C8DC  1  48                   pha
00C8DD  1  E8           @pick:  inx                     ; next colour, 1-15
00C8DE  1  E0 10                cpx #16
00C8E0  1  90 02                bcc @chk
00C8E2  1  A2 01                ldx #1
00C8E4  1  8A           @chk:   txa
00C8E5  1  0A                   asl
00C8E6  1  0A                   asl
00C8E7  1  0A                   asl
00C8E8  1  0A                   asl
00C8E9  1  CD 0F 03             cmp BGCOL               ; same as the background?
00C8EC  1  F0 EF                beq @pick               ; then it would be invisible: skip it
00C8EE  1  8A                   txa
00C8EF  1  0D 0F 03             ora BGCOL
00C8F2  1  8D 21 D0             sta COLOR
00C8F5  1  68                   pla
00C8F6  1  20 AF C9     @out:   jsr outch
00C8F9  1  C8                   iny
00C8FA  1  D0 D7                bne @msg
00C8FC  1  AD 0F 03     @end:   lda BGCOL               ; light grey characters on the same background
00C8FF  1  C9 70                cmp #$70                ; unless the background is light grey itself:
00C901  1  F0 04                beq @keep               ; then keep the colour we started with
00C903  1  09 07                ora #$07
00C905  1  D0 03                bne @set
00C907  1  AD 0E 03     @keep:  lda SAVCOL
00C90A  1  8D 21 D0     @set:   sta COLOR
00C90D  1  4C 39 A0             jmp LAB_COLD
00C910  1               
00C910  1               warm:
00C910  1  D8                   cld
00C911  1  A2 FF                ldx #$FF
00C913  1  9A                   txs
00C914  1  A5 00                lda LAB_WARM            ; set up by a cold start: JMP opcode
00C916  1  C9 4C                cmp #$4C
00C918  1  D0 9E                bne cold                ; never cold-started: do it now
00C91A  1  20 20 C9             jsr setvec
00C91D  1  4C 00 00             jmp LAB_WARM
00C920  1               
00C920  1               ; Copies the I/O vectors to page 3 (VEC_IN, VEC_OUT, VEC_LD, VEC_SV) and
00C920  1               ; tells the monitor that G comes back to the warm start
00C920  1               setvec:
00C920  1  A9 10                lda #<warm
00C922  1  8D 02 D0             sta WARMLO
00C925  1  A9 C9                lda #>warm
00C927  1  8D 03 D0             sta WARMHI
00C92A  1  A0 08                ldy #vecs_end - vecs
00C92C  1  B9 78 C9     @copy:  lda vecs-1,y
00C92F  1  99 04 03             sta VEC_IN-1,y
00C932  1  88                   dey
00C933  1  D0 F7                bne @copy
00C935  1               ; the extensions: banks $00-$07 starting with "BX"; each one's INIT is called
00C935  1  A9 00                lda #0
00C937  1  8D 10 03             sta XMASK
00C93A  1  8D 12 03             sta XIN
00C93D  1  AD 20 D0             lda BANK
00C940  1  48                   pha
00C941  1  A2 07                ldx #7
00C943  1  8E 20 D0     @x:     stx BANK
00C946  1  AD 00 E0             lda $E000
00C949  1  C9 42                cmp #'B'
00C94B  1  D0 1C                bne @no
00C94D  1  AD 01 E0             lda $E001
00C950  1  C9 58                cmp #'X'
00C952  1  D0 15                bne @no
00C954  1  8E 15 03             stx XNUM
00C957  1  20 06 E0             jsr $E006               ; its INIT
00C95A  1  AE 15 03             ldx XNUM
00C95D  1  8E 20 D0             stx BANK
00C960  1  BD 71 C9             lda bits,x
00C963  1  0D 10 03             ora XMASK
00C966  1  8D 10 03             sta XMASK
00C969  1  CA           @no:    dex
00C96A  1  10 D7                bpl @x
00C96C  1  68                   pla
00C96D  1  8D 20 D0             sta BANK
00C970  1  60                   rts
00C971  1  01 02 04 08  bits:   .byte 1, 2, 4, 8, 16, 32, 64, 128
00C975  1  10 20 40 80  
00C979  1               
00C979  1               vecs:
00C979  1  81 C9                .word inch              ; VEC_IN
00C97B  1  AF C9                .word outch             ; VEC_OUT
00C97D  1  E2 C9                .word bload             ; VEC_LD
00C97F  1  C2 C9                .word bsave             ; VEC_SV
00C981  1               vecs_end:
00C981  1               
00C981  1               ; --- I/O -----------------------------------------------------------------------
00C981  1               
00C981  1               ; Key if one is waiting: carry set and the key in A; else carry clear.
00C981  1               ; Delete becomes Backspace, which EhBASIC understands.
00C981  1               inch:
00C981  1  AD 11 D0             lda KBDCR
00C984  1  10 0E                bpl @none
00C986  1  AD 10 D0             lda KBD
00C989  1  29 7F                and #$7F
00C98B  1  C9 7F                cmp #$7F
00C98D  1  D0 02                bne @key
00C98F  1  A9 08                lda #$08
00C991  1  C9 00        @key:   cmp #0                  ; carry set (a key) and Z set for a NUL, which
00C993  1  60                   rts                     ; BASIC then ignores (extended keys: arrows...)
00C994  1  18           @none:  clc
00C995  1  60                   rts
00C996  1               
00C996  1               ; Ctrl-C check, called by BASIC between statements. EhBASIC's own CTRLC
00C996  1               ; reads (and loses) any key typed while a program runs; this one only looks
00C996  1               ; at the waiting key (KBDPEEK) and takes it only if it is Ctrl-C, so typing
00C996  1               ; ahead and pasting work, even across SYSTEM.
00C996  1               mini_cc:
00C996  1  AD 00 03             lda ccflag              ; Ctrl-C checking switched off?
00C999  1  D0 11                bne @done
00C99B  1  AD 14 D0             lda KBDPEEK
00C99E  1  29 7F                and #$7F                ; 0 if no key
00C9A0  1  C9 03                cmp #$03
00C9A2  1  D0 08                bne @done
00C9A4  1  AD 10 D0             lda KBD                 ; take the Ctrl-C
00C9A7  1  A9 03                lda #$03
00C9A9  1  4C 3C A5             jmp LAB_1636            ; BASIC's STOP/break handling
00C9AC  1  4C 02 BF     @done:  jmp LAB_FBA2            ; the rest of CTRLC: interrupt checks
00C9AF  1               
00C9AF  1               ; Prints A; A, X and Y are kept. Goes through the monitor's ECHO so the
00C9AF  1               ; monitor knows where the cursor is when SYSTEM goes back to it.
00C9AF  1               outch:
00C9AF  1  4C EF FF             jmp ECHO
00C9B2  1               
00C9B2  1               ; --- disk --------------------------------------------------------------------
00C9B2  1               
00C9B2  1               ; Evaluates the string after LOAD/SAVE and makes it the disk file name
00C9B2  1               getname:
00C9B2  1  20 04 AB             jsr LAB_EVEX            ; evaluate expression
00C9B5  1  20 79 B3             jsr LAB_EVST            ; must be a string: A = length, YX = address
00C9B8  1  8D 48 D0             sta DNLEN
00C9BB  1  8E 46 D0             stx DNAME
00C9BE  1  8C 47 D0             sty DNAME+1
00C9C1  1  60                   rts
00C9C2  1               
00C9C2  1               ; SAVE "NAME": the program, from the start of BASIC memory to the variables
00C9C2  1               bsave:
00C9C2  1  20 B2 C9             jsr getname
00C9C5  1  A5 79                lda Smeml
00C9C7  1  8D 42 D0             sta DSTART
00C9CA  1  A5 7A                lda Smemh
00C9CC  1  8D 43 D0             sta DSTART+1
00C9CF  1  A5 7B                lda Svarl
00C9D1  1  8D 44 D0             sta DEND
00C9D4  1  A5 7C                lda Svarh
00C9D6  1  8D 45 D0             sta DEND+1
00C9D9  1  A9 02                lda #2
00C9DB  1  8D 40 D0             sta DCMD
00C9DE  1  20 7F CA             jsr dcheck              ; error message and Ready if it failed
00C9E1  1  60                   rts
00C9E2  1               
00C9E2  1               ; LOAD "NAME": into BASIC memory, then the lines are re-linked, the variables
00C9E2  1               ; cleared and BASIC waits at Ready (a running program stops)
00C9E2  1               bload:
00C9E2  1  20 B2 C9             jsr getname
00C9E5  1  A5 79                lda Smeml
00C9E7  1  8D 42 D0             sta DSTART
00C9EA  1  A5 7A                lda Smemh
00C9EC  1  8D 43 D0             sta DSTART+1
00C9EF  1  A5 85                lda Ememl               ; must fit below the top of BASIC memory
00C9F1  1  8D 44 D0             sta DEND
00C9F4  1  A5 86                lda Ememh
00C9F6  1  8D 45 D0             sta DEND+1
00C9F9  1  A9 03                lda #3                  ; load at DSTART
00C9FB  1  8D 40 D0             sta DCMD
00C9FE  1  20 7F CA             jsr dcheck              ; error message and Ready if it failed
00CA01  1  AD 44 D0             lda DEND                ; the variables start after the program
00CA04  1  85 7B                sta Svarl
00CA06  1  AD 45 D0             lda DEND+1
00CA09  1  85 7C                sta Svarh
00CA0B  1  A9 8A                lda #<LAB_RMSG          ; "Ready"
00CA0D  1  A0 C8                ldy #>LAB_RMSG
00CA0F  1  20 F7 A8             jsr LAB_18C3
00CA12  1  4C 3A A2             jmp LAB_1319            ; clear variables, re-link lines, wait for input
00CA15  1               
00CA15  1               ; DIR / CAT (and CALL $A006): the host lists the disk on the terminal
00CA15  1               mini_dir:
00CA15  1  F0 03                beq dir                 ; nothing may follow DIR / CAT
00CA17  1  4C 2C AC             jmp LAB_SNER            ; "Syntax Error"
00CA1A  1               dir:
00CA1A  1  A9 04                lda #4
00CA1C  1  8D 40 D0             sta DCMD
00CA1F  1  A9 00                lda #0                  ; the cursor is at the start of a line
00CA21  1  85 0E                sta TPos
00CA23  1  60                   rts
00CA24  1               
00CA24  1               ; LOCATE row[,column]: move the cursor, 1-based like QBasic (0 counts as 1)
00CA24  1               mini_locate:
00CA24  1  20 CE B4             jsr LAB_GTBY            ; row -> X, A = the character after it
00CA27  1  E0 00                cpx #0
00CA29  1  F0 01                beq @r0
00CA2B  1  CA                   dex
00CA2C  1  8E 16 D0     @r0:    stx CURY
00CA2F  1  C9 2C                cmp #','                ; a column too?
00CA31  1  D0 0D                bne @done
00CA33  1  20 28 AC             jsr LAB_1C01            ; skip the ","
00CA36  1  20 CE B4             jsr LAB_GTBY            ; column -> X
00CA39  1  8A                   txa
00CA3A  1  F0 01                beq @c0
00CA3C  1  CA                   dex
00CA3D  1  8E 15 D0     @c0:    stx CURX
00CA40  1  AD 15 D0     @done:  lda CURX                ; BASIC's own idea of the column (for TAB,
00CA43  1  85 0E                sta TPos                ; commas and line wrapping)
00CA45  1  60                   rts
00CA46  1               
00CA46  1               ; SYSTEM: back to the monitor (A003R comes back with the program kept)
00CA46  1               mini_system:
00CA46  1  F0 03                beq @go                 ; nothing may follow SYSTEM
00CA48  1  4C 2C AC             jmp LAB_SNER            ; "Syntax Error"
00CA4B  1  4C 1F FF     @go:    jmp MONITOR
00CA4E  1               
00CA4E  1               ; KILL "NAME": delete a file
00CA4E  1               mini_kill:
00CA4E  1  20 B2 C9             jsr getname
00CA51  1  A9 05                lda #5
00CA53  1  8D 40 D0             sta DCMD
00CA56  1  20 7F CA             jsr dcheck              ; error message and Ready if it failed
00CA59  1  60                   rts
00CA5A  1               
00CA5A  1               ; CLS: the host clears the screen
00CA5A  1               mini_cls:
00CA5A  1  F0 03                beq @go                 ; nothing may follow CLS
00CA5C  1  4C 2C AC             jmp LAB_SNER            ; "Syntax Error"
00CA5F  1  A9 02        @go:    lda #2
00CA61  1  8D 00 D0             sta SYSCTL
00CA64  1  A9 00                lda #0                  ; cursor at the start of a line
00CA66  1  85 0E                sta TPos
00CA68  1  60                   rts
00CA69  1               
00CA69  1               ; Constants DESKTOP and EDIT (like PI): CALL DESKTOP, CALL EDIT. They are
00CA69  1               ; far-call table entries 17 (the desktop) and 2 (the editor, text kept)
00CA69  1               mini_desktop:
00CA69  1  A9 77                lda #<c_desktop
00CA6B  1  A0 CA                ldy #>c_desktop
00CA6D  1  4C B8 B8             jmp LAB_UFAC
00CA70  1               mini_edit:
00CA70  1  A9 7B                lda #<c_edit
00CA72  1  A0 CA                ldy #>c_edit
00CA74  1  4C B8 B8             jmp LAB_UFAC
00CA77  1  90 4C 90 00  c_desktop: .byte $90, $4C, $90, $00     ; 52368 = $CC90
00CA7B  1  90 4C 18 00  c_edit:    .byte $90, $4C, $18, $00     ; 52248 = $CC18
00CA7F  1               
00CA7F  1               ; Returns if the disk command worked, else reports it (the stack is reset)
00CA7F  1               dcheck:
00CA7F  1  AD 41 D0             lda DSTAT
00CA82  1  D0 01                bne diskerr
00CA84  1  60                   rts
00CA85  1               
00CA85  1               ; Disk error: "?File not found Error" (plus " in line N"), then Ready
00CA85  1               diskerr:
00CA85  1  AA                   tax
00CA86  1  CA                   dex
00CA87  1  E0 06                cpx #6
00CA89  1  90 02                bcc @known
00CA8B  1  A2 03                ldx #3                  ; anything else: "File"
00CA8D  1  BD A8 CA     @known: lda errlo,x
00CA90  1  48                   pha
00CA91  1  BD AE CA             lda errhi,x
00CA94  1  48                   pha
00CA95  1  20 B6 A8             jsr LAB_CRLF
00CA98  1  68                   pla
00CA99  1  A8                   tay
00CA9A  1  68                   pla
00CA9B  1  20 F7 A8             jsr LAB_18C3            ; print the message
00CA9E  1  20 AF A3             jsr LAB_1491            ; flush the stack
00CAA1  1  A9 79                lda #<LAB_EMSG          ; " Error" ...
00CAA3  1  A0 C8                ldy #>LAB_EMSG
00CAA5  1  4C 75 A1             jmp LAB_1269            ; ... " in line N", Ready
00CAA8  1               
00CAA8  1  B4 C3 D1 E1  errlo:  .byte <e1, <e2, <e3, <e4, <e5, <e6
00CAAC  1  E6 F3        
00CAAE  1  CA CA CA CA  errhi:  .byte >e1, >e2, >e3, >e4, >e5, >e6
00CAB2  1  CA CA        
00CAB4  1  46 69 6C 65  e1:     .byte "File not found", 0
00CAB8  1  20 6E 6F 74  
00CABC  1  20 66 6F 75  
00CAC3  1  42 61 64 20  e2:     .byte "Bad file name", 0
00CAC7  1  66 69 6C 65  
00CACB  1  20 6E 61 6D  
00CAD1  1  50 72 6F 67  e3:     .byte "Program too big", 0
00CAD5  1  72 61 6D 20  
00CAD9  1  74 6F 6F 20  
00CAE1  1  46 69 6C 65  e4:     .byte "File", 0
00CAE5  1  00           
00CAE6  1  44 69 73 6B  e5:     .byte "Disk command", 0
00CAEA  1  20 63 6F 6D  
00CAEE  1  6D 61 6E 64  
00CAF3  1  42 61 64 20  e6:     .byte "Bad range", 0
00CAF7  1  72 61 6E 67  
00CAFB  1  65 00        
00CAFD  1               
00CAFD  1               ; --- extensions ----------------------------------------------------------------
00CAFD  1               
00CAFD  1               ; A statement that is not a keyword: "!" + an extension command, else LET
00CAFD  1               mini_stmt:
00CAFD  1  A0 00                ldy #0
00CAFF  1  B1 C3                lda (Bpntrl),y
00CB01  1  C9 21                cmp #'!'
00CB03  1  F0 03                beq @x
00CB05  1  4C D8 A7             jmp LAB_LET
00CB08  1  A0 03        @x:     ldy #<$E003             ; the extensions' statement entry
00CB0A  1  D0 08                bne xcall
00CB0C  1               
00CB0C  1               ; "!" in an expression (from LAB_GVAL): a function; its value (Y low, A high,
00CB0C  1               ; signed) goes into FAC1
00CB0C  1               mini_func:
00CB0C  1  A0 09                ldy #<$E009             ; the extensions' function entry
00CB0E  1  20 14 CB             jsr xcall
00CB11  1  4C 91 B0             jmp LAB_AYFC
00CB14  1               
00CB14  1               ; Asks each extension in turn (entry $E0yy, Y = yy) until one takes the "!"
00CB14  1               ; command: carry clear. Nested calls (a function inside an extension's
00CB14  1               ; statement) keep the program's bank in XBANK.
00CB14  1  8C 16 03     xcall:  sty XVEC
00CB17  1  A9 E0                lda #$E0
00CB19  1  8D 17 03             sta XVEC+1
00CB1C  1  20 BC 00             jsr LAB_IGBY            ; past the "!"
00CB1F  1  AD 20 D0             lda BANK
00CB22  1  48                   pha
00CB23  1  AE 12 03             ldx XIN
00CB26  1  D0 03                bne @in
00CB28  1  8D 11 03             sta XBANK
00CB2B  1  EE 12 03     @in:    inc XIN
00CB2E  1  AD 10 03             lda XMASK
00CB31  1  8D 13 03             sta XTRY
00CB34  1  A2 00                ldx #0
00CB36  1  4E 13 03     @ask:   lsr XTRY
00CB39  1  90 0E                bcc @next
00CB3B  1  8E 15 03             stx XNUM
00CB3E  1  8E 20 D0             stx BANK
00CB41  1  20 53 CB             jsr @go
00CB44  1  AE 15 03             ldx XNUM
00CB47  1  90 0D                bcc @done
00CB49  1  E8           @next:  inx
00CB4A  1  E0 08                cpx #8
00CB4C  1  D0 E8                bne @ask
00CB4E  1  A2 02                ldx #$02                ; nobody knows it: Syntax error
00CB50  1  4C 5F A1             jmp LAB_XERR
00CB53  1  6C 16 03     @go:    jmp (XVEC)
00CB56  1  CE 12 03     @done:  dec XIN
00CB59  1  AA                   tax                     ; (a function's value: Y, A)
00CB5A  1  68                   pla
00CB5B  1  8D 20 D0             sta BANK
00CB5E  1  8A                   txa
00CB5F  1  60                   rts
00CB60  1               
00CB60  1               ; Called by every error: an extension's bank is replaced by the program's
00CB60  1               mini_xerr:
00CB60  1  AD 12 03             lda XIN
00CB63  1  F0 0B                beq @r
00CB65  1  AD 11 03             lda XBANK
00CB68  1  8D 20 D0             sta BANK
00CB6B  1  A9 00                lda #0
00CB6D  1  8D 12 03             sta XIN
00CB70  1  60           @r:     rts
00CB71  1               
00CB71  1               xerror  = LAB_XERR              ; (mini_xerr puts the bank back)
00CB71  1               
00CB71  1               ; XGETWORD: a numeric expression, its 16 bits in Itempl/h
00CB71  1               xgetword:
00CB71  1  20 F0 AA             jsr LAB_EVNM
00CB74  1  4C 2C B5             jmp LAB_F2FX
00CB77  1               
00CB77  1               ; XGETSTR: a string expression: A = length, X/Y = its address
00CB77  1               xgetstr:
00CB77  1  20 04 AB             jsr LAB_EVEX
00CB7A  1  4C 79 B3             jmp LAB_EVST
00CB7D  1               
00CB7D  1               ; XGETVAR: the numeric variable named here (XSETVAR then sets it)
00CB7D  1               xgetvar:
00CB7D  1  20 E2 AD             jsr LAB_GVAR
00CB80  1  85 97                sta Lvarpl
00CB82  1  84 98                sty Lvarph
00CB84  1  A5 5F                lda Dtypef
00CB86  1  10 05                bpl @ok
00CB88  1  A2 18                ldx #$18                ; a string variable: Type mismatch
00CB8A  1  4C 5F A1             jmp LAB_XERR
00CB8D  1  60           @ok:    rts
00CB8E  1               
00CB8E  1               ; XSETVAR: that variable = Y (low) A (high), signed
00CB8E  1               xsetvar:
00CB8E  1  20 91 B0             jsr LAB_AYFC
00CB91  1  4C DE B8             jmp LAB_PFAC
00CB94  1               
00CB94  1               ; XDISK: disk command A with bank X at $E000 while it runs (the extension's
00CB94  1               ; own bank comes back); a failure gives BASIC's disk error message
00CB94  1  48           xdisk:  pha
00CB95  1  AD 20 D0             lda BANK
00CB98  1  8D 14 03             sta XSAVB
00CB9B  1  8E 20 D0             stx BANK
00CB9E  1  68                   pla
00CB9F  1  8D 40 D0             sta DCMD
00CBA2  1  AD 14 03             lda XSAVB
00CBA5  1  8D 20 D0             sta BANK
00CBA8  1  AD 41 D0             lda DSTAT
00CBAB  1  F0 09                beq @ok
00CBAD  1  20 60 CB             jsr mini_xerr
00CBB0  1  AD 41 D0             lda DSTAT
00CBB3  1  4C 85 CA             jmp diskerr
00CBB6  1  60           @ok:    rts
00CBB7  1               
00CBB7  1               signon:
00CBB7  1  6D 69 6E 69          .byte "mini6502 BASIC - Derived from EhBASIC", $0D, $00
00CBBB  1  36 35 30 32  
00CBBF  1  20 42 41 53  
00CBDE  1               
