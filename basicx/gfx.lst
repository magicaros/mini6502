00E215  1                       .include "bxmatch.inc"
00E215  2               ; bxmatch.inc - the keyword matcher for mini6502 BASIC extensions.
00E215  2               ; Part of mini6502 BASIC, derived from EhBASIC (c) Lee Davison: free for
00E215  2               ; personal, non-commercial use only (see basic/README.txt).
00E215  2               ; mini6502 additions Copyright (C) 2026 Benoit Colson, with the help of Claude AI.
00E215  2               ; .include it after bx.inc. Uses zero page $F0-$F7.
00E215  2               ;
00E215  2               ; XMATCH: X/Y = a keyword list:
00E215  2               ;     .byte "PLO", 'T'+$80, "LIN", 'E'+$80, 0
00E215  2               ; Spaces between "!" and the keyword are fine.
00E215  2               KWP     = $F0           ; 2: the keyword list
00E215  2               TOKP    = $F2           ; 2: the text of a token being spelled out
00E215  2               TOKN    = $F4           ; characters of it still to come
00E215  2               TOKO    = $F5           ; where in it
00E215  2               INOFF   = $F6           ; offset in the BASIC line
00E215  2               KOFF    = $F7           ; offset in the keyword list
00E215  2               
00E215  2               ; which keyword of the list at X/Y comes next in the line? The list:
00E215  2               ; each keyword in capitals, its last character + $80, then 0. Words BASIC
00E215  2               ; turned into tokens are spelled out (COLOR is stored as C O L and OR). The
00E215  2               ; keyword must not run on into a letter. Found: carry clear, A = its number
00E215  2               ; (0 = the first), the line moved on past it (and to the next non-space).
00E215  2               ; Not found: carry set, the line as it was.
00E215  2  86 F0        XMATCH: stx KWP
00E217  2  84 F1                sty KWP+1
00E219  2  A9 00                lda #0
00E21B  2  8D D4 E2             sta KIDX
00E21E  2  A0 00        @kw:    ldy #0
00E220  2  B1 F0                lda (KWP),y
00E222  2  D0 02                bne @try
00E224  2  38                   sec                     ; the end of the list
00E225  2  60                   rts
00E226  2  A9 00        @try:   lda #0
00E228  2  85 F6                sta INOFF
00E22A  2  85 F4                sta TOKN
00E22C  2  85 F7                sta KOFF
00E22E  2  20 81 E2     @ch:    jsr @next               ; the next character of the line
00E231  2  8D D5 E2             sta KCH
00E234  2  A4 F7                ldy KOFF
00E236  2  B1 F0                lda (KWP),y
00E238  2  29 7F                and #$7F
00E23A  2  CD D5 E2             cmp KCH
00E23D  2  D0 2A                bne @fail
00E23F  2  B1 F0                lda (KWP),y
00E241  2  E6 F7                inc KOFF
00E243  2  0A                   asl                     ; its last character?
00E244  2  90 E8                bcc @ch
00E246  2  A5 F4                lda TOKN                ; not in the middle of a token
00E248  2  D0 1F                bne @fail
00E24A  2  A4 F6                ldy INOFF               ; and no letter right after it (a token
00E24C  2  B1 C3                lda (Bpntrl),y          ; is fine: + - * / and so on)
00E24E  2  C9 41                cmp #'A'
00E250  2  90 04                bcc @ok
00E252  2  C9 5B                cmp #'Z'+1
00E254  2  90 13                bcc @fail
00E256  2  18           @ok:    clc                     ; found: the line moves on
00E257  2  A5 C3                lda Bpntrl
00E259  2  65 F6                adc INOFF
00E25B  2  85 C3                sta Bpntrl
00E25D  2  90 02                bcc @nc
00E25F  2  E6 C4                inc Bpntrh
00E261  2  20 0C A0     @nc:    jsr XCHRGOT
00E264  2  AD D4 E2             lda KIDX
00E267  2  18                   clc
00E268  2  60                   rts
00E269  2  A0 00        @fail:  ldy #0                  ; on to the next keyword in the list
00E26B  2  B1 F0        @sk:    lda (KWP),y
00E26D  2  C8                   iny
00E26E  2  0A                   asl
00E26F  2  90 FA                bcc @sk
00E271  2  98                   tya
00E272  2  18                   clc
00E273  2  65 F0                adc KWP
00E275  2  85 F0                sta KWP
00E277  2  90 02                bcc @nc2
00E279  2  E6 F1                inc KWP+1
00E27B  2  EE D4 E2     @nc2:   inc KIDX
00E27E  2  4C 1E E2             jmp @kw
00E281  2               ; the next character of the line, tokens spelled out, in capitals
00E281  2  A5 F4        @next:  lda TOKN
00E283  2  F0 0B                beq @raw
00E285  2  C6 F4                dec TOKN
00E287  2  A4 F5                ldy TOKO
00E289  2  E6 F5                inc TOKO
00E28B  2  B1 F2                lda (TOKP),y
00E28D  2  29 7F                and #$7F
