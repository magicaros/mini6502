000000r 1                       .include "bx.inc"
000000r 2               ; bx.inc - for writing mini6502 BASIC extensions
000000r 2               ; Part of mini6502 BASIC, derived from EhBASIC (c) Lee Davison: free for
000000r 2               ; personal, non-commercial use only (see basic/README.txt).
000000r 2               ; mini6502 additions Copyright (C) 2026 Benoit Colson, with the help of Claude AI.
000000r 2               ; An extension is a 4K bank image for one of banks $00-$07:
000000r 2               ;   $E000  "BX", version (1)
000000r 2               ;   $E003  JMP statement  a "!" statement: A = its first character after
000000r 2               ;                         the "!", the line pointer on it. Your keyword:
000000r 2               ;                         run it, return with carry clear (the line pointer
000000r 2               ;                         at the end of the statement). Not yours: carry
000000r 2               ;                         set and the line pointer untouched.
000000r 2               ;   $E006  JMP init       called at every BASIC cold and warm start
000000r 2               ;   $E009  JMP function   a "!" in an expression: the same, but return its
000000r 2               ;                         value in Y (low) / A (high), signed, carry clear
000000r 2               ;                         (no functions: SEC, RTS)
000000r 2               ;   $E00C  your name, 0
000000r 2               ; BASIC's own zero page is busy; $F0-$F7 belong to bxmatch.inc, $F8-$FF are
000000r 2               ; yours. Errors (yours or BASIC's) put the program's bank back by themselves.
000000r 2               
000000r 2               ; the API (fixed addresses in BASIC)
000000r 2               XCHRGET  = $A009        ; next character of the line: A (Z set at ":" / end)
000000r 2               XCHRGOT  = $A00C        ; the current character again
000000r 2               XGETBYTE = $A00F        ; a 0-255 expression: X (A = the character after)
000000r 2               XCOMMA   = $A012        ; a "," (else Syntax error)
000000r 2               XGETWORD = $A015        ; a numeric expression: its low 16 bits in Itempl/h
000000r 2               XGETSTR  = $A018        ; a string expression: A = length, X/Y = its address
000000r 2               XGETVAR  = $A01B        ; the numeric variable named here: XSETVAR sets it
000000r 2               XSETVAR  = $A01E        ; that variable = Y (low) / A (high), signed
000000r 2               XERROR   = $A021        ; error X (ERR_ below), then Ready
000000r 2               XKEYT    = $A024        ; (2 bytes) BASIC's keyword table, for bxmatch.inc
000000r 2               XDISK    = $A027        ; disk command A with bank X selected meanwhile;
000000r 2                                       ; a failure gives BASIC's disk error message
000000r 2               XPRINT   = $A02A        ; print the character A
000000r 2               XCRLF    = $A02D        ; new line
000000r 2               XGETNUM  = $A030        ; a numeric expression into FAC1
000000r 2               XSYNTAX  = $A033        ; Syntax error
000000r 2               XFUNC    = $A036        ; Function call error (a value out of range)
000000r 2               
000000r 2               ; BASIC's zero page and RAM that extensions may use
000000r 2               Bpntrl   = $C3          ; the line pointer (2 bytes)
000000r 2               Bpntrh   = $C4
000000r 2               Itempl   = $11          ; XGETWORD's result (2 bytes)
000000r 2               Itemph   = $12
000000r 2               TPos     = $0E          ; the terminal column BASIC thinks the cursor is in
000000r 2               XBANK    = $0311        ; the bank the program had selected
000000r 2               
000000r 2               ; error codes for XERROR
000000r 2               ERR_SN   = $02          ; Syntax
000000r 2               ERR_FC   = $08          ; Function call
000000r 2               ERR_OV   = $0A          ; Overflow
000000r 2               ERR_OM   = $0C          ; Out of memory
000000r 2               ERR_TM   = $18          ; Type mismatch
000000r 2               
000000r 1               
000000r 1               PTRA    = $F8           ; 2: a pointer (SPRDEF)
000000r 1               T0      = $FA           ; scratch
000000r 1               T1      = $FB
000000r 1               T2      = $FC
000000r 1               T3      = $FD           ; (functions only)
000000r 1               T4      = $FE
000000r 1               
000000r 1                       .org $E000
00E000  1  42 58 01             .byte "BX", 1
00E003  1  4C 16 E0             jmp statement           ; $E003
00E006  1  4C 10 E0             jmp init                ; $E006
00E009  1  4C 2B E0             jmp function            ; $E009
00E00C  1  47 46 58 00          .byte "GFX", 0          ; $E00C
00E010  1               
00E010  1  A9 01        init:   lda #1
00E012  1  8D 7D E3             sta PEN
00E015  1  60                   rts
00E016  1               
00E016  1               statement:
00E016  1  A2 06                ldx #<keywords
00E018  1  A0 E3                ldy #>keywords
00E01A  1  20 15 E2             jsr XMATCH
00E01D  1  B0 0B                bcs @no                 ; not ours
00E01F  1  0A                   asl
00E020  1  AA                   tax
00E021  1  BD D7 E2             lda cmds+1,x            ; run it (RTS goes to @done)
00E024  1  48                   pha
00E025  1  BD D6 E2             lda cmds,x
00E028  1  48                   pha
00E029  1  60                   rts
00E02A  1  60           @no:    rts
00E02B  1               
