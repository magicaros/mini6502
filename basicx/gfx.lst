00E053  1  45 D8 4D 4F  
00E057  1  55 53 45 D9  
00E062  1  43 4C 49 43          .byte "CLICK", 'S'+$80, "FRAM", 'E'+$80, "PIXE", 'L'+$80
00E066  1  4B D3 46 52  
00E06A  1  41 4D C5 50  
00E072  1  4B 45 59 44          .byte "KEYDOW", 'N'+$80, "KEYA", 'T'+$80
00E076  1  4F 57 CE 4B  
00E07A  1  45 59 41 D4  
00E07E  1  00                   .byte 0
00E07F  1               
00E07F  1               f_mousex:
00E07F  1  20 DB E1             jsr mousex
00E082  1  18                   clc
00E083  1  60                   rts
00E084  1               f_mousey:
00E084  1  20 F7 E1             jsr mousey
00E087  1  18                   clc
00E088  1  60                   rts
00E089  1               f_buttons:
00E089  1  AC 04 D5             ldy BUTTONS
00E08C  1  4C 98 E0             jmp byteval
00E08F  1               f_clicks:
00E08F  1  AC 06 D5             ldy CLICKS
00E092  1  4C 98 E0             jmp byteval
00E095  1               f_frame:
00E095  1  AC 01 D0             ldy FRAME
00E098  1               byteval:
00E098  1  A9 00                lda #0
00E09A  1  18                   clc
00E09B  1  60                   rts
00E09C  1               ; (the blitter's X0/Y0 are put back: a command may be halfway through
