00E02B  1               function:
00E02B  1  A2 4F                ldx #<fwords
00E02D  1  A0 E0                ldy #>fwords
00E02F  1  20 15 E2             jsr XMATCH
00E032  1  B0 0A                bcs @no
00E034  1  0A                   asl
