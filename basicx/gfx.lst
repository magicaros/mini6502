000000r 1               ; gfx.asm - GFX, the mini6502 BASIC extension for graphics, sound and the
000000r 1               ; mouse (bank $00). See README.txt.
000000r 1               ; Part of mini6502 BASIC, derived from EhBASIC (c) Lee Davison: free for
000000r 1               ; personal, non-commercial use only (see basic/README.txt).
000000r 1               ; mini6502 additions Copyright (C) 2026 Benoit Colson, with the help of Claude AI.
000000r 1               ;
000000r 1               ;   L GFX E000 00     then start BASIC (A000R), or G / A003R back into it
000000r 1               ; Commands (each starts with "!"; numbers are any expressions):
000000r 1               ;   !SCREEN m               0 text, 1 graphics, 2 graphics + text, 3 hires,
000000r 1               ;                           4 hires + text
000000r 1               ;   !CLG [c]                clear the drawing page (colour c, else 0)
000000r 1               ;   !COLOR c                the colour PLOT, LINE, BOX, FILL use (lores: a
000000r 1               ;                           pixel byte 0-63; hires: 1 ink, 0 paper)
000000r 1               ;   !PLOT x,y               a point
000000r 1               ;   !LINE x0,y0,x1,y1       a line
000000r 1               ;   !BOX x0,y0,x1,y1        a rectangle
000000r 1               ;   !FILL x0,y0,x1,y1       a filled rectangle
000000r 1               ;   !PIXEL x,y,V            V = the pixel at x,y
000000r 1               ;   !PALETTE i,r,g,b        palette entry i (0-31) = r,g,b (0-255)
000000r 1               ;   !PAGE show[,draw]       the page shown (and the one drawn on), 0-1
000000r 1               ;   !SPRITE n,x,y[,i[,f]]   sprite n (0-31) at x,y (screen pixels), image i,
000000r 1               ;                           flags f (1 on, 2 flip across, 4 flip down, 8
000000r 1               ;                           double, 16 behind, 32 shadow); it is switched on
000000r 1               ;   !SPROFF n               sprite n off
000000r 1               ;   !SPRDEF n,a             sprite image n = the 256 bytes at address a
000000r 1               ;   !SOUND v,n[,vol[,w[,d]]]  voice v (1-4) plays note n (0 = off): volume
000000r 1               ;                           0-15, wave 0-3, duration in frames (0 = held)
000000r 1               ;   !SHAPE v,decay[,sweep[,pulse]]  voice v's shaping
000000r 1               ;   !QUIET                  all four voices off
000000r 1               ;   !MUSIC b                the music engine plays the song in bank b
000000r 1               ;                           (0 = stop)
000000r 1               ;   !MOUSE X,Y,B            X,Y = where the mouse is (text: column, row;
000000r 1               ;                           graphics: 160 x 200; hires: 640 x 400), B = its
000000r 1               ;                           buttons (1 left, 2 right, 4 middle)
000000r 1               ;   !WAIT n                 wait n frames (1/60 s each)
000000r 1               ;   !POINTER n              the mouse pointer: 1 on, 0 off
000000r 1               ;   !BLOAD "name",a[,b]     load a file at address a (with bank b at $E000)
000000r 1               ;   !BSAVE "name",a,e[,b]   save a..e (end included), with bank b
000000r 1               ;   !HELP                   list these commands
000000r 1               ;   !FLUSH                  throw away the keys waiting to be read
000000r 1               ; Functions (in expressions, e.g. X=!MOUSEX or IF !BUTTONS AND 1 THEN ...):
000000r 1               ;   !MOUSEX  !MOUSEY        where the mouse is (units as for !MOUSE)
000000r 1               ;   !BUTTONS                the buttons held (1 left, 2 right, 4 middle)
000000r 1               ;   !CLICKS                 the buttons pressed since the last !CLICKS
000000r 1               ;   !FRAME                  the frame counter (0-255, +1 every 1/60 s)
000000r 1               ;   !PIXEL(x,y)             the pixel at x,y
000000r 1               ;   !KEYDOWN("W")           -1 while that key is held down, else 0 (several
000000r 1               ;   !KEYDOWN(code)          at once, no auto-repeat; codes: see KEYSEL);
000000r 1               ;                           it also throws away the keys waiting to be read
000000r 1               ;                           (but not a Ctrl-C), as !FLUSH
000000r 1               ;   !KEYAT("W")            the same for the key in a PLACE, whatever the
000000r 1               ;   !KEYAT(scancode)       layout: "W" = where W is on a US keyboard (Z on
000000r 1               ;                           AZERTY), or a PC scancode (see KEYPOS)
000000r 1               
000000r 1                       .include "mini6502.inc"
000000r 2               ; mini6502.inc - made by hw/gen.py from hw/mini6502.def: edit that, not this.
000000r 2               ; Copyright (C) 2026 Benoit Colson, with the help of Claude AI; GNU GPL 3 or later (COPYING).
000000r 2               ; The mini6502's registers, banks, far-call entries and system calls.
000000r 2               ; In a program: .include "mini6502.inc" (ca65 -I path/to/hw). Including it
000000r 2               ; twice is fine.
000000r 2               
