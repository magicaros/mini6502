000000r 3               ;=============================================================================
000000r 3               ; tk.inc - mini6502 desktop toolkit: shared definitions (both toolkit banks)
000000r 3               ;-----------------------------------------------------------------------------
000000r 3               ; Public domain. See README.txt for the programming interface.
000000r 3               ;=============================================================================
000000r 3               
000000r 3               TKBANK1 = $10           ; dispatcher, windows, events
000000r 3               TKBANK2 = $11           ; menus, dialogs
000000r 3               SWAPBANK = $D0          ; the caller's RAM ($0000-$CBFF) while the desktop runs
000000r 3               
000000r 3               ; --- function numbers (A when calling TOOL = $CC88) --------------------------
000000r 3               TK_INIT     = 0
000000r 3               TK_EXIT     = 1
000000r 3               TK_MENUBAR  = 2
000000r 3               TK_MENUITEM = 3
000000r 3               TK_OPENWIN  = 4
000000r 3               TK_CLOSEWIN = 5
000000r 3               TK_GETEVENT = 6
000000r 3               TK_POLLEVENT = 7
000000r 3               TK_SETPORT  = 8
000000r 3               TK_ALERT    = 9
000000r 3               TK_ASK      = 10
000000r 3               TK_TEXT     = 11
000000r 3               TK_INVAL    = 12
000000r 3               TK_FRONT    = 13
000000r 3               TK_CLEAR    = 14
000000r 3               TK_SETTITLE = 15
000000r 3               TK_LAST     = 15
000000r 3               
000000r 3               ; --- events (A after GETEVENT / POLLEVENT) ---------------------------------------
000000r 3               EV_NONE   = 0
000000r 3               EV_KEY    = 1           ; X = character (0: Y = KBDEXT code)
000000r 3               EV_MENU   = 2           ; X = menu, Y = item
000000r 3               EV_CLICK  = 3           ; X = window ($FF desktop), Y = buttons (+$80 double), r0/r1 = x/y
000000r 3               EV_UPDATE = 4           ; X = window: draw its contents (clip already set)
000000r 3               EV_CLOSE  = 5           ; X = window: its close box was clicked
000000r 3               EV_WHEEL  = 6           ; X = front window ($FF none), Y = steps (signed)
000000r 3               
