000000r 2               CY      = $92
000000r 2               IDX     = $94
000000r 2               NUM     = $96           ; 4 bytes
000000r 2               
000000r 2               .macro  TK fn
000000r 2                       lda #fn
000000r 2                       jsr TOOL
000000r 2               .endmacro
