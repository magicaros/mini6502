000000r 3               ; --- zero page -----------------------------------------------------------------------
000000r 3               r0      = $02           ; r0-r15: arguments and results, 2 bytes each
000000r 3               r1      = $04
000000r 3               r2      = $06
000000r 3               r3      = $08
000000r 3               r4      = $0A
000000r 3               r5      = $0C
000000r 3               RX0     = $22           ; the rectangle the drawing helpers use
000000r 3               RY0     = $24
000000r 3               RX1     = $26
000000r 3               RY1     = $28
000000r 3               DX0     = $2A           ; damage rectangle (redraw pass)
000000r 3               DY0     = $2C
000000r 3               DX1     = $2E
000000r 3               DY1     = $30
000000r 3               TP      = $32           ; text pointer
000000r 3               QP      = $34           ; second pointer
000000r 3               T0      = $36           ; temporaries
000000r 3               T1      = $38
000000r 3               T2      = $3A
000000r 3               T3      = $3C
000000r 3               WP      = $3E           ; pointer to a window record
000000r 3               CBANK   = $40           ; the caller's bank (set by the dispatcher)
000000r 3               EVX     = $41           ; event being returned: X, Y
000000r 3               EVY     = $42
000000r 3               TMPB    = $43
000000r 3               TMPC    = $44
000000r 3               MX      = $46           ; mouse position, 2 bytes each
000000r 3               MY      = $48
000000r 3               NUMW    = $4A           ; number of windows open
000000r 3               FRONTW  = $4B           ; window in front ($FF none)
000000r 3               PASSON  = $4C           ; nonzero: a redraw pass is going on
000000r 3               PEND    = $4D           ; windows still to redraw (bit per window)
000000r 3               UPDW    = $4E           ; window of the UPDATE being drawn ($FF none)
000000r 3               NMENU   = $4F           ; menus in the bar
000000r 3               DAMAGE  = $50           ; nonzero: DX0..DY1 must be redrawn
000000r 3               
000000r 3               ; --- fixed RAM ----------------------------------------------------------------------
000000r 3               WINREC  = $0200         ; 8 window records of 32 bytes
000000r 3               W_USED  = 0             ;  1 if open
000000r 3               W_X0    = 1             ;  outer rectangle (the shadow is 2 more right/down)
000000r 3               W_Y0    = 3
000000r 3               W_X1    = 5
000000r 3               W_Y1    = 7
000000r 3               W_TITLE = 9             ;  title, up to 22 characters + 0
000000r 3               ZORDER  = $0300         ; window numbers, back to front (NUMW of them)
000000r 3               MTL     = $0308         ; menu: title address, low / high (8 + 8)
000000r 3               MTH     = $0310
000000r 3               MFIRST  = $0318         ; menu: first item number (8)
000000r 3               MCOUNT  = $0320         ; menu: number of items (8)
000000r 3               MXL     = $0328         ; menu: title x position, low / high (8 + 8)
000000r 3               MXH     = $0330
000000r 3               MWIDTH  = $0338         ; menu: width of its box in characters (8)
000000r 3               IPL     = $0340         ; item: text address, low / high (64 + 64)
000000r 3               IPH     = $0380
000000r 3               IFLAG   = $03C0         ; item: 1 enabled, 2 separator (64)
000000r 3               IKEY    = $0400         ; item: Ctrl+key shortcut letter, 0 none (64)
000000r 3               MTEXT   = $0480         ; menu texts
000000r 3               MTEXTEND = $07FE
000000r 3               MAGIC   = $07FE         ; "TK" while a toolkit program runs
000000r 3               STRBUF  = $C000         ; strings copied from the caller (dialogs)
000000r 3               STRBUF2 = $C100
000000r 3               ASKBUF  = $C200
000000r 3               
000000r 3               MAXWIN  = 8
000000r 3               MAXMENU = 8
000000r 3               MAXITEM = 64
000000r 3               TITLEH  = 19            ; window title bar: rows y0..y0+18, line at y0+19
000000r 3               MENUH   = 19            ; menu bar: rows 0..18, line at 19
000000r 3               
000000r 3               ; --- helpers ---------------------------------------------------------------------------
000000r 3               .macro  LDW dst, val            ; dst = 16-bit constant
000000r 3                       lda #<(val)
000000r 3                       sta dst
000000r 3                       lda #>(val)
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  MOVW dst, src           ; dst = src (16-bit)
000000r 3                       lda src
000000r 3                       sta dst
000000r 3                       lda src+1
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  ADDW dst, src, val      ; dst = src + constant
000000r 3                       lda src
000000r 3                       clc
000000r 3                       adc #<(val)
000000r 3                       sta dst
000000r 3                       lda src+1
000000r 3                       adc #>(val)
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  SUBW dst, src, val      ; dst = src - constant
000000r 3                       lda src
000000r 3                       sec
000000r 3                       sbc #<(val)
000000r 3                       sta dst
000000r 3                       lda src+1
000000r 3                       sbc #>(val)
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  FAR bank, addr          ; call into another bank: returns to whoever
000000r 3                                               ; called the routine this is in (use it as
000000r 3                                               ; the whole body of a routine called by JSR)
000000r 3                       jsr $FFD0
000000r 3                       .byte bank
000000r 3                       .word addr
000000r 3               .endmacro
000000r 3               
000000r 2               
000000r 2               DESKBANK1 = $14         ; desk1.asm: main loop, the disk window, launching
000000r 2               DESKBANK2 = $15         ; desk2.asm: menus, dialogs, clock, calculator
000000r 2               DESKBANK3 = $16         ; desk3.asm: the icons
000000r 2               LAUNCHBANK = $20        ; programs from the disk are loaded here
000000r 2               SAVEBANK  = $C0         ; the desktop's RAM while a program runs ($C0-$CC)
000000r 2               
000000r 2               TOOL    = $CC88         ; far-call entry 16: the toolkit
000000r 2               DESKENT = $CC90         ; far-call entry 17: the desktop (CALL $CC90)
000000r 2               ; far-call entries 18-24 ($CC98-$CCCF) are the desktop's own stubs:
000000r 2               RESUME  = $CC98         ; JSR $FFD0 / DESKBANK1 / resume   (the G command)
000000r 2               LAUNCH  = $CCA0         ; JSR TARGET / LDA #DESKBANK1 / STA BANK / JMP RESUME
000000r 2               TARGET  = $CCB0         ; JMP entry, or JSR $FFD0 / bank / entry
000000r 2               BANKLD  = $CCB8         ; LDA #bank / STA BANK / LDA #3 / STA DCMD /
000000r 2                                       ; LDA #DESKBANK1 / STA BANK / RTS
000000r 2               
000000r 2               SYSCTL  = $D000
000000r 2               WARMLO  = $D002
000000r 2               WARMHI  = $D003
000000r 2               CLOCKH  = $D004
000000r 2               CLOCKM  = $D005
000000r 2               CLOCKS  = $D006
000000r 2               DCMD    = $D040
000000r 2               DSTAT   = $D041
000000r 2               DSTART  = $D042
000000r 2               DEND    = $D044
000000r 2               DNAME   = $D046
000000r 2               DNLEN   = $D048
000000r 2               PADR    = $D200         ; port A (ours)
000000r 2               PDATA   = $D203
000000r 2               PSTEP   = $D204
000000r 2               
000000r 2               ; file kinds (and icons)
000000r 2               K_DATA  = 0
000000r 2               K_TEXT  = 1
000000r 2               K_BASIC = 2
000000r 2               K_PROG  = 3             ; machine code in the main RAM: entry = load address
000000r 2               K_APP   = 4             ; machine code for a bank ($E000)
000000r 2               K_SYS   = 5             ; the toolkit and the desktop themselves, VECTORS
000000r 2               
000000r 2               ; fixed RAM (the desktop's while it runs; saved while a program runs)
000000r 2               DIRBUF  = $0800         ; DIR into memory ($0800-$0FFF)
000000r 2               DIREND  = $1000
000000r 2               FNL     = $1000         ; name address, low / high (64 + 64)
000000r 2               FNH     = $1040
000000r 2               FKIND   = $1080
000000r 2               FSZL    = $10C0         ; size
000000r 2               FSZH    = $1100
000000r 2               FLDL    = $1140         ; load address
000000r 2               FLDH    = $1180
000000r 2               NFILES  = $11C0
000000r 2               SCRATCH = $C300         ; strings built for dialogs and scripts
000000r 2               NAMEBUF = $C400         ; RENAME's answer
000000r 2               MAXFILE = 64
000000r 2               
000000r 2               ; zero page ($80-$FF is the program's)
000000r 2               DP      = $80           ; pointer
000000r 2               DQ      = $82
000000r 2               D0      = $84           ; temporaries
000000r 2               D1      = $86
000000r 2               D2      = $88
000000r 2               D3      = $8A
000000r 2               ORGX    = $8C           ; contents of the window being drawn
000000r 2               ORGY    = $8E
