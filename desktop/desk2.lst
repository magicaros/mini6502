000000r 3               FRAME   = $D001
000000r 3               KBD     = $D010
000000r 3               KBDCR   = $D011
000000r 3               KBDEXT  = $D019
000000r 3               BANK    = $D020
000000r 3               DMASRC  = $D210         ; DMA: source, destination, length
000000r 3               DMACMD  = $D219
000000r 3               PBADR   = $D208         ; port B (the toolkit's): address, data, step
000000r 3               PBDATA  = $D20B
000000r 3               PBSTEP  = $D20C
000000r 3               MODE    = $D300
000000r 3               SHOW    = $D301
000000r 3               DRAW    = $D302
