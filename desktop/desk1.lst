000000r 1               ; desk1.asm - mini6502 desktop, bank $14: main loop, disk window, launching
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Public domain. Started from BASIC with CALL $CC90 (far-call entry 17).
000000r 1               ; File/Back to BASIC returns there. See README.txt.
000000r 1               ;=============================================================================
