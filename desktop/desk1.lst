000000r 4               EN_BANKLD   = $16
000000r 4               ; bank map owners
000000r 4               OWN_FREE    = 0       ; free
000000r 4               OWN_MAIN    = $FD     ; a main-RAM program (started from the desktop)
000000r 4               OWN_HAND    = $FE     ; loaded by hand (L ... BB in the monitor)
000000r 4               OWN_SYSTEM  = $FF     ; reserved: zones and banks that are never handed out
000000r 4               ; system calls in the ROM
000000r 4               BALLOC      = $FFB0   ; A = owner, X = how many banks (next to each other), Y = 0 pr
000000r 4               BFREE       = $FFB3   ; A = bank
000000r 4               BFREEALL    = $FFB6   ; A = owner
000000r 4               BCLAIM      = $FFB9   ; A = owner, X = bank
000000r 4               VFIND       = $FFBC   ; X/Y = address of a name (low, high; up to 8 characters, endi
000000r 4               BOWNER      = $FFBF   ; A = bank
000000r 4               
000000r 4               .endif
000000r 4               
000000r 3               
000000r 3               TKBANK1 = $10           ; dispatcher, windows, events
000000r 3               TKBANK2 = $11           ; menus, dialogs
000000r 3               SWAPBANK = $D0          ; the caller's RAM ($0000-$CBFF) while the desktop runs
000000r 3               
000000r 3               ; --- function numbers (A when calling TOOL = $CC88) --------------------------
000000r 3               TK_INIT     = 0
000000r 3               TK_EXIT     = 1
000000r 3               TK_MENUBAR  = 2
000000r 3               TK_MENUITEM = 3
000000r 3               TK_OPENWIN  = 4
000000r 3               TK_CLOSEWIN = 5
000000r 3               TK_GETEVENT = 6
000000r 3               TK_POLLEVENT = 7
000000r 3               TK_SETPORT  = 8
000000r 3               TK_ALERT    = 9
000000r 3               TK_ASK      = 10
000000r 3               TK_TEXT     = 11
000000r 3               TK_INVAL    = 12
000000r 3               TK_FRONT    = 13
000000r 3               TK_CLEAR    = 14
000000r 3               TK_SETTITLE = 15
000000r 3               TK_DESKEVENTS = 16
000000r 3               TK_INVALRECT = 17
000000r 3               TK_LAST     = 17
000000r 3               
000000r 3               ; --- events (A after GETEVENT / POLLEVENT) ---------------------------------------
000000r 3               EV_NONE   = 0
000000r 3               EV_KEY    = 1           ; X = character (0: Y = KBDEXT code)
000000r 3               EV_MENU   = 2           ; X = menu, Y = item
000000r 3               EV_CLICK  = 3           ; X = window ($FF desktop), Y = buttons (+$80 double), r0/r1 = x/y
000000r 3               EV_UPDATE = 4           ; X = window: draw its contents (clip already set)
000000r 3               EV_CLOSE  = 5           ; X = window: its close box was clicked
000000r 3               EV_WHEEL  = 6           ; X = front window ($FF none), Y = steps (signed)
000000r 3               
000000r 3               ; --- hardware ------------------------------------------------------------------------
000000r 3               
000000r 3               R_SET   = 0
000000r 3               R_XOR   = 3
000000r 3               R_INV   = 4
000000r 3               S_BOLD  = 1
000000r 3               S_UNDER = 2
000000r 3               S_INV   = 8
000000r 3               S_OPAQUE = 16
000000r 3               
000000r 3               ; --- zero page -----------------------------------------------------------------------
000000r 3               r0      = $02           ; r0-r15: arguments and results, 2 bytes each
000000r 3               r1      = $04
000000r 3               r2      = $06
000000r 3               r3      = $08
000000r 3               r4      = $0A
000000r 3               r5      = $0C
000000r 3               RX0     = $22           ; the rectangle the drawing helpers use
000000r 3               RY0     = $24
000000r 3               RX1     = $26
000000r 3               RY1     = $28
000000r 3               DX0     = $2A           ; damage rectangle (redraw pass)
000000r 3               DY0     = $2C
000000r 3               DX1     = $2E
000000r 3               DY1     = $30
000000r 3               TP      = $32           ; text pointer
000000r 3               QP      = $34           ; second pointer
000000r 3               T0      = $36           ; temporaries
000000r 3               T1      = $38
000000r 3               T2      = $3A
000000r 3               T3      = $3C
000000r 3               WP      = $3E           ; pointer to a window record
000000r 3               CBANK   = $40           ; the caller's bank (set by the dispatcher)
000000r 3               EVX     = $41           ; event being returned: X, Y
000000r 3               EVY     = $42
000000r 3               TMPB    = $43
000000r 3               TMPC    = $44
000000r 3               MX      = $46           ; mouse position, 2 bytes each
000000r 3               MY      = $48
000000r 3               NUMW    = $4A           ; number of windows open
000000r 3               FRONTW  = $4B           ; window in front ($FF none)
000000r 3               PASSON  = $4C           ; nonzero: a redraw pass is going on
000000r 3               PEND    = $4D           ; windows still to redraw (bit per window)
000000r 3               UPDW    = $4E           ; window of the UPDATE being drawn ($FF none)
000000r 3               NMENU   = $4F           ; menus in the bar
000000r 3               DAMAGE  = $50           ; nonzero: DX0..DY1 must be redrawn
000000r 3               DESKEV  = $51           ; nonzero: UPDATE events for the desktop (X = $FF)
000000r 3               DESKPEND = $52          ; the desktop's UPDATE is next in this pass
000000r 3               
000000r 3               ; --- fixed RAM ----------------------------------------------------------------------
000000r 3               WINREC  = $0200         ; 8 window records of 32 bytes
000000r 3               W_USED  = 0             ;  1 if open
000000r 3               W_X0    = 1             ;  outer rectangle (the shadow is 2 more right/down)
000000r 3               W_Y0    = 3
000000r 3               W_X1    = 5
000000r 3               W_Y1    = 7
000000r 3               W_TITLE = 9             ;  title, up to 22 characters + 0
000000r 3               ZORDER  = $0300         ; window numbers, back to front (NUMW of them)
000000r 3               MTL     = $0308         ; menu: title address, low / high (8 + 8)
000000r 3               MTH     = $0310
000000r 3               MFIRST  = $0318         ; menu: first item number (8)
000000r 3               MCOUNT  = $0320         ; menu: number of items (8)
000000r 3               MXL     = $0328         ; menu: title x position, low / high (8 + 8)
000000r 3               MXH     = $0330
000000r 3               MWIDTH  = $0338         ; menu: width of its box in characters (8)
000000r 3               IPL     = $0340         ; item: text address, low / high (64 + 64)
000000r 3               IPH     = $0380
000000r 3               IFLAG   = $03C0         ; item: 1 enabled, 2 separator (64)
000000r 3               IKEY    = $0400         ; item: Ctrl+key shortcut letter, 0 none (64)
000000r 3               MTEXT   = $0480         ; menu texts
000000r 3               MTEXTEND = $07FE
000000r 3               MAGIC   = $07FE         ; "TK" while a toolkit program runs
000000r 3               STRBUF  = $C000         ; strings copied from the caller (dialogs)
000000r 3               STRBUF2 = $C100
000000r 3               ASKBUF  = $C200
000000r 3               
000000r 3               MAXWIN  = 8
000000r 3               MAXMENU = 8
000000r 3               MAXITEM = 64
000000r 3               TITLEH  = 19            ; window title bar: rows y0..y0+18, line at y0+19
000000r 3               MENUH   = 19            ; menu bar: rows 0..18, line at 19
000000r 3               
000000r 3               ; --- helpers ---------------------------------------------------------------------------
000000r 3               .macro  LDW dst, val            ; dst = 16-bit constant
000000r 3                       lda #<(val)
000000r 3                       sta dst
000000r 3                       lda #>(val)
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  MOVW dst, src           ; dst = src (16-bit)
000000r 3                       lda src
000000r 3                       sta dst
000000r 3                       lda src+1
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  ADDW dst, src, val      ; dst = src + constant
000000r 3                       lda src
000000r 3                       clc
000000r 3                       adc #<(val)
000000r 3                       sta dst
000000r 3                       lda src+1
000000r 3                       adc #>(val)
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  SUBW dst, src, val      ; dst = src - constant
000000r 3                       lda src
000000r 3                       sec
000000r 3                       sbc #<(val)
000000r 3                       sta dst
000000r 3                       lda src+1
000000r 3                       sbc #>(val)
000000r 3                       sta dst+1
000000r 3               .endmacro
000000r 3               .macro  FAR bank, addr          ; call into another bank: returns to whoever
000000r 3                                               ; called the routine this is in (use it as
000000r 3                                               ; the whole body of a routine called by JSR)
000000r 3                       jsr $FFD0
000000r 3                       .byte bank
000000r 3                       .word addr
000000r 3               .endmacro
000000r 3               
000000r 2               
000000r 2               DESKBANK1 = $14         ; desk1.asm: main loop, the disk window, launching
000000r 2               DESKBANK2 = $15         ; desk2.asm: menus, dialogs, clock, calculator
000000r 2               DESKBANK3 = $16         ; desk3.asm: the icons
000000r 2               LAUNCHBANK = $20        ; programs from the disk are loaded here
000000r 2               SAVEBANK  = $C0         ; the desktop's RAM while a program runs ($C0-$CC)
000000r 2               
000000r 2               TOOL    = $CC88         ; far-call entry 16: the toolkit
000000r 2               DESKENT = $CC90         ; far-call entry 17: the desktop (CALL $CC90)
000000r 2               ; far-call entries 18-24 ($CC98-$CCCF) are the desktop's own stubs:
000000r 2               RESUME  = $CC98         ; JSR $FFD0 / DESKBANK1 / resume   (the G command)
000000r 2               LAUNCH  = $CCA0         ; JSR TARGET / LDA #DESKBANK1 / STA BANK / JMP RESUME
000000r 2               TARGET  = $CCB0         ; JMP entry, or JSR $FFD0 / bank / entry
000000r 2               BANKLD  = $CCB8         ; LDA #bank / STA BANK / LDA #3 / STA DCMD /
000000r 2                                       ; LDA #DESKBANK1 / STA BANK / RTS
000000r 2               
000000r 2               
000000r 2               ; file kinds (and icons)
000000r 2               K_DATA  = 0
000000r 2               K_TEXT  = 1
000000r 2               K_BASIC = 2
000000r 2               K_PROG  = 3             ; machine code in the main RAM: entry = load address
000000r 2               K_APP   = 4             ; machine code for a bank ($E000)
000000r 2               K_SYS   = 5             ; the toolkit and the desktop themselves, VECTORS
000000r 2               
000000r 2               ; fixed RAM (the desktop's while it runs; saved while a program runs)
000000r 2               DIRBUF  = $0800         ; DIR into memory ($0800-$0FFF)
000000r 2               DIREND  = $1000
000000r 2               FNL     = $1000         ; name address, low / high (64 + 64)
000000r 2               FNH     = $1040
000000r 2               FKIND   = $1080
000000r 2               FSZL    = $10C0         ; size
000000r 2               FSZH    = $1100
000000r 2               FLDL    = $1140         ; load address
000000r 2               FLDH    = $1180
000000r 2               NFILES  = $11C0
000000r 2               SCRATCH = $C300         ; strings built for dialogs and scripts
000000r 2               NAMEBUF = $C400         ; RENAME's answer
000000r 2               MAXFILE = 64
000000r 2               
000000r 2               ; zero page ($80-$FF is the program's)
000000r 2               DP      = $80           ; pointer
000000r 2               DQ      = $82
000000r 2               D0      = $84           ; temporaries
000000r 2               D1      = $86
000000r 2               D2      = $88
000000r 2               D3      = $8A
000000r 2               ORGX    = $8C           ; contents of the window being drawn
000000r 2               ORGY    = $8E
000000r 2               CX      = $90
000000r 2               CY      = $92
000000r 2               IDX     = $94
000000r 2               NUM     = $96           ; 4 bytes
000000r 2               
000000r 2               .macro  TK fn
000000r 2                       lda #fn
000000r 2                       jsr TOOL
000000r 2               .endmacro
000000r 2               
000000r 1               
000000r 1               ; bank 2 (desk2.asm)
000000r 1               D2_INIT   = $E000
000000r 1               D2_MENUS  = $E003
000000r 1               D2_INFO   = $E006
000000r 1               D2_RENAME = $E009
000000r 1               D2_DELETE = $E00C
000000r 1               D2_CLOCK  = $E00F
000000r 1               D2_CALC   = $E012
000000r 1               D2_CCLICK = $E015
000000r 1               D2_CKEY   = $E018
000000r 1               D2_SCRIPT = $E01B
000000r 1               D2_ABOUT  = $E01E
000000r 1               D2_MSG    = $E021
000000r 1               
000000r 1               COLS    = 6             ; icon view: 6 x 5 cells of 86 x 68
000000r 1               ROWS    = 5
000000r 1               LROWS   = 18            ; list view: 18 rows of 18
000000r 1               
000000r 1                       .org $E000
00E000  1               
00E000  1               start:
00E000  1  D8                   cld
00E001  1  A9 00 20 88          TK TK_INIT
00E005  1  CC           
00E006  1  AD 02 D0             lda WARMLO              ; BASIC's warm start, given back at the end
00E009  1  8D 64 EE             sta SAVWLO
00E00C  1  AD 03 D0             lda WARMHI
00E00F  1  8D 65 EE             sta SAVWHI
00E012  1  A2 2F                ldx #STUBEND - STUBS - 1 ; our far-call stubs ($CC98-$CCC7)
00E014  1  BD 50 E0     @s:     lda STUBS,x
00E017  1  9D 98 CC             sta RESUME,x
00E01A  1  CA                   dex
00E01B  1  10 F7                bpl @s
00E01D  1  A9 14                lda #DESKBANK1          ; the launch bank is ours (bank map)
00E01F  1  A2 20                ldx #LAUNCHBANK
00E021  1  20 B9 FF             jsr BCLAIM
00E024  1  BA                   tsx
00E025  1  8E 66 EE             stx MAINSP
00E028  1  A9 FF                lda #$FF
00E02A  1  8D 6A EE             sta SEL
00E02D  1  8D 6C EE             sta WCLOCK
00E030  1  8D 6D EE             sta WCALC
00E033  1  A9 00                lda #0
00E035  1  8D 68 EE             sta VIEW
00E038  1  8D 69 EE             sta SCROLL
00E03B  1  8D 67 EE             sta LAUNCHED
00E03E  1  8D 6E EE             sta CLOCKON
00E041  1  8D 6F EE             sta CALCON
00E044  1  8D 72 EE             sta DISKON              ; the Disk window starts closed
00E047  1  8D 73 EE             sta DSEL
00E04A  1  20 9D ED             jsr far_init            ; the icons
00E04D  1  4C D3 E0             jmp rebuild
00E050  1               
00E050  1               ; The stubs, copied to $CC98 (see desk.inc)
00E050  1  20 D0 FF     STUBS:  jsr $FFD0               ; $CC98 RESUME: back to the desktop
00E053  1  14                   .byte DESKBANK1
00E054  1  80 E0                .word resume
00E056  1  00 00                .byte 0, 0
00E058  1  20 B0 CC             jsr TARGET              ; $CCA0 LAUNCH: call the program, then back
00E05B  1  A9 14                lda #DESKBANK1
00E05D  1  8D 20 D0             sta BANK
00E060  1  4C 98 CC             jmp RESUME
00E063  1  00 00 00 00          .byte 0, 0, 0, 0, 0
00E067  1  00           
00E068  1  4C FF FF             jmp $FFFF               ; $CCB0 TARGET (set for each program)
00E06B  1  00 00 00 00          .byte 0, 0, 0, 0, 0
00E06F  1  00           
00E070  1  A9 20                lda #LAUNCHBANK         ; $CCB8 BANKLD: disk LOAD with the launch
00E072  1  8D 20 D0             sta BANK                ; bank selected
00E075  1  A9 03                lda #3
00E077  1  8D 40 D0             sta DCMD
00E07A  1  A9 14                lda #DESKBANK1
00E07C  1  8D 20 D0             sta BANK
00E07F  1  60                   rts
00E080  1               STUBEND:
00E080  1               
00E080  1               ; --- back from a program (or G after F1) -----------------------------------------------
00E080  1  D8           resume: cld
00E081  1  A9 03                lda #3                  ; first of all the program's interrupts off
00E083  1  8D 00 D0             sta SYSCTL              ; (its handler is about to be swapped out)
00E086  1  A9 20                lda #LAUNCHBANK         ; the banks the program took are free again
00E088  1  20 B6 FF             jsr BFREEALL
00E08B  1  A9 FD                lda #OWN_MAIN
00E08D  1  20 B6 FF             jsr BFREEALL
00E090  1  AD 67 EE             lda LAUNCHED            ; our RAM back from banks $C0-$CC
00E093  1  F0 2D                beq @nore
00E095  1  A9 00                lda #0
00E097  1  8D 10 D2             sta DMASRC
00E09A  1  8D 11 D2             sta DMASRC+1
00E09D  1  8D 13 D2             sta DMASRC+3
00E0A0  1  8D 14 D2             sta DMASRC+4
00E0A3  1  8D 16 D2             sta DMASRC+6
00E0A6  1  8D 18 D2             sta DMASRC+8
00E0A9  1  A9 0C                lda #SAVEBANK >> 4
00E0AB  1  8D 12 D2             sta DMASRC+2
00E0AE  1  A9 FF                lda #$FF
00E0B0  1  8D 15 D2             sta DMASRC+5
00E0B3  1  A9 CC                lda #$CC
00E0B5  1  8D 17 D2             sta DMASRC+7
00E0B8  1  A9 01                lda #1
00E0BA  1  8D 19 D2             sta DMACMD
00E0BD  1  A9 00                lda #0
00E0BF  1  8D 67 EE             sta LAUNCHED
00E0C2  1  AE 66 EE     @nore:  ldx MAINSP
00E0C5  1  9A                   txs
00E0C6  1  A9 03                lda #3                  ; video and sound as at power-on
00E0C8  1  8D 00 D0             sta SYSCTL
00E0CB  1  A9 0E 20 88          TK TK_CLEAR             ; the desktop's screen again
00E0CF  1  CC           
00E0D0  1  20 9D ED             jsr far_init
00E0D3  1               
00E0D3  1               ; Menus, the windows, the directory
00E0D3  1               rebuild:
00E0D3  1  A9 98                lda #<RESUME            ; G (after F1) comes back here
00E0D5  1  8D 02 D0             sta WARMLO
00E0D8  1  A9 CC                lda #>RESUME
00E0DA  1  8D 03 D0             sta WARMHI
00E0DD  1  A9 FF                lda #$FF                ; (no windows yet)
00E0DF  1  8D 6B EE             sta WDISK
00E0E2  1  8D 6C EE             sta WCLOCK
00E0E5  1  8D 6D EE             sta WCALC
00E0E8  1  20 A3 ED             jsr far_menus
00E0EB  1  A9 01 85 02          LDW r0, 1               ; UPDATEs for the desktop too (its Disk icon)
00E0EF  1  A9 00 85 03  
00E0F3  1  A9 10 20 88          TK TK_DESKEVENTS
00E0F7  1  CC           
00E0F8  1  AD 72 EE             lda DISKON
00E0FB  1  F0 03                beq @nod
00E0FD  1  20 BF E3             jsr opendisk
00E100  1  AD 6E EE     @nod:   lda CLOCKON
00E103  1  F0 03                beq @c
00E105  1  20 F7 E2             jsr openclock
00E108  1  AD 6F EE     @c:     lda CALCON
00E10B  1  F0 03                beq mainloop
00E10D  1  20 3B E3             jsr opencalc
00E110  1               
00E110  1               ; --- the main loop ------------------------------------------------------------------------
00E110  1               mainloop:
00E110  1  A9 07 20 88          TK TK_POLLEVENT
00E114  1  CC           
00E115  1  D0 23                bne @ev
00E117  1  AD 6C EE             lda WCLOCK              ; nothing: the clock ticks
00E11A  1  30 13                bmi @w
00E11C  1  AD 06 D0             lda CLOCKS
00E11F  1  CD 70 EE             cmp LASTSEC
00E122  1  F0 0B                beq @w
00E124  1  8D 70 EE             sta LASTSEC
00E127  1  AE 6C EE             ldx WCLOCK
00E12A  1  A9 0C 20 88          TK TK_INVAL
00E12E  1  CC           
00E12F  1  AD 01 D0     @w:     lda FRAME
00E132  1  CD 01 D0     @wf:    cmp FRAME
00E135  1  F0 FB                beq @wf
00E137  1  4C 10 E1             jmp mainloop
00E13A  1  C9 04        @ev:    cmp #EV_UPDATE
00E13C  1  D0 06                bne @n1
00E13E  1  20 76 E1             jsr update
00E141  1  4C 10 E1             jmp mainloop
00E144  1  C9 03        @n1:    cmp #EV_CLICK
00E146  1  D0 06                bne @n2
00E148  1  20 96 E1             jsr click
00E14B  1  4C 10 E1             jmp mainloop
00E14E  1  C9 02        @n2:    cmp #EV_MENU
00E150  1  D0 06                bne @n3
00E152  1  20 5C E2             jsr menu
00E155  1  4C 10 E1             jmp mainloop
00E158  1  C9 01        @n3:    cmp #EV_KEY
00E15A  1  D0 06                bne @n4
00E15C  1  20 B1 E1             jsr key
00E15F  1  4C 10 E1             jmp mainloop
00E162  1  C9 05        @n4:    cmp #EV_CLOSE
00E164  1  D0 06                bne @n5
00E166  1  20 D2 E1             jsr close
00E169  1  4C 10 E1             jmp mainloop
00E16C  1  C9 06        @n5:    cmp #EV_WHEEL
00E16E  1  D0 03                bne @n6
00E170  1  20 14 E2             jsr wheel
00E173  1  4C 10 E1     @n6:    jmp mainloop
00E176  1               
00E176  1               ; --- events -------------------------------------------------------------------------------
00E176  1  E0 FF        update: cpx #$FF
00E178  1  D0 03                bne @u0
00E17A  1  4C 11 E4             jmp drawdesk
00E17D  1  EC 6B EE     @u0:    cpx WDISK
00E180  1  D0 03                bne @u1
00E182  1  4C 1C E7             jmp drawdisk
00E185  1  EC 6C EE     @u1:    cpx WCLOCK
00E188  1  D0 03                bne @u2
00E18A  1  4C BB ED             jmp far_clock
00E18D  1  EC 6D EE     @u2:    cpx WCALC
00E190  1  D0 03                bne @r
00E192  1  4C C1 ED             jmp far_calc
00E195  1  60           @r:     rts
00E196  1               
00E196  1  E0 FF        click:  cpx #$FF
00E198  1  D0 03                bne @c0
00E19A  1  4C F5 E4             jmp deskclick
00E19D  1  EC 6B EE     @c0:    cpx WDISK
00E1A0  1  D0 03                bne @c1
00E1A2  1  4C F8 EA             jmp diskclick
00E1A5  1  EC 6D EE     @c1:    cpx WCALC
00E1A8  1  D0 06                bne @r
00E1AA  1  AE 6D EE             ldx WCALC
00E1AD  1  4C C7 ED             jmp far_cclick
00E1B0  1  60           @r:     rts
00E1B1  1               
00E1B1  1  86 84        key:    stx D0
00E1B3  1  A2 FF                ldx #$FF                ; which window is in front?
00E1B5  1  A9 0D 20 88          TK TK_FRONT
00E1B9  1  CC           
00E1BA  1  E0 FF                cpx #$FF                ; no window at all (WCALC is $FF too then)
00E1BC  1  F0 0A                beq @k1
00E1BE  1  EC 6D EE             cpx WCALC
00E1C1  1  D0 05                bne @k1
00E1C3  1  A5 84                lda D0                  ; the calculator takes the keys
00E1C5  1  4C CD ED             jmp far_ckey
00E1C8  1  A5 84        @k1:    lda D0
00E1CA  1  C9 0D                cmp #13                 ; Enter opens the selected file (or the disk)
00E1CC  1  D0 03                bne @r
00E1CE  1  4C 06 E4             jmp openany
00E1D1  1  60           @r:     rts
00E1D2  1               
00E1D2  1  EC 6C EE     close:  cpx WCLOCK
00E1D5  1  D0 10                bne @c1
00E1D7  1  A9 05 20 88          TK TK_CLOSEWIN
00E1DB  1  CC           
00E1DC  1  A9 FF                lda #$FF
00E1DE  1  8D 6C EE             sta WCLOCK
00E1E1  1  A9 00                lda #0
00E1E3  1  8D 6E EE             sta CLOCKON
00E1E6  1  60                   rts
00E1E7  1  EC 6D EE     @c1:    cpx WCALC
