000078r 1  4A                   lsr
000079r 1  4A                   lsr
00007Ar 1  8D rr rr             sta SBASE+2
00007Dr 1  A9 00                lda #0
00007Fr 1  8D rr rr             sta SBASE
000082r 1  20 rr rr             jsr savepb
000085r 1  A9 00                lda #0                  ; the header
000087r 1  8D rr rr             sta T0
00008Ar 1  8D rr rr             sta T0+1
00008Dr 1  20 rr rr             jsr seek
000090r 1  A2 00                ldx #0
000092r 1  AD 0B D2     @h:     lda PBDATA
000095r 1  9D rr rr             sta HDR,x
000098r 1  E8                   inx
000099r 1  E0 10                cpx #16
00009Br 1  D0 F5                bne @h
00009Dr 1  AD rr rr             lda HDR
0000A0r 1  C9 4D                cmp #'M'
0000A2r 1  D0 07                bne @bad
0000A4r 1  AD rr rr             lda HDR+1
0000A7r 1  C9 55                cmp #'U'
0000A9r 1  F0 05                beq @good
0000ABr 1  20 rr rr     @bad:   jsr restpb
0000AEr 1  38                   sec
0000AFr 1  60                   rts
0000B0r 1  AD rr rr     @good:  lda HDR+3
0000B3r 1  8D rr rr             sta SPEED
0000B6r 1  AD rr rr             lda HDR+4
0000B9r 1  8D rr rr             sta NORD
0000BCr 1  AD rr rr             lda HDR+5
0000BFr 1  8D rr rr             sta LOOP
0000C2r 1  AD rr rr             lda HDR+6
0000C5r 1  8D rr rr             sta ROWS
0000C8r 1  AD rr rr             lda HDR+7
0000CBr 1  8D rr rr             sta NINS
0000CEr 1  AD rr rr             lda HDR+12
0000D1r 1  8D rr rr             sta PATOFF
0000D4r 1  AD rr rr             lda HDR+13
0000D7r 1  8D rr rr             sta PATOFF+1
0000DAr 1  A9 10                lda #16                 ; the instruments, 8 bytes each, from byte 16
0000DCr 1  8D rr rr             sta T0
0000DFr 1  A9 00                lda #0
0000E1r 1  8D rr rr             sta T0+1
0000E4r 1  20 rr rr             jsr seek
0000E7r 1  AD rr rr             lda NINS
0000EAr 1  0A                   asl
0000EBr 1  0A                   asl
0000ECr 1  0A                   asl
0000EDr 1  8D rr rr             sta T1                  ; (0 = 256: 32 instruments)
0000F0r 1  A2 00                ldx #0
0000F2r 1  AD 0B D2     @i:     lda PBDATA
0000F5r 1  9D rr rr             sta INSTR,x
0000F8r 1  E8                   inx
0000F9r 1  EC rr rr             cpx T1
0000FCr 1  D0 F4                bne @i
0000FEr 1  AD rr rr             lda HDR+10              ; the order list, 3 pattern numbers each
000101r 1  8D rr rr             sta T0
000104r 1  AD rr rr             lda HDR+11
000107r 1  8D rr rr             sta T0+1
00010Ar 1  20 rr rr             jsr seek
00010Dr 1  A2 00                ldx #0
00010Fr 1  AD 0B D2     @o:     lda PBDATA
000112r 1  9D rr rr             sta ORD0,x
