000118r 1  9D rr rr             sta ORD1,x
00011Br 1  AD 0B D2             lda PBDATA
00011Er 1  9D rr rr             sta ORD2,x
000121r 1  E8                   inx
000122r 1  EC rr rr             cpx NORD
