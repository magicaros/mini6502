000056r 1  8A                   txa
000057r 1  29 0F                and #15
000059r 1  8D rr rr             sta MASTER
00005Cr 1  18                   clc
00005Dr 1  60                   rts
00005Er 1  38           :       sec                     ; unknown function
00005Fr 1  60                   rts
000060r 1               
000060r 1               ; --- PLAY ------------------------------------------------------------------
000060r 1  A9 00        play:   lda #0                  ; the interrupt leaves us alone meanwhile
000062r 1  8D rr rr             sta STATE
000065r 1  20 rr rr             jsr silence
000068r 1  8E rr rr             stx SBASE+2             ; song start = bank * 4096
00006Br 1  8A                   txa
00006Cr 1  0A                   asl
00006Dr 1  0A                   asl
00006Er 1  0A                   asl
00006Fr 1  0A                   asl
