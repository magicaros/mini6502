000382r 1               
000382r 1               ; A (0-15) times MASTER / 15
000382r 1               scalevol:
000382r 1  29 0F                and #15
000384r 1  8D rr rr             sta T1
000387r 1  AD rr rr             lda MASTER
00038Ar 1  0A                   asl
00038Br 1  0A                   asl
00038Cr 1  0A                   asl
00038Dr 1  0A                   asl
