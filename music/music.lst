000000r 1               ; music.asm - the mini6502 music engine                   (bank $12, $E000)
000000r 1               ; Public domain. Plays a song (a .MUS file, see README.txt) on the three
000000r 1               ; music voices from the frame interrupt, so it keeps playing while other
000000r 1               ; programs run. The noise voice (voice 4) is left to programs: sound
000000r 1               ; effects never steal a note from the music.
000000r 1               ;
000000r 1               ; Calling it (far-call entries, made by V 19 12 E000 / V 1A 12 E003):
000000r 1               ;   assembly  LDA #function : LDX #argument : JSR $CCD0      (entry $19)
000000r 1               ;   BASIC     POKE 52446,function:POKE 52447,argument:CALL 52440 (entry $1A)
000000r 1               ;             (52446/52447 = $CCDE/$CCDF, the spare bytes of entry $1A)
000000r 1               ; Functions:
000000r 1               ;   0 PLAY      X = the bank where the song starts (it may go on into the
000000r 1               ;               next banks). Carry set (and nothing played) if it is not a
000000r 1               ;               song. Takes the interrupt: IRQVEC, IRQBANK, IRQEN bit 0.
000000r 1               ;   1 STOP      the music stops, the interrupt is let go
000000r 1               ;   2 PAUSE     the voices are released; 3 CONTINUE carries on
000000r 1               ;   4 STATUS    A = 0 stopped, 1 playing, 2 paused; X = order, Y = row
000000r 1               ;               (BASIC: $CCDE = state, $CCDF = order)
000000r 1               ;   5 VOLUME    X = 0-15, the loudness of the whole song (15 at first;
000000r 1               ;               from each voice's next instrument or volume on)
000000r 1               ;
000000r 1               ; Inside the interrupt the engine uses port B (put back as it was), the
000000r 1               ; voices 1-3 and nothing else: no zero page, no fixed RAM, all its
000000r 1               ; variables are in this bank.
000000r 1               
000000r 1               BANK    = $D020
000000r 1               IRQEN   = $D007
000000r 1               IRQBANK = $D009
000000r 1               IRQVEC  = $D00A
000000r 1               SND     = $D030         ; voice N: NOTE, VOL, WAVE, DUR at SND + 4*N
000000r 1               SHP     = $D050         ; voice N: DECAY, SWEEP, PULSE, BEND at SHP + 4*N
000000r 1               PBADR   = $D208         ; port B: address (3 bytes), data, step
000000r 1               PBDATA  = $D20B
000000r 1               PBSTEP  = $D20C
000000r 1               BOXFN   = $CCDE         ; BASIC's mailbox (spare bytes of entry $1A)
000000r 1               BOXARG  = $CCDF
000000r 1               
000000r 1               NVOICE  = 3
000000r 1               ; effects (column 3 of a pattern row; the 4th byte is its parameter)
000000r 1               FX_ARP  = 1             ; arpeggio: note, +hi nibble, +lo nibble semitones
000000r 1               FX_SLIDE = 2            ; SWEEP = parameter (signed) for this row
000000r 1               FX_VIB  = 3             ; vibrato: speed (hi nibble), depth (lo nibble)
000000r 1               FX_VOL  = 4             ; volume = parameter (0-15)
000000r 1               FX_SPEED = 5            ; frames per row = parameter
000000r 1               FX_JUMP = 6             ; after this row, go to order = parameter
000000r 1               FX_BREAK = 7            ; after this row, go to the next order
000000r 1               FX_PULSE = 8            ; PULSE = parameter (0-15)
000000r 1               
000000r 1               .segment "CODE"
000000r 1  4C rr rr             jmp api                 ; $E000: A = function, X = argument
000003r 1  4C rr rr             jmp apibox              ; $E003: the same from BASIC's mailbox
000006r 1  4D 55 53 49          .byte "MUSIC", 0        ; (for whoever looks)
00000Ar 1  43 00        
00000Cr 1               
00000Cr 1  AD DE CC     apibox: lda BOXFN
00000Fr 1  AE DF CC             ldx BOXARG
000012r 1  20 rr rr             jsr api
000015r 1  8D DE CC             sta BOXFN
000018r 1  8E DF CC             stx BOXARG
00001Br 1  60                   rts
00001Cr 1               
