000286r 1  60           @done:  rts
000287r 1               
000287r 1               ; The cell of voice CURV (Y = CURV * 4)
000287r 1  AE rr rr     docell: ldx CURV
00028Ar 1  AD rr rr             lda CINS                ; a new instrument
00028Dr 1  F0 37                beq @noins
00028Fr 1  CD rr rr             cmp NINS
000292r 1  F0 02                beq @insok
000294r 1  B0 30                bcs @noins              ; (not in the song: ignored)
000296r 1  9D rr rr     @insok: sta VINS,x
000299r 1  20 rr rr             jsr insidx              ; X = its first byte in INSTR
00029Cr 1  BD rr rr             lda INSTR+2,x           ; WAVE
00029Fr 1  99 32 D0             sta SND+2,y
0002A2r 1  BD rr rr             lda INSTR+1,x           ; VOL (times the song's volume)
0002A5r 1  20 rr rr             jsr scalevol
