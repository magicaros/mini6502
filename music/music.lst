000038r 1  C9 02                cmp #2
00003Ar 1  D0 05                bne @ok
00003Cr 1  A9 01                lda #1
00003Er 1  8D rr rr             sta STATE
000041r 1  18           @ok:    clc
000042r 1  60                   rts
000043r 1  C9 04        :       cmp #4
000045r 1  D0 0B                bne :+
000047r 1  AD rr rr             lda STATE
