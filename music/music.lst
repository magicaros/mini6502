0001C5r 1               
0001C5r 1               ; --- the interrupt ------------------------------------------------------------
0001C5r 1               handler:
0001C5r 1  29 01                and #1                  ; a frame?
0001C7r 1  F0 25                beq @r
0001C9r 1  AD rr rr             lda STATE
0001CCr 1  C9 01                cmp #1
0001CEr 1  D0 1E                bne @r
