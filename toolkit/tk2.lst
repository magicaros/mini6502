00ED1C  2  8D 16 D3             sta BDY
00ED1F  2  A5 25                lda RY0+1
00ED21  2  8D 1F D3             sta BDYH
00ED24  2  20 70 EC             jsr clipfull
00ED27  2  A9 06                lda #C_COPY
00ED29  2  8D 18 D3             sta BCMD
00ED2C  2  A9 00                lda #0
00ED2E  2  8D 02 D3             sta DRAW
00ED31  2  60                   rts
