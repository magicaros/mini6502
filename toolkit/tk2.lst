00ED44  2  85 49                sta MY+1
00ED46  2  60                   rts
00ED47  2               
00ED47  2               ; Carry set if MX,MY is inside RX0..RY1
00ED47  2               inrect:
00ED47  2  A5 46                lda MX                  ; MX >= RX0
00ED49  2  C5 22                cmp RX0
00ED4B  2  A5 47                lda MX+1
00ED4D  2  E5 23                sbc RX0+1
00ED4F  2  90 1C                bcc @no
00ED51  2  A5 26                lda RX1                 ; RX1 >= MX
00ED53  2  C5 46                cmp MX
00ED55  2  A5 27                lda RX1+1
00ED57  2  E5 47                sbc MX+1
