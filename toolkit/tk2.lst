00EDBB  2  0A                   asl
00EDBC  2  0A                   asl
00EDBD  2  0A                   asl
00EDBE  2  05 3C                ora T3
00EDC0  2  8D 09 D2             sta PBADR+1
00EDC3  2  A5 40                lda CBANK
00EDC5  2  4A                   lsr
00EDC6  2  4A                   lsr
00EDC7  2  4A                   lsr
00EDC8  2  4A                   lsr
00EDC9  2  8D 0A D2             sta PBADR+2
00EDCC  2  60                   rts
00EDCD  2  A5 37        @fixed: lda T0+1
00EDCF  2  8D 09 D2             sta PBADR+1
00EDD2  2  A9 FF                lda #$FF
00EDD4  2  8D 0A D2             sta PBADR+2
00EDD7  2  60                   rts
00EDD8  2               
00EDD8  2               ; Copies the caller's string at T0 to QP (fixed RAM), at most A characters,
00EDD8  2               ; always ending with 0
00EDD8  2               fetchstr:
00EDD8  2  85 3D                sta T3+1
00EDDA  2  20 A5 ED             jsr farptr
