00EDA0  2  E5 44                sbc TMPC
00EDA2  2  85 37                sta T0+1
00EDA4  2  60                   rts
00EDA5  2               
00EDA5  2               ; Port B = the caller's address T0: $E000-$EFFF is in the caller's bank
00EDA5  2               ; (CBANK), anything else in the fixed RAM
00EDA5  2               farptr:
00EDA5  2  A5 36                lda T0
00EDA7  2  8D 08 D2             sta PBADR
00EDAA  2  A5 37                lda T0+1
00EDAC  2  29 F0                and #$F0
00EDAE  2  C9 E0                cmp #$E0
00EDB0  2  D0 1B                bne @fixed
00EDB2  2  A5 37                lda T0+1
00EDB4  2  29 0F                and #$0F
