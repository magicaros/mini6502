00ED5B  2  A5 48                lda MY
00ED5D  2  C5 24                cmp RY0
00ED5F  2  A5 49                lda MY+1
00ED61  2  E5 25                sbc RY0+1
00ED63  2  90 08                bcc @no
00ED65  2  A5 28                lda RY1
00ED67  2  C5 48                cmp MY
00ED69  2  A5 29                lda RY1+1
00ED6B  2  E5 49                sbc MY+1
00ED6D  2  60           @no:    rts                     ; carry = the last comparison
00ED6E  2               
