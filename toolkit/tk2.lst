00E0E2  1  B0 03                bcs @done
00E0E4  1  4C 59 E0             jmp @item
00E0E7  1  20 49 E1     @done:  jsr layout
00E0EA  1  4C 91 E1             jmp m_drawbar
00E0ED  1               
00E0ED  1               ; Looks for "/X" at the end of item X's text (TLEN characters from IPL/IPH)
00E0ED  1               shortcut:
00E0ED  1  BD 40 03             lda IPL,x
00E0F0  1  85 32                sta TP
00E0F2  1  BD 80 03             lda IPH,x
00E0F5  1  85 33                sta TP+1
00E0F7  1  AC F3 ED             ldy TLEN
00E0FA  1  C0 02                cpy #2
00E0FC  1  90 23                bcc @no
00E0FE  1  88                   dey
00E0FF  1  88                   dey
00E100  1  B1 32                lda (TP),y
00E102  1  C9 2F                cmp #'/'
00E104  1  D0 1B                bne @no
00E106  1  C8                   iny
00E107  1  B1 32                lda (TP),y
00E109  1  29 DF                and #$DF                ; upper case
00E10B  1  C9 41                cmp #'A'
00E10D  1  90 12                bcc @no
00E10F  1  C9 5B                cmp #'Z'+1
00E111  1  B0 0E                bcs @no
00E113  1  9D 00 04             sta IKEY,x
00E116  1  88                   dey
00E117  1  A9 00                lda #0                  ; the "/X" is not shown
00E119  1  91 32                sta (TP),y
00E11B  1  CE F3 ED             dec TLEN
00E11E  1  CE F3 ED             dec TLEN
00E121  1  60           @no:    rts
00E122  1               
00E122  1               ; Copies the next string from port B to QP (with its 0); Y = its length,
00E122  1               ; Z set if empty. Stops at the end of MTEXT.
00E122  1  A0 00        getstr: ldy #0
00E124  1  A5 35        @l:     lda QP+1
00E126  1  C9 07                cmp #>MTEXTEND
00E128  1  B0 0A                bcs @full
00E12A  1  AD 0B D2             lda PBDATA
00E12D  1  91 34                sta (QP),y
00E12F  1  F0 07                beq @e
00E131  1  C8                   iny
00E132  1  D0 F0                bne @l
00E134  1  A9 00        @full:  lda #0
00E136  1  91 34                sta (QP),y
00E138  1  84 3A        @e:     sty T2                  ; (Y and the Z flag for the caller)
00E13A  1  C0 00                cpy #0
00E13C  1  60                   rts
00E13D  1               
00E13D  1               ; QP moves past the string just copied (T2 + 1)
00E13D  1               advance:
00E13D  1  A5 34                lda QP
00E13F  1  38                   sec
00E140  1  65 3A                adc T2
00E142  1  85 34                sta QP
00E144  1  90 02                bcc @r
00E146  1  E6 35                inc QP+1
00E148  1  60           @r:     rts
00E149  1               
00E149  1               ; Title positions: from x = 8, each title " title " wide
00E149  1  A9 08 85 36  layout: LDW T0, 8
00E14D  1  A9 00 85 37  
00E151  1  A2 00                ldx #0
00E153  1  E4 4F        @l:     cpx NMENU
00E155  1  F0 23                beq @e
00E157  1  A5 36                lda T0
00E159  1  9D 28 03             sta MXL,x
00E15C  1  A5 37                lda T0+1
00E15E  1  9D 30 03             sta MXH,x
00E161  1  20 7B E1             jsr titlelen            ; + (length + 2) * 8
00E164  1  18                   clc
00E165  1  69 02                adc #2
00E167  1  0A                   asl
00E168  1  0A                   asl
00E169  1  0A                   asl
00E16A  1  90 02                bcc @a
00E16C  1  E6 37                inc T0+1
00E16E  1  18           @a:     clc
00E16F  1  65 36                adc T0
00E171  1  85 36                sta T0
00E173  1  90 02                bcc @n
00E175  1  E6 37                inc T0+1
00E177  1  E8           @n:     inx
00E178  1  D0 D9                bne @l
00E17A  1  60           @e:     rts
00E17B  1               
00E17B  1               ; A = length of menu X's title (TP = it)
00E17B  1               titlelen:
00E17B  1  BD 08 03             lda MTL,x
00E17E  1  85 32                sta TP
00E180  1  BD 10 03             lda MTH,x
00E183  1  85 33                sta TP+1
00E185  1  8A                   txa
00E186  1  48                   pha
00E187  1  20 B5 EC             jsr strlen
00E18A  1  85 44                sta TMPC
00E18C  1  68                   pla
00E18D  1  AA                   tax
00E18E  1  A5 44                lda TMPC
00E190  1  60                   rts
