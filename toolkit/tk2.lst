000000r 1               ;=============================================================================
000000r 1               ; tk2.asm - mini6502 desktop toolkit, bank $11: menus and dialogs
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Public domain. Called from bank $10 (tk1.asm) through the jump table.
000000r 1               ;=============================================================================
000000r 1               
000000r 1                       .include "tk.inc"
000000r 2               ;=============================================================================
000000r 2               ; tk.inc - mini6502 desktop toolkit: shared definitions (both toolkit banks)
000000r 2               ;-----------------------------------------------------------------------------
000000r 2               ; Public domain. See README.txt for the programming interface.
000000r 2               ;=============================================================================
000000r 2               
000000r 2               TKBANK1 = $10           ; dispatcher, windows, events
000000r 2               TKBANK2 = $11           ; menus, dialogs
000000r 2               SWAPBANK = $D0          ; the caller's RAM ($0000-$CBFF) while the desktop runs
000000r 2               
000000r 2               ; --- function numbers (A when calling TOOL = $CC88) --------------------------
000000r 2               TK_INIT     = 0
000000r 2               TK_EXIT     = 1
000000r 2               TK_MENUBAR  = 2
000000r 2               TK_MENUITEM = 3
000000r 2               TK_OPENWIN  = 4
000000r 2               TK_CLOSEWIN = 5
000000r 2               TK_GETEVENT = 6
000000r 2               TK_POLLEVENT = 7
000000r 2               TK_SETPORT  = 8
000000r 2               TK_ALERT    = 9
000000r 2               TK_ASK      = 10
000000r 2               TK_TEXT     = 11
000000r 2               TK_INVAL    = 12
000000r 2               TK_FRONT    = 13
000000r 2               TK_CLEAR    = 14
000000r 2               TK_SETTITLE = 15
000000r 2               TK_LAST     = 15
000000r 2               
000000r 2               ; --- events (A after GETEVENT / POLLEVENT) ---------------------------------------
000000r 2               EV_NONE   = 0
000000r 2               EV_KEY    = 1           ; X = character (0: Y = KBDEXT code)
000000r 2               EV_MENU   = 2           ; X = menu, Y = item
000000r 2               EV_CLICK  = 3           ; X = window ($FF desktop), Y = buttons (+$80 double), r0/r1 = x/y
000000r 2               EV_UPDATE = 4           ; X = window: draw its contents (clip already set)
000000r 2               EV_CLOSE  = 5           ; X = window: its close box was clicked
000000r 2               EV_WHEEL  = 6           ; X = front window ($FF none), Y = steps (signed)
000000r 2               
000000r 2               ; --- hardware ------------------------------------------------------------------------
000000r 2               FRAME   = $D001
000000r 2               KBD     = $D010
000000r 2               KBDCR   = $D011
000000r 2               KBDEXT  = $D019
000000r 2               BANK    = $D020
000000r 2               DMASRC  = $D210         ; DMA: source, destination, length
000000r 2               DMACMD  = $D219
000000r 2               PBADR   = $D208         ; port B (the toolkit's): address, data, step
000000r 2               PBDATA  = $D20B
000000r 2               PBSTEP  = $D20C
000000r 2               MODE    = $D300
000000r 2               SHOW    = $D301
000000r 2               DRAW    = $D302
000000r 2               BX0     = $D310
000000r 2               BY0     = $D311
000000r 2               BX1     = $D312
000000r 2               BY1     = $D313
000000r 2               BCOL    = $D314
000000r 2               BDX     = $D315
000000r 2               BDY     = $D316
000000r 2               BSRC    = $D317
000000r 2               BCMD    = $D318
000000r 2               BX0H    = $D31A
000000r 2               BY0H    = $D31B
000000r 2               BX1H    = $D31C
000000r 2               BY1H    = $D31D
000000r 2               BDXH    = $D31E
000000r 2               BDYH    = $D31F
000000r 2               ROP     = $D328
000000r 2               PATON   = $D329
000000r 2               STYLE   = $D32B
000000r 2               CHOUT   = $D32C
000000r 2               PATTERN = $D330
000000r 2               CLIPR   = $D338
000000r 2               MOUSEX  = $D500
000000r 2               MOUSEY  = $D502
000000r 2               BUTTONS = $D504
000000r 2               WHEEL   = $D505
000000r 2               CLICKS  = $D506
000000r 2               PTR     = $D508
000000r 2               
000000r 2               C_CLEAR = 1
000000r 2               C_LINE  = 3
000000r 2               C_BOX   = 4
000000r 2               C_BOXF  = 5
000000r 2               C_COPY  = 6
000000r 2               C_STAMP = 10
000000r 2               R_SET   = 0
000000r 2               R_XOR   = 3
000000r 2               R_INV   = 4
000000r 2               S_BOLD  = 1
000000r 2               S_UNDER = 2
000000r 2               S_INV   = 8
000000r 2               S_OPAQUE = 16
000000r 2               
000000r 2               ; --- zero page -----------------------------------------------------------------------
000000r 2               r0      = $02           ; r0-r15: arguments and results, 2 bytes each
000000r 2               r1      = $04
000000r 2               r2      = $06
000000r 2               r3      = $08
000000r 2               r4      = $0A
000000r 2               r5      = $0C
000000r 2               RX0     = $22           ; the rectangle the drawing helpers use
000000r 2               RY0     = $24
000000r 2               RX1     = $26
000000r 2               RY1     = $28
000000r 2               DX0     = $2A           ; damage rectangle (redraw pass)
000000r 2               DY0     = $2C
000000r 2               DX1     = $2E
000000r 2               DY1     = $30
000000r 2               TP      = $32           ; text pointer
000000r 2               QP      = $34           ; second pointer
000000r 2               T0      = $36           ; temporaries
000000r 2               T1      = $38
000000r 2               T2      = $3A
000000r 2               T3      = $3C
000000r 2               WP      = $3E           ; pointer to a window record
000000r 2               CBANK   = $40           ; the caller's bank (set by the dispatcher)
000000r 2               EVX     = $41           ; event being returned: X, Y
000000r 2               EVY     = $42
000000r 2               TMPB    = $43
000000r 2               TMPC    = $44
000000r 2               MX      = $46           ; mouse position, 2 bytes each
000000r 2               MY      = $48
000000r 2               NUMW    = $4A           ; number of windows open
000000r 2               FRONTW  = $4B           ; window in front ($FF none)
000000r 2               PASSON  = $4C           ; nonzero: a redraw pass is going on
000000r 2               PEND    = $4D           ; windows still to redraw (bit per window)
000000r 2               UPDW    = $4E           ; window of the UPDATE being drawn ($FF none)
000000r 2               NMENU   = $4F           ; menus in the bar
000000r 2               DAMAGE  = $50           ; nonzero: DX0..DY1 must be redrawn
000000r 2               
000000r 2               ; --- fixed RAM ----------------------------------------------------------------------
000000r 2               WINREC  = $0200         ; 8 window records of 32 bytes
000000r 2               W_USED  = 0             ;  1 if open
000000r 2               W_X0    = 1             ;  outer rectangle (the shadow is 2 more right/down)
000000r 2               W_Y0    = 3
000000r 2               W_X1    = 5
000000r 2               W_Y1    = 7
000000r 2               W_TITLE = 9             ;  title, up to 22 characters + 0
000000r 2               ZORDER  = $0300         ; window numbers, back to front (NUMW of them)
000000r 2               MTL     = $0308         ; menu: title address, low / high (8 + 8)
000000r 2               MTH     = $0310
000000r 2               MFIRST  = $0318         ; menu: first item number (8)
000000r 2               MCOUNT  = $0320         ; menu: number of items (8)
000000r 2               MXL     = $0328         ; menu: title x position, low / high (8 + 8)
000000r 2               MXH     = $0330
000000r 2               MWIDTH  = $0338         ; menu: width of its box in characters (8)
000000r 2               IPL     = $0340         ; item: text address, low / high (64 + 64)
000000r 2               IPH     = $0380
000000r 2               IFLAG   = $03C0         ; item: 1 enabled, 2 separator (64)
000000r 2               IKEY    = $0400         ; item: Ctrl+key shortcut letter, 0 none (64)
000000r 2               MTEXT   = $0480         ; menu texts
000000r 2               MTEXTEND = $07FE
000000r 2               MAGIC   = $07FE         ; "TK" while a toolkit program runs
000000r 2               STRBUF  = $C000         ; strings copied from the caller (dialogs)
000000r 2               STRBUF2 = $C100
000000r 2               ASKBUF  = $C200
000000r 2               
000000r 2               MAXWIN  = 8
000000r 2               MAXMENU = 8
000000r 2               MAXITEM = 64
000000r 2               TITLEH  = 19            ; window title bar: rows y0..y0+18, line at y0+19
000000r 2               MENUH   = 19            ; menu bar: rows 0..18, line at 19
000000r 2               
000000r 2               ; --- helpers ---------------------------------------------------------------------------
000000r 2               .macro  LDW dst, val            ; dst = 16-bit constant
000000r 2                       lda #<(val)
000000r 2                       sta dst
000000r 2                       lda #>(val)
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  MOVW dst, src           ; dst = src (16-bit)
000000r 2                       lda src
000000r 2                       sta dst
000000r 2                       lda src+1
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  ADDW dst, src, val      ; dst = src + constant
000000r 2                       lda src
000000r 2                       clc
000000r 2                       adc #<(val)
000000r 2                       sta dst
000000r 2                       lda src+1
000000r 2                       adc #>(val)
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  SUBW dst, src, val      ; dst = src - constant
000000r 2                       lda src
000000r 2                       sec
000000r 2                       sbc #<(val)
000000r 2                       sta dst
000000r 2                       lda src+1
000000r 2                       sbc #>(val)
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  FAR bank, addr          ; call into another bank: returns to whoever
000000r 2                                               ; called the routine this is in (use it as
000000r 2                                               ; the whole body of a routine called by JSR)
000000r 2                       jsr $FFD0
000000r 2                       .byte bank
000000r 2                       .word addr
000000r 2               .endmacro
000000r 2               
000000r 1               
000000r 1                       .org $E000
00E000  1               
00E000  1  4C 12 E0             jmp m_setbar            ; $E000
00E003  1  4C F2 E1             jmp m_item              ; $E003
00E006  1  4C 46 E2             jmp m_track             ; $E006
00E009  1  4C 0C E2             jmp m_key               ; $E009
00E00C  1  4C FD E5             jmp d_alert             ; $E00C
00E00F  1  4C 0B E6             jmp d_ask               ; $E00F
00E012  1               
00E012  1               ; --- menus ---------------------------------------------------------------------------------
00E012  1               ; Definition (caller's memory): for each menu its title, 0, then its items,
00E012  1               ; each ending with 0, then an empty item (a lone 0); after the last menu an
00E012  1               ; empty title. Item "-" is a separator line; an item starting with "(" is
00E012  1               ; disabled; an item ending with "/X" has the shortcut Ctrl+X.
00E012  1               
00E012  1               m_setbar:
00E012  1  A5 02 85 36          MOVW T0, r0
00E016  1  A5 03 85 37  
00E01A  1  20 A5 ED             jsr farptr
00E01D  1  A9 80 85 34          LDW QP, MTEXT
00E021  1  A9 04 85 35  
00E025  1  A9 00                lda #0
00E027  1  85 4F                sta NMENU
00E029  1  8D F2 ED             sta NITEM
00E02C  1  A6 4F        @menu:  ldx NMENU
00E02E  1  A5 34                lda QP                  ; the title
00E030  1  9D 08 03             sta MTL,x
00E033  1  A5 35                lda QP+1
00E035  1  9D 10 03             sta MTH,x
00E038  1  20 22 E1             jsr getstr
00E03B  1  D0 03                bne @t
00E03D  1  4C E7 E0             jmp @done               ; empty title: the end
00E040  1  8C F3 ED     @t:     sty TLEN
00E043  1  C8                   iny                     ; width so far: the title + 2
00E044  1  C8                   iny
00E045  1  98                   tya
00E046  1  A6 4F                ldx NMENU
00E048  1  9D 38 03             sta MWIDTH,x
00E04B  1  AD F2 ED             lda NITEM
00E04E  1  9D 18 03             sta MFIRST,x
00E051  1  A9 00                lda #0
00E053  1  9D 20 03             sta MCOUNT,x
00E056  1  20 3D E1             jsr advance
00E059  1  AE F2 ED     @item:  ldx NITEM
00E05C  1  A5 34                lda QP
00E05E  1  9D 40 03             sta IPL,x
00E061  1  A5 35                lda QP+1
00E063  1  9D 80 03             sta IPH,x
00E066  1  A9 01                lda #1
00E068  1  9D C0 03             sta IFLAG,x
00E06B  1  A9 00                lda #0
00E06D  1  9D 00 04             sta IKEY,x
00E070  1  20 22 E1             jsr getstr
00E073  1  D0 0E                bne @i
00E075  1  20 3D E1             jsr advance             ; empty: the end of this menu's items
00E078  1  E6 4F                inc NMENU
00E07A  1  A5 4F                lda NMENU
00E07C  1  C9 08                cmp #MAXMENU
00E07E  1  D0 AC                bne @menu
00E080  1  4C E7 E0             jmp @done
00E083  1  8C F3 ED     @i:     sty TLEN
00E086  1  A0 00                ldy #0
00E088  1  B1 34                lda (QP),y
00E08A  1  C9 2D                cmp #'-'                ; separator
00E08C  1  D0 0C                bne @dis
00E08E  1  C8                   iny
00E08F  1  B1 34                lda (QP),y
00E091  1  D0 07                bne @dis
00E093  1  A9 02                lda #2
00E095  1  9D C0 03             sta IFLAG,x
00E098  1  D0 1B                bne @wid
00E09A  1  A0 00        @dis:   ldy #0
00E09C  1  B1 34                lda (QP),y
00E09E  1  C9 28                cmp #'('                ; disabled: "(" not shown
00E0A0  1  D0 10                bne @key
00E0A2  1  A9 00                lda #0
00E0A4  1  9D C0 03             sta IFLAG,x
00E0A7  1  FE 40 03             inc IPL,x
00E0AA  1  D0 03                bne @k0
00E0AC  1  FE 80 03             inc IPH,x
00E0AF  1  CE F3 ED     @k0:    dec TLEN
00E0B2  1  20 ED E0     @key:   jsr shortcut            ; "/X" at the end
00E0B5  1  AD F3 ED     @wid:   lda TLEN                ; width: text + 6 (+4 for "^X")
00E0B8  1  18                   clc
00E0B9  1  69 02                adc #2
00E0BB  1  BC 00 04             ldy IKEY,x
00E0BE  1  F0 02                beq @w
00E0C0  1  69 04                adc #4
00E0C2  1  A4 4F        @w:     ldy NMENU
00E0C4  1  D9 38 03             cmp MWIDTH,y
00E0C7  1  90 03                bcc @nw
00E0C9  1  99 38 03             sta MWIDTH,y
00E0CC  1  A4 4F        @nw:    ldy NMENU
00E0CE  1  B9 20 03             lda MCOUNT,y
00E0D1  1  18                   clc
00E0D2  1  69 01                adc #1
00E0D4  1  99 20 03             sta MCOUNT,y
00E0D7  1  20 3D E1             jsr advance
00E0DA  1  EE F2 ED             inc NITEM
00E0DD  1  AD F2 ED             lda NITEM
