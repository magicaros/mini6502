00E9EC  1  8D 28 D3             sta ROP
00E9EF  1  A9 00                lda #0
00E9F1  1  8D 29 D3             sta PATON
00E9F4  1  A9 01                lda #1
00E9F6  1  8D 14 D3             sta BCOL
00E9F9  1  20 07 EA             jsr setrect
