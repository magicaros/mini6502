00EA07  2               ;=============================================================================
00EA07  2               ; common.inc - drawing helpers assembled into both toolkit banks
00EA07  2               ;=============================================================================
00EA07  2               
00EA07  2               ; Blitter X0,Y0-X1,Y1 = RX0,RY0-RX1,RY1
00EA07  2               setrect:
00EA07  2  A5 22                lda RX0
00EA09  2  8D 10 D3             sta BX0
00EA0C  2  A5 23                lda RX0+1
00EA0E  2  8D 1A D3             sta BX0H
00EA11  2  A5 24                lda RY0
00EA13  2  8D 11 D3             sta BY0
00EA16  2  A5 25                lda RY0+1
00EA18  2  8D 1B D3             sta BY0H
00EA1B  2  A5 26                lda RX1
00EA1D  2  8D 12 D3             sta BX1
00EA20  2  A5 27                lda RX1+1
00EA22  2  8D 1C D3             sta BX1H
00EA25  2  A5 28                lda RY1
00EA27  2  8D 13 D3             sta BY1
00EA2A  2  A5 29                lda RY1+1
00EA2C  2  8D 1D D3             sta BY1H
00EA2F  2  60                   rts
00EA30  2               
00EA30  2               ; Filled box over RX0..RY1 with colour A (0 paper, 1 ink), plain SET
00EA30  2               fillrect:
00EA30  2  A2 00                ldx #R_SET
00EA32  2  8E 28 D3             stx ROP
00EA35  2  A2 00                ldx #0
00EA37  2  8E 29 D3             stx PATON
00EA3A  2  8D 14 D3     fillr2: sta BCOL
00EA3D  2  20 07 EA             jsr setrect
00EA40  2  A9 05                lda #C_BOXF
00EA42  2  8D 18 D3             sta BCMD
00EA45  2  60                   rts
00EA46  2               
00EA46  2               ; Frame (BOX) around RX0..RY1 in ink
00EA46  2               framerect:
00EA46  2  A9 00                lda #R_SET
00EA48  2  8D 28 D3             sta ROP
00EA4B  2  A9 00                lda #0
00EA4D  2  8D 29 D3             sta PATON
00EA50  2  A9 01                lda #1
00EA52  2  8D 14 D3             sta BCOL
00EA55  2  20 07 EA             jsr setrect
00EA58  2  A9 04                lda #C_BOX
00EA5A  2  8D 18 D3             sta BCMD
00EA5D  2  60                   rts
00EA5E  2               
00EA5E  2               ; RX0..RY1 filled with the current PATTERN
00EA5E  2               patrect:
00EA5E  2  A9 00                lda #R_SET
00EA60  2  8D 28 D3             sta ROP
00EA63  2  A9 01                lda #1
00EA65  2  8D 29 D3             sta PATON
00EA68  2  20 3A EA             jsr fillr2
00EA6B  2  A9 00                lda #0
00EA6D  2  8D 29 D3             sta PATON
00EA70  2  60                   rts
00EA71  2               
00EA71  2               ; RX0..RY1 inverted
00EA71  2               invrect:
00EA71  2  A9 04                lda #R_INV
00EA73  2  8D 28 D3             sta ROP
