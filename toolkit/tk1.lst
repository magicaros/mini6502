00EA78  2  8D 29 D3             sta PATON
00EA7B  2  20 3A EA             jsr fillr2
00EA7E  2  A9 00                lda #R_SET
00EA80  2  8D 28 D3             sta ROP
00EA83  2  60                   rts
00EA84  2               
00EA84  2               ; Clip rectangle = RX0..RY1
00EA84  2               clipset:
00EA84  2  A2 07                ldx #7
00EA86  2  B5 22        @c:     lda RX0,x
00EA88  2  9D 38 D3             sta CLIPR,x
00EA8B  2  CA                   dex
00EA8C  2  10 F8                bpl @c
00EA8E  2  60                   rts
00EA8F  2               
00EA8F  2               ; Clip rectangle = the whole screen
00EA8F  2               clipfull:
00EA8F  2  A9 00                lda #0
00EA91  2  8D 38 D3             sta CLIPR
00EA94  2  8D 39 D3             sta CLIPR+1
00EA97  2  8D 3A D3             sta CLIPR+2
00EA9A  2  8D 3B D3             sta CLIPR+3
00EA9D  2  A9 7F                lda #<639
00EA9F  2  8D 3C D3             sta CLIPR+4
00EAA2  2  A9 02                lda #>639
00EAA4  2  8D 3D D3             sta CLIPR+5
00EAA7  2  A9 8F                lda #<399
00EAA9  2  8D 3E D3             sta CLIPR+6
00EAAC  2  A9 01                lda #>399
00EAAE  2  8D 3F D3             sta CLIPR+7
00EAB1  2  60                   rts
00EAB2  2               
00EAB2  2               ; Text position X0 = T0, Y0 = T1
00EAB2  2               moveto:
00EAB2  2  A5 36                lda T0
00EAB4  2  8D 10 D3             sta BX0
00EAB7  2  A5 37                lda T0+1
00EAB9  2  8D 1A D3             sta BX0H
00EABC  2  A5 38                lda T1
00EABE  2  8D 11 D3             sta BY0
00EAC1  2  A5 39                lda T1+1
00EAC3  2  8D 1B D3             sta BY0H
00EAC6  2  60                   rts
00EAC7  2               
00EAC7  2               ; Draws the 0-terminated string at TP (fixed RAM) at X0,Y0 in STYLE
00EAC7  2               drawstr:
00EAC7  2  A0 00                ldy #0
00EAC9  2  B1 32        @l:     lda (TP),y
00EACB  2  F0 06                beq @e
00EACD  2  8D 2C D3             sta CHOUT
00EAD0  2  C8                   iny
00EAD1  2  D0 F6                bne @l
00EAD3  2  60           @e:     rts
00EAD4  2               
00EAD4  2               ; A = length of the string at TP (up to 255)
00EAD4  2               strlen:
00EAD4  2  A0 00                ldy #0
00EAD6  2  B1 32        @l:     lda (TP),y
00EAD8  2  F0 03                beq @e
00EADA  2  C8                   iny
00EADB  2  D0 F9                bne @l
00EADD  2  98           @e:     tya
00EADE  2  60                   rts
00EADF  2               
00EADF  2               ; PATTERN = 8 bytes at QP
00EADF  2               setpat:
00EADF  2  A0 07                ldy #7
00EAE1  2  B1 34        @p:     lda (QP),y
00EAE3  2  99 30 D3             sta PATTERN,y
00EAE6  2  88                   dey
00EAE7  2  10 F8                bpl @p
00EAE9  2  60                   rts
00EAEA  2               patgrey:
00EAEA  2  A9 00                lda #<pgrey
00EAEC  2  85 34                sta QP
00EAEE  2  A9 EB                lda #>pgrey
00EAF0  2  85 35                sta QP+1
00EAF2  2  4C DF EA             jmp setpat
00EAF5  2               patstripe:
00EAF5  2  A9 08                lda #<pstripe
00EAF7  2  85 34                sta QP
00EAF9  2  A9 EB                lda #>pstripe
00EAFB  2  85 35                sta QP+1
00EAFD  2  4C DF EA             jmp setpat
00EB00  2  AA 55 AA 55  pgrey:   .byte $AA, $55, $AA, $55, $AA, $55, $AA, $55
00EB04  2  AA 55 AA 55  
00EB08  2  00 FF 00 FF  pstripe: .byte $00, $FF, $00, $FF, $00, $FF, $00, $FF
00EB0C  2  00 FF 00 FF  
00EB10  2               
00EB10  2               ; COPY RX0..RY1 from page 0 to the same place on page 1 (save what is under)
00EB10  2               saveunder:
00EB10  2  A9 01                lda #1
00EB12  2  8D 02 D3             sta DRAW
00EB15  2  A9 00                lda #0
00EB17  2  8D 17 D3             sta BSRC
00EB1A  2  4C 27 EB             jmp copysame
00EB1D  2               ; ... and back from page 1 to page 0
00EB1D  2               restunder:
00EB1D  2  A9 00                lda #0
00EB1F  2  8D 02 D3             sta DRAW
00EB22  2  A9 01                lda #1
00EB24  2  8D 17 D3             sta BSRC
00EB27  2               copysame:
00EB27  2  A9 00                lda #R_SET
00EB29  2  8D 28 D3             sta ROP
00EB2C  2  20 07 EA             jsr setrect
00EB2F  2  A5 22                lda RX0
00EB31  2  8D 15 D3             sta BDX
00EB34  2  A5 23                lda RX0+1
00EB36  2  8D 1E D3             sta BDXH
00EB39  2  A5 24                lda RY0
00EB3B  2  8D 16 D3             sta BDY
00EB3E  2  A5 25                lda RY0+1
00EB40  2  8D 1F D3             sta BDYH
00EB43  2  20 8F EA             jsr clipfull
00EB46  2  A9 06                lda #C_COPY
00EB48  2  8D 18 D3             sta BCMD
00EB4B  2  A9 00                lda #0
00EB4D  2  8D 02 D3             sta DRAW
00EB50  2  60                   rts
00EB51  2               
00EB51  2               ; MX, MY = the mouse
00EB51  2               readmouse:
00EB51  2  AD 00 D5             lda MOUSEX
00EB54  2  85 46                sta MX
00EB56  2  AD 01 D5             lda MOUSEX+1
00EB59  2  85 47                sta MX+1
00EB5B  2  AD 02 D5             lda MOUSEY
00EB5E  2  85 48                sta MY
00EB60  2  AD 03 D5             lda MOUSEY+1
00EB63  2  85 49                sta MY+1
00EB65  2  60                   rts
00EB66  2               
00EB66  2               ; Carry set if MX,MY is inside RX0..RY1
00EB66  2               inrect:
00EB66  2  A5 46                lda MX                  ; MX >= RX0
00EB68  2  C5 22                cmp RX0
00EB6A  2  A5 47                lda MX+1
00EB6C  2  E5 23                sbc RX0+1
00EB6E  2  90 1C                bcc @no
00EB70  2  A5 26                lda RX1                 ; RX1 >= MX
00EB72  2  C5 46                cmp MX
00EB74  2  A5 27                lda RX1+1
00EB76  2  E5 47                sbc MX+1
00EB78  2  90 12                bcc @no
00EB7A  2  A5 48                lda MY
00EB7C  2  C5 24                cmp RY0
00EB7E  2  A5 49                lda MY+1
00EB80  2  E5 25                sbc RY0+1
00EB82  2  90 08                bcc @no
00EB84  2  A5 28                lda RY1
00EB86  2  C5 48                cmp MY
00EB88  2  A5 29                lda RY1+1
00EB8A  2  E5 49                sbc MY+1
00EB8C  2  60           @no:    rts                     ; carry = the last comparison
00EB8D  2               
00EB8D  2               ; Waits for the next frame
00EB8D  2               waitframe:
00EB8D  2  AD 01 D0             lda FRAME
00EB90  2  CD 01 D0     @w:     cmp FRAME
00EB93  2  F0 FB                beq @w
00EB95  2  60                   rts
00EB96  2               
00EB96  2               ; T0 = X position that centres A characters between RX0 and RX1:
00EB96  2               ; (RX0 + RX1) / 2 - A * 4
00EB96  2               centrex:
00EB96  2  85 43                sta TMPB
00EB98  2  A5 22                lda RX0
00EB9A  2  18                   clc
00EB9B  2  65 26                adc RX1
00EB9D  2  85 36                sta T0
00EB9F  2  A5 23                lda RX0+1
00EBA1  2  65 27                adc RX1+1
00EBA3  2  4A                   lsr
00EBA4  2  85 37                sta T0+1
00EBA6  2  66 36                ror T0
00EBA8  2  A9 00                lda #0
00EBAA  2  85 44                sta TMPC
00EBAC  2  A5 43                lda TMPB                ; A * 4 -> TMPC:TMPB
00EBAE  2  0A                   asl
00EBAF  2  26 44                rol TMPC
00EBB1  2  0A                   asl
00EBB2  2  26 44                rol TMPC
00EBB4  2  85 43                sta TMPB
00EBB6  2  A5 36                lda T0
00EBB8  2  38                   sec
00EBB9  2  E5 43                sbc TMPB
00EBBB  2  85 36                sta T0
00EBBD  2  A5 37                lda T0+1
00EBBF  2  E5 44                sbc TMPC
00EBC1  2  85 37                sta T0+1
00EBC3  2  60                   rts
00EBC4  2               
00EBC4  2               ; Port B = the caller's address T0: $E000-$EFFF is in the caller's bank
00EBC4  2               ; (CBANK), anything else in the fixed RAM
00EBC4  2               farptr:
00EBC4  2  A5 36                lda T0
00EBC6  2  8D 08 D2             sta PBADR
00EBC9  2  A5 37                lda T0+1
00EBCB  2  29 F0                and #$F0
00EBCD  2  C9 E0                cmp #$E0
00EBCF  2  D0 1B                bne @fixed
00EBD1  2  A5 37                lda T0+1
00EBD3  2  29 0F                and #$0F
00EBD5  2  85 3C                sta T3
00EBD7  2  A5 40                lda CBANK
00EBD9  2  0A                   asl
00EBDA  2  0A                   asl
00EBDB  2  0A                   asl
00EBDC  2  0A                   asl
00EBDD  2  05 3C                ora T3
00EBDF  2  8D 09 D2             sta PBADR+1
00EBE2  2  A5 40                lda CBANK
00EBE4  2  4A                   lsr
00EBE5  2  4A                   lsr
00EBE6  2  4A                   lsr
00EBE7  2  4A                   lsr
00EBE8  2  8D 0A D2             sta PBADR+2
00EBEB  2  60                   rts
00EBEC  2  A5 37        @fixed: lda T0+1
00EBEE  2  8D 09 D2             sta PBADR+1
00EBF1  2  A9 FF                lda #$FF
00EBF3  2  8D 0A D2             sta PBADR+2
00EBF6  2  60                   rts
00EBF7  2               
00EBF7  2               ; Copies the caller's string at T0 to QP (fixed RAM), at most A characters,
00EBF7  2               ; always ending with 0
00EBF7  2               fetchstr:
00EBF7  2  85 3D                sta T3+1
00EBF9  2  20 C4 EB             jsr farptr
00EBFC  2  A0 00                ldy #0
00EBFE  2  C4 3D        @l:     cpy T3+1
00EC00  2  F0 0A                beq @end
00EC02  2  AD 0B D2             lda PBDATA
00EC05  2  91 34                sta (QP),y
00EC07  2  F0 07                beq @done
00EC09  2  C8                   iny
00EC0A  2  D0 F2                bne @l
00EC0C  2  A9 00        @end:   lda #0
00EC0E  2  91 34                sta (QP),y
00EC10  2  60           @done:  rts
