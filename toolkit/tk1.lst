000000r 1               ;=============================================================================
000000r 1               ; tk1.asm - mini6502 desktop toolkit, bank $10: dispatcher, windows, events
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Public domain. Programs call it through far-call entry 16 ($CC88):
000000r 1               ;   LDA #function : JSR $CC88   (arguments in X, Y, r0-r5; see README.txt)
000000r 1               ;=============================================================================
000000r 1               
000000r 1                       .include "tk.inc"
000000r 2               ;=============================================================================
000000r 2               ; tk.inc - mini6502 desktop toolkit: shared definitions (both toolkit banks)
000000r 2               ;-----------------------------------------------------------------------------
000000r 2               ; Public domain. See README.txt for the programming interface.
000000r 2               ;=============================================================================
000000r 2               
000000r 2               TKBANK1 = $10           ; dispatcher, windows, events
000000r 2               TKBANK2 = $11           ; menus, dialogs
000000r 2               SWAPBANK = $D0          ; the caller's RAM ($0000-$CBFF) while the desktop runs
000000r 2               
000000r 2               ; --- function numbers (A when calling TOOL = $CC88) --------------------------
000000r 2               TK_INIT     = 0
000000r 2               TK_EXIT     = 1
000000r 2               TK_MENUBAR  = 2
000000r 2               TK_MENUITEM = 3
000000r 2               TK_OPENWIN  = 4
000000r 2               TK_CLOSEWIN = 5
000000r 2               TK_GETEVENT = 6
000000r 2               TK_POLLEVENT = 7
000000r 2               TK_SETPORT  = 8
000000r 2               TK_ALERT    = 9
000000r 2               TK_ASK      = 10
000000r 2               TK_TEXT     = 11
000000r 2               TK_INVAL    = 12
000000r 2               TK_FRONT    = 13
000000r 2               TK_CLEAR    = 14
000000r 2               TK_SETTITLE = 15
000000r 2               TK_DESKEVENTS = 16
000000r 2               TK_INVALRECT = 17
000000r 2               TK_LAST     = 17
000000r 2               
000000r 2               ; --- events (A after GETEVENT / POLLEVENT) ---------------------------------------
000000r 2               EV_NONE   = 0
000000r 2               EV_KEY    = 1           ; X = character (0: Y = KBDEXT code)
000000r 2               EV_MENU   = 2           ; X = menu, Y = item
000000r 2               EV_CLICK  = 3           ; X = window ($FF desktop), Y = buttons (+$80 double), r0/r1 = x/y
000000r 2               EV_UPDATE = 4           ; X = window: draw its contents (clip already set)
000000r 2               EV_CLOSE  = 5           ; X = window: its close box was clicked
000000r 2               EV_WHEEL  = 6           ; X = front window ($FF none), Y = steps (signed)
000000r 2               
000000r 2               ; --- hardware ------------------------------------------------------------------------
000000r 2               FRAME   = $D001
000000r 2               KBD     = $D010
000000r 2               KBDCR   = $D011
000000r 2               KBDEXT  = $D019
000000r 2               BANK    = $D020
000000r 2               DMASRC  = $D210         ; DMA: source, destination, length
000000r 2               DMACMD  = $D219
000000r 2               IRQEN   = $D007         ; interrupts wanted (see mini6502.bas)
000000r 2               IRQVEC  = $D00A         ; 2 bytes: the interrupt handler
000000r 2               PBADR   = $D208         ; port B (the toolkit's): address, data, step
000000r 2               PBDATA  = $D20B
000000r 2               PBSTEP  = $D20C
000000r 2               MODE    = $D300
000000r 2               SHOW    = $D301
000000r 2               DRAW    = $D302
000000r 2               BX0     = $D310
000000r 2               BY0     = $D311
000000r 2               BX1     = $D312
000000r 2               BY1     = $D313
000000r 2               BCOL    = $D314
000000r 2               BDX     = $D315
000000r 2               BDY     = $D316
000000r 2               BSRC    = $D317
000000r 2               BCMD    = $D318
000000r 2               BX0H    = $D31A
000000r 2               BY0H    = $D31B
000000r 2               BX1H    = $D31C
000000r 2               BY1H    = $D31D
000000r 2               BDXH    = $D31E
000000r 2               BDYH    = $D31F
000000r 2               ROP     = $D328
000000r 2               PATON   = $D329
000000r 2               STYLE   = $D32B
000000r 2               CHOUT   = $D32C
000000r 2               PATTERN = $D330
000000r 2               CLIPR   = $D338
000000r 2               MOUSEX  = $D500
000000r 2               MOUSEY  = $D502
000000r 2               BUTTONS = $D504
000000r 2               WHEEL   = $D505
000000r 2               CLICKS  = $D506
000000r 2               PTR     = $D508
000000r 2               
000000r 2               C_CLEAR = 1
000000r 2               C_LINE  = 3
000000r 2               C_BOX   = 4
000000r 2               C_BOXF  = 5
000000r 2               C_COPY  = 6
000000r 2               C_STAMP = 10
000000r 2               R_SET   = 0
000000r 2               R_XOR   = 3
000000r 2               R_INV   = 4
000000r 2               S_BOLD  = 1
000000r 2               S_UNDER = 2
000000r 2               S_INV   = 8
000000r 2               S_OPAQUE = 16
000000r 2               
000000r 2               ; --- zero page -----------------------------------------------------------------------
000000r 2               r0      = $02           ; r0-r15: arguments and results, 2 bytes each
000000r 2               r1      = $04
000000r 2               r2      = $06
000000r 2               r3      = $08
000000r 2               r4      = $0A
000000r 2               r5      = $0C
000000r 2               RX0     = $22           ; the rectangle the drawing helpers use
000000r 2               RY0     = $24
000000r 2               RX1     = $26
000000r 2               RY1     = $28
000000r 2               DX0     = $2A           ; damage rectangle (redraw pass)
000000r 2               DY0     = $2C
000000r 2               DX1     = $2E
000000r 2               DY1     = $30
000000r 2               TP      = $32           ; text pointer
000000r 2               QP      = $34           ; second pointer
000000r 2               T0      = $36           ; temporaries
000000r 2               T1      = $38
000000r 2               T2      = $3A
000000r 2               T3      = $3C
000000r 2               WP      = $3E           ; pointer to a window record
000000r 2               CBANK   = $40           ; the caller's bank (set by the dispatcher)
000000r 2               EVX     = $41           ; event being returned: X, Y
000000r 2               EVY     = $42
000000r 2               TMPB    = $43
000000r 2               TMPC    = $44
000000r 2               MX      = $46           ; mouse position, 2 bytes each
000000r 2               MY      = $48
000000r 2               NUMW    = $4A           ; number of windows open
000000r 2               FRONTW  = $4B           ; window in front ($FF none)
000000r 2               PASSON  = $4C           ; nonzero: a redraw pass is going on
000000r 2               PEND    = $4D           ; windows still to redraw (bit per window)
000000r 2               UPDW    = $4E           ; window of the UPDATE being drawn ($FF none)
000000r 2               NMENU   = $4F           ; menus in the bar
000000r 2               DAMAGE  = $50           ; nonzero: DX0..DY1 must be redrawn
000000r 2               DESKEV  = $51           ; nonzero: UPDATE events for the desktop (X = $FF)
000000r 2               DESKPEND = $52          ; the desktop's UPDATE is next in this pass
000000r 2               
000000r 2               ; --- fixed RAM ----------------------------------------------------------------------
000000r 2               WINREC  = $0200         ; 8 window records of 32 bytes
000000r 2               W_USED  = 0             ;  1 if open
000000r 2               W_X0    = 1             ;  outer rectangle (the shadow is 2 more right/down)
000000r 2               W_Y0    = 3
000000r 2               W_X1    = 5
000000r 2               W_Y1    = 7
000000r 2               W_TITLE = 9             ;  title, up to 22 characters + 0
000000r 2               ZORDER  = $0300         ; window numbers, back to front (NUMW of them)
000000r 2               MTL     = $0308         ; menu: title address, low / high (8 + 8)
000000r 2               MTH     = $0310
000000r 2               MFIRST  = $0318         ; menu: first item number (8)
000000r 2               MCOUNT  = $0320         ; menu: number of items (8)
000000r 2               MXL     = $0328         ; menu: title x position, low / high (8 + 8)
000000r 2               MXH     = $0330
000000r 2               MWIDTH  = $0338         ; menu: width of its box in characters (8)
000000r 2               IPL     = $0340         ; item: text address, low / high (64 + 64)
000000r 2               IPH     = $0380
000000r 2               IFLAG   = $03C0         ; item: 1 enabled, 2 separator (64)
000000r 2               IKEY    = $0400         ; item: Ctrl+key shortcut letter, 0 none (64)
000000r 2               MTEXT   = $0480         ; menu texts
000000r 2               MTEXTEND = $07FE
000000r 2               MAGIC   = $07FE         ; "TK" while a toolkit program runs
000000r 2               STRBUF  = $C000         ; strings copied from the caller (dialogs)
000000r 2               STRBUF2 = $C100
000000r 2               ASKBUF  = $C200
000000r 2               
000000r 2               MAXWIN  = 8
000000r 2               MAXMENU = 8
000000r 2               MAXITEM = 64
000000r 2               TITLEH  = 19            ; window title bar: rows y0..y0+18, line at y0+19
000000r 2               MENUH   = 19            ; menu bar: rows 0..18, line at 19
000000r 2               
000000r 2               ; --- helpers ---------------------------------------------------------------------------
000000r 2               .macro  LDW dst, val            ; dst = 16-bit constant
000000r 2                       lda #<(val)
000000r 2                       sta dst
000000r 2                       lda #>(val)
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  MOVW dst, src           ; dst = src (16-bit)
000000r 2                       lda src
000000r 2                       sta dst
000000r 2                       lda src+1
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  ADDW dst, src, val      ; dst = src + constant
000000r 2                       lda src
000000r 2                       clc
000000r 2                       adc #<(val)
000000r 2                       sta dst
000000r 2                       lda src+1
000000r 2                       adc #>(val)
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  SUBW dst, src, val      ; dst = src - constant
000000r 2                       lda src
000000r 2                       sec
000000r 2                       sbc #<(val)
000000r 2                       sta dst
000000r 2                       lda src+1
000000r 2                       sbc #>(val)
000000r 2                       sta dst+1
000000r 2               .endmacro
000000r 2               .macro  FAR bank, addr          ; call into another bank: returns to whoever
000000r 2                                               ; called the routine this is in (use it as
000000r 2                                               ; the whole body of a routine called by JSR)
000000r 2                       jsr $FFD0
000000r 2                       .byte bank
000000r 2                       .word addr
000000r 2               .endmacro
000000r 2               
000000r 1               
000000r 1               ; bank 2's entry points (tk2.asm)
000000r 1               M_SETBAR = $E000
000000r 1               M_ITEM   = $E003
000000r 1               M_TRACK  = $E006
000000r 1               M_KEY    = $E009
000000r 1               D_ALERT  = $E00C
000000r 1               D_ASK    = $E00F
000000r 1               
000000r 1               ; this bank's own variables (not in the swapped RAM)
000000r 1               EXITBUF = $EFF0         ; 5 bytes of TK_EXIT's stack frame
000000r 1               EXITSP  = $EFF5
000000r 1               LEVEL   = $EFF6         ; INITs not yet EXITed (programs started from others)
000000r 1               SAVEIRQ = $EFF7         ; the caller's IRQEN, when its handler is in its RAM
000000r 1               
000000r 1                       .org $E000
00E000  1               
00E000  1               ; --- dispatcher -------------------------------------------------------------------
00E000  1               dispatch:
00E000  1  D8                   cld
00E001  1  8E 4A E0             stx ARGX
00E004  1  8C 4B E0             sty ARGY
00E007  1  48                   pha
00E008  1  BA                   tsx
00E009  1  BD 04 01             lda $0104,x             ; FARCALL left the caller's bank under its
00E00C  1  85 40                sta CBANK               ; return address (after our PHA: +4)
00E00E  1  68                   pla
00E00F  1  C9 12                cmp #TK_LAST + 1
00E011  1  B0 11                bcs @bad
00E013  1  0A                   asl
00E014  1  AA                   tax
00E015  1  BD 27 E0             lda functab+1,x
00E018  1  48                   pha
00E019  1  BD 26 E0             lda functab,x
00E01C  1  48                   pha
00E01D  1  AE 4A E0             ldx ARGX
00E020  1  AC 4B E0             ldy ARGY
00E023  1  60                   rts                     ; to the function; its RTS returns to the caller
00E024  1  38           @bad:   sec
00E025  1  60                   rts
00E026  1               
00E026  1               functab:
00E026  1  4B E0 4A E1          .word f_init-1, f_exit-1, f_menubar-1, f_menuitem-1
00E02A  1  3B E2 41 E2  
00E02E  1  41 E3 E9 E3          .word f_openwin-1, f_closewin-1, f_getevent-1, f_pollevent-1
00E032  1  0C E6 18 E6  
00E036  1  72 E4 47 E2          .word f_setport-1, f_alert-1, f_ask-1, f_text-1
00E03A  1  4D E2 5F E2  
00E03E  1  66 E4 3F E4          .word f_inval-1, f_front-1, f_clear-1, f_settitle-1
00E042  1  CF E1 D7 E1  
00E046  1  04 E2 2D E2          .word f_deskev-1, f_invalrect-1
00E04A  1               
00E04A  1  00           ARGX:   .byte 0
00E04B  1  00           ARGY:   .byte 0
00E04C  1               
00E04C  1               ; --- INIT: the desktop takes the machine -------------------------------------------
00E04C  1               f_init:
00E04C  1  AD F6 EF             lda LEVEL               ; started from another toolkit program (the
00E04F  1  F0 14                beq @first              ; toolkit's mark is in the RAM): its RAM is
00E051  1  AD FE 07             lda MAGIC               ; already saved
00E054  1  C9 54                cmp #'T'
00E056  1  D0 0D                bne @first
00E058  1  AD FF 07             lda MAGIC+1
00E05B  1  C9 4B                cmp #'K'
00E05D  1  D0 06                bne @first
00E05F  1  EE F6 EF             inc LEVEL
00E062  1  4C B1 E0             jmp initscr
00E065  1  A9 01        @first: lda #1
00E067  1  8D F6 EF             sta LEVEL
00E06A  1  A9 00                lda #0                  ; an interrupt handler in the caller's RAM
00E06C  1  8D F7 EF             sta SAVEIRQ             ; ($0000-$DFFF) is about to be swapped out:
00E06F  1  AD 0B D0             lda IRQVEC+1            ; turned off until EXIT (one in a bank keeps
00E072  1  C9 E0                cmp #$E0                ; running: background music...)
00E074  1  B0 0B                bcs @irqok
00E076  1  AD 07 D0             lda IRQEN
00E079  1  8D F7 EF             sta SAVEIRQ
00E07C  1  A9 00                lda #0
00E07E  1  8D 07 D0             sta IRQEN
00E081  1               @irqok:
00E081  1  A9 00                lda #$00                ; the caller's RAM $0000-$CBFF -> banks $D0-$DC
00E083  1  8D 10 D2             sta DMASRC
00E086  1  8D 11 D2             sta DMASRC+1
00E089  1  A9 FF                lda #$FF
00E08B  1  8D 12 D2             sta DMASRC+2
00E08E  1  A9 00                lda #$00
00E090  1  8D 13 D2             sta DMASRC+3
00E093  1  A9 00                lda #(SWAPBANK << 4) & $FF
00E095  1  8D 14 D2             sta DMASRC+4
00E098  1  A9 0D                lda #SWAPBANK >> 4
00E09A  1  8D 15 D2             sta DMASRC+5
00E09D  1  A9 00                lda #$00
00E09F  1  8D 16 D2             sta DMASRC+6
00E0A2  1  A9 CC                lda #$CC
00E0A4  1  8D 17 D2             sta DMASRC+7
00E0A7  1  A9 00                lda #0
00E0A9  1  8D 18 D2             sta DMASRC+8
00E0AC  1  A9 01                lda #1
00E0AE  1  8D 19 D2             sta DMACMD
00E0B1  1               initscr:
00E0B1  1  A5 40                lda CBANK               ; (kept: the clearing below would lose it)
00E0B3  1  48                   pha
00E0B4  1  A2 22                ldx #$22                ; toolkit zero page and RAM cleared
00E0B6  1  A9 00                lda #0
00E0B8  1  95 00        @z:     sta 0,x
00E0BA  1  E8                   inx
00E0BB  1  E0 80                cpx #$80
00E0BD  1  D0 F9                bne @z
00E0BF  1  AA                   tax
00E0C0  1  9D 00 02     @r:     sta WINREC,x
00E0C3  1  9D 00 03             sta WINREC+$100,x
00E0C6  1  E8                   inx
00E0C7  1  D0 F7                bne @r
00E0C9  1  68                   pla
00E0CA  1  85 40                sta CBANK
00E0CC  1  A9 54                lda #'T'                ; the mark: a toolkit program is running
00E0CE  1  8D FE 07             sta MAGIC
00E0D1  1  A9 4B                lda #'K'
00E0D3  1  8D FF 07             sta MAGIC+1
00E0D6  1  A9 FF                lda #$FF
00E0D8  1  85 4B                sta FRONTW
00E0DA  1  85 4E                sta UPDW
00E0DC  1  A9 01                lda #1
00E0DE  1  8D 0C D2             sta PBSTEP
00E0E1  1  A9 03                lda #3                  ; hires, black on white
00E0E3  1  8D 00 D3             sta MODE
00E0E6  1  A9 00                lda #0
00E0E8  1  8D 01 D3             sta SHOW
00E0EB  1  8D 02 D3             sta DRAW
00E0EE  1  8D 2B D3             sta STYLE
00E0F1  1  8D 06 D3             sta $D306               ; INK black
00E0F4  1  A9 0F                lda #15
00E0F6  1  8D 07 D3             sta $D307               ; PAPER white
00E0F9  1  20 8F EA             jsr clipfull
00E0FC  1  20 EA EA             jsr patgrey             ; grey desktop over the whole page
00E0FF  1  A9 00                lda #R_SET
00E101  1  8D 28 D3             sta ROP
00E104  1  A9 01                lda #1
00E106  1  8D 29 D3             sta PATON
00E109  1  A9 01                lda #C_CLEAR
00E10B  1  8D 18 D3             sta BCMD
00E10E  1  A9 00                lda #0
00E110  1  8D 29 D3             sta PATON
00E113  1  20 23 E1             jsr menubg
00E116  1  A9 03                lda #3                  ; the pointer, following the mouse
00E118  1  8D 08 D5             sta PTR
00E11B  1  AD 06 D5             lda CLICKS              ; forget old clicks and wheel turns
00E11E  1  AD 05 D5             lda WHEEL
00E121  1  18                   clc
00E122  1  60                   rts
00E123  1               
00E123  1               ; The empty menu bar
00E123  1  A9 00        menubg: lda #0
00E125  1  85 22                sta RX0
00E127  1  85 23                sta RX0+1
00E129  1  85 24                sta RY0
00E12B  1  85 25                sta RY0+1
00E12D  1  85 29                sta RY1+1
00E12F  1  A9 7F 85 26          LDW RX1, 639
00E133  1  A9 02 85 27  
00E137  1  A9 12                lda #MENUH - 1
00E139  1  85 28                sta RY1
00E13B  1  A9 00                lda #0
00E13D  1  20 30 EA             jsr fillrect
00E140  1  A9 13                lda #MENUH
00E142  1  85 24                sta RY0
00E144  1  85 28                sta RY1
00E146  1  A9 01                lda #1
00E148  1  4C 30 EA             jmp fillrect
00E14B  1               
00E14B  1               ; --- EXIT: everything back as before INIT; returns to the caller ----------------
00E14B  1               f_exit:
00E14B  1  AD F6 EF             lda LEVEL               ; inside another toolkit program: back to it
00E14E  1  C9 02                cmp #2                  ; (it draws its screen again: CLEAR...)
00E150  1  90 05                bcc @last
00E152  1  CE F6 EF             dec LEVEL
00E155  1  18                   clc
00E156  1  60                   rts
00E157  1  A9 00        @last:  lda #0
00E159  1  8D F6 EF             sta LEVEL
00E15C  1  BA                   tsx                     ; our return frame (FARCALL's return, bank,
00E15D  1  8E F5 EF             stx EXITSP              ; the caller's return): kept in this bank
00E160  1  A0 00                ldy #0
00E162  1  BD 01 01     @s:     lda $0101,x
00E165  1  99 F0 EF             sta EXITBUF,y
00E168  1  E8                   inx
00E169  1  C8                   iny
00E16A  1  C0 05                cpy #5
00E16C  1  D0 F4                bne @s
00E16E  1  A9 00                lda #0
00E170  1  8D 08 D5             sta PTR
00E173  1  8D 00 D3             sta MODE
00E176  1  8D 28 D3             sta ROP
00E179  1  8D 29 D3             sta PATON
00E17C  1  8D 2B D3             sta STYLE
00E17F  1  20 8F EA             jsr clipfull
00E182  1  A9 00                lda #(SWAPBANK << 4) & $FF   ; banks $D0-$DC -> $0000-$CBFF
00E184  1  8D 11 D2             sta DMASRC+1
00E187  1  A9 0D                lda #SWAPBANK >> 4
00E189  1  8D 12 D2             sta DMASRC+2
00E18C  1  A9 00                lda #0
00E18E  1  8D 10 D2             sta DMASRC
00E191  1  8D 13 D2             sta DMASRC+3
00E194  1  8D 14 D2             sta DMASRC+4
00E197  1  8D 16 D2             sta DMASRC+6
00E19A  1  8D 18 D2             sta DMASRC+8
00E19D  1  A9 FF                lda #$FF
00E19F  1  8D 15 D2             sta DMASRC+5
00E1A2  1  A9 CC                lda #$CC
00E1A4  1  8D 17 D2             sta DMASRC+7
00E1A7  1  A9 01                lda #1
00E1A9  1  8D 19 D2             sta DMACMD
00E1AC  1  AD 0B D0             lda IRQVEC+1            ; a handler in the RAM: the caller's again
00E1AF  1  C9 E0                cmp #$E0                ; (or one left by a program: off)
00E1B1  1  B0 06                bcs @irqok
00E1B3  1  AD F7 EF             lda SAVEIRQ
00E1B6  1  8D 07 D0             sta IRQEN
00E1B9  1  AE F5 EF     @irqok: ldx EXITSP              ; our frame back on the (restored) stack
00E1BC  1  A0 00                ldy #0
00E1BE  1  B9 F0 EF     @b:     lda EXITBUF,y
00E1C1  1  9D 01 01             sta $0101,x
00E1C4  1  E8                   inx
00E1C5  1  C8                   iny
00E1C6  1  C0 05                cpy #5
00E1C8  1  D0 F4                bne @b
00E1CA  1  AE F5 EF             ldx EXITSP
00E1CD  1  9A                   txs
00E1CE  1  18                   clc
00E1CF  1  60                   rts
00E1D0  1               
00E1D0  1               ; --- CLEAR: as INIT, for the outermost program after one it started -------
00E1D0  1               f_clear:
00E1D0  1  A9 01                lda #1
00E1D2  1  8D F6 EF             sta LEVEL
00E1D5  1  4C B1 E0             jmp initscr
00E1D8  1               
00E1D8  1               ; --- SETTITLE: window X's title = r0 -------------------------------------------------
00E1D8  1               f_settitle:
00E1D8  1  E0 08                cpx #MAXWIN
00E1DA  1  B0 27                bcs @r
00E1DC  1  86 43                stx TMPB
00E1DE  1  20 77 E2             jsr winptr
00E1E1  1  A5 02 85 36          MOVW T0, r0
00E1E5  1  A5 03 85 37  
00E1E9  1  A5 3E                lda WP
00E1EB  1  18                   clc
00E1EC  1  69 09                adc #W_TITLE
00E1EE  1  85 34                sta QP
00E1F0  1  A5 3F                lda WP+1
00E1F2  1  69 00                adc #0
00E1F4  1  85 35                sta QP+1
00E1F6  1  A9 16                lda #22
00E1F8  1  20 F7 EB             jsr fetchstr
