000D7Er 1               .segment "WOZ_RESET"            ; $FF00
000000r 1  4C rr rr             jmp reset
000003r 1               .segment "WOZ_GETLINE"          ; $FF1F
000000r 1  4C rr rr             jmp monitor
000003r 1               .segment "SYSCALLS"             ; $FFB0
000000r 1  4C rr rr             jmp balloc              ; $FFB0
000003r 1  4C rr rr             jmp bfree               ; $FFB3
