000000r 1               ;=============================================================================
000000r 1               ; monitor.asm - the mini6502 system monitor                    (ROM $F000-$FFFF)
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Public domain. An original monitor for mini6502, written to feel like the
000000r 1               ; Woz Monitor (same commands, same entry points) while leaving 4K to grow in.
000000r 1               ;
000000r 1               ; Build (cc65 suite):  ca65 monitor.asm -o monitor.o -l monitor.lst
000000r 1               ;                      ld65 -C monitor.cfg monitor.o -o monitor.bin
000000r 1               ;
000000r 1               ; Commands (several per line, separated by spaces; hex, upper or lower case)
000000r 1               ;   HHHH            show the byte at HHHH
000000r 1               ;   HHHH.HHHH       show a range, 8 bytes per line
000000r 1               ;   .HHHH           continue showing from the last address up to HHHH
000000r 1               ;   HHHH: BB BB ..  store bytes from HHHH on (shows the old byte at HHHH,
000000r 1               ;                   except for I/O addresses $Dxxx, where reading can have
000000r 1               ;                   an effect: a data port moves on, KBD takes the key);
000000r 1               ;                   a 3-4 digit number starts a new address: D020: 05 D021: 1E
000000r 1               ;   : BB BB ..      store at the last address shown, or after the last byte stored
000000r 1               ;   HHHH R          run the program at HHHH; an RTS comes back to the monitor
000000r 1               ;   R               run again at the last address shown
000000r 1               ;   S NAME HHHH.HHHH  save HHHH..HHHH (end included) to the file NAME
000000r 1               ;   S NAME HHHH.HHHH BB   ... with bank BB at $E000-$EFFF while saving
000000r 1               ;   L NAME          load NAME at the address it was saved from
000000r 1               ;   L NAME HHHH     load NAME at HHHH
000000r 1               ;   L NAME HHHH BB  load NAME at HHHH with bank BB at $E000-$EFFF
000000r 1               ;                   (the bank selected before is selected again afterwards)
000000r 1               ;   V               list the far-call vector table at $CC00
000000r 1               ;   V NN BB HHHH [NAME]  set entry NN (00-27): a call to it runs HHHH in
000000r 1               ;                   bank BB; NAME (up to 8 characters) is what VFIND finds
000000r 1               ;   M               list the bank map: who owns each bank
000000r 1               ;   M BB OO         set bank BB's owner to OO (00 = free it)
000000r 1               ;                   after a load, R runs what was loaded
000000r 1               ;   $               list the files on the disk
000000r 1               ;   K NAME          delete (kill) the file NAME
000000r 1               ;   T NAME          type the text file NAME as if typed on the keyboard: a
000000r 1               ;                   script of monitor commands, which can go on into what
000000r 1               ;                   it starts (BASIC lines after A000R, for instance)
000000r 1               ;   W               wipe: clear the screen (C would be read as hex)
000000r 1               ;   X               exit: quits the mini6502 emulator
000000r 1               ;   G               go back to the program that set the warm start address
000000r 1               ;                   ($D002/$D003, e.g. BASIC after SYSTEM or F1)
000000r 1               ;   ?               short help
000000r 1               ;   Esc cancels the line, Backspace/Delete erase, Enter executes.
000000r 1               ;   S, L and $ use the rest of the line. Files are in the "disk" folder next
000000r 1               ;   to mini6502; names are up to 64 of A-Z 0-9 . _ - (typed in upper case).
000000r 1               ;
000000r 1               ; Boot: at power-on (and after a $FF cold reset, not after F1) the monitor
000000r 1               ; loads the disk file BOOT at its own address and runs it, unless keys are
000000r 1               ; already waiting (a file typed in from the command line, for instance).
000000r 1               ; Without a BOOT file it types BOOT.TXT, if there is one, as a script.
000000r 1               ; Save anything as BOOT to start it automatically, e.g. BASIC:
000000r 1               ;   L EHBASIC     then     S BOOT A000.CA3C
000000r 1               ; If there is no BOOT file the monitor just shows its prompt.
000000r 1               ;
000000r 1               ; Far calls into banked RAM ($E000-$EFFF, 256 banks of 4K)
000000r 1               ;   FARCALL $FFD0 switches to a bank, calls an address there, then switches
000000r 1               ;   back to the caller's bank. It takes its target from the 3 bytes after
000000r 1               ;   the JSR, so a far call is   JSR $FFD0 / .byte bank / .word address.
000000r 1               ;   A, X and Y reach the callee unchanged; on return A, X, Y and the carry
000000r 1               ;   are what the callee left. Calls can nest (banked code can far-call too).
000000r 1               ;   Uses $E2-$E5 and $EE of the zero page (left free by EhBASIC).
000000r 1               ;
000000r 1               ;   The system page $CC00-$CFFF (fixed RAM nothing swaps out; see
000000r 1               ;   hw/REGISTERS.txt):
000000r 1               ;     $CC00  "VT"     signature (written by V)
000000r 1               ;     $CC02  count    number of entries in use
000000r 1               ;     $CC03-$CC07     reserved
000000r 1               ;     $CC08 + 8*NN    entry NN (00-27): JSR $FFD0 / bank / address / 2 spare
000000r 1               ;     $CD48 + 8*NN    entry NN's name (up to 8 characters, 0 after)
000000r 1               ;     $CE88-$CE8F     the system calls' own variables
000000r 1               ;     $CF00 + BB      the bank map: bank BB's owner (00 free, FD a main-RAM
000000r 1               ;                     program, FE loaded by hand, FF system, else a bank)
000000r 1               ;   At a cold start the monitor sets the map (banks $00-$1F and $C0-$FF
000000r 1               ;   reserved, the rest free); L NAME HHHH BB marks a free bank FE.
000000r 1               ;
000000r 1               ; System calls ($FFB0-$FFC1, JSR from anywhere; not from interrupt
000000r 1               ; handlers): BALLOC $FFB0 (A owner, X count, Y 0 programs / 1 documents
000000r 1               ; zone: A = first bank, carry set if no room), BFREE $FFB3 (A bank),
000000r 1               ; BFREEALL $FFB6 (A owner), BCLAIM $FFB9 (A owner, X bank: carry set if
000000r 1               ; someone else has it), VFIND $FFBC (X/Y name: A entry, X/Y its address,
000000r 1               ; carry set if none), BOWNER $FFBF (A bank: A owner).
000000r 1               ;   Entry NN is called with JSR $CC08+8*NN, or from BASIC with
000000r 1               ;   CALL 52232+8*NN. Save the table with S VECTORS CC00.CEFF.
000000r 1               ;
000000r 1               ; A BRK instruction stops the program and shows where it stopped and the
000000r 1               ; registers; the monitor's last address is then set to the BRK.
000000r 1               ;
000000r 1               ; Interrupts (IRQ, see IRQEN at $D007 in mini6502.bas): the monitor saves A,
000000r 1               ; X, Y and BANK on the stack, clears D, selects IRQBANK, reads IRQFLAGS into
000000r 1               ; A (which sources fired; reading also releases the IRQ) and JSRs to the
000000r 1               ; address in IRQVEC. The handler may use A, X and Y and ends with RTS; the
000000r 1               ; monitor then puts the bank and the registers back and returns (RTI).
000000r 1               ; To use them: set IRQVEC and IRQBANK, then IRQEN, then CLI.
000000r 1               ;
000000r 1               ; Entry points kept at the Woz Monitor's addresses, so programs written for
000000r 1               ; it keep working:
000000r 1               ;   $FF00 RESET    $FF1F GETLINE (monitor prompt)
000000r 1               ;   $FFDC PRBYTE   $FFE5 PRHEX   $FFEF ECHO (A preserved)
000000r 1               ; and one of its own:
000000r 1               ;   $FFD0 FARCALL (see above)
000000r 1               ;
000000r 1               ; Memory used: $E6-$ED zero page (left free by EhBASIC, so BASIC and the
000000r 1               ;              monitor can be used in turn), $0200-$027F input line,
000000r 1               ;              $0280-$028D monitor variables.
000000r 1               ;=============================================================================
000000r 1               
000000r 1               ; --- mini6502 I/O --------------------------------------------------------------
000000r 1               
000000r 1               ; --- memory --------------------------------------------------------------------
000000r 1                       .include "mini6502.inc"     ; the registers (hw/mini6502.inc)
000000r 2               ; mini6502.inc - made by hw/gen.py from hw/mini6502.def: edit that, not this.
000000r 2               ; The mini6502's registers, banks, far-call entries and system calls.
000000r 2               ; In a program: .include "mini6502.inc" (ca65 -I path/to/hw). Including it
000000r 2               ; twice is fine.
000000r 2               
000000r 2               .ifndef MINI6502_INC
000000r 2               MINI6502_INC = 1
000000r 2               
