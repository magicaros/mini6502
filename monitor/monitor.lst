0003A6r 1  20 rr rr             jsr skipsp
0003A9r 1  20 rr rr             jsr gethex
0003ACr 1  B0 03                bcs *+5
0003AEr 1  4C rr rr             jmp @badp
0003B1r 1  A5 EC                lda VAL
0003B3r 1  8D 8C 02             sta VADR
