000327r 1  D0 0D                bne @go
000329r 1  20 rr rr             jsr newline
00032Cr 1  A9 rr A2 rr          PRINT s_nowarm
000330r 1  20 rr rr     
000333r 1  4C rr rr             jmp monitor
