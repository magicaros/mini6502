000608r 1               
000608r 1               ; --- system calls (through the jump table at $FFB0) ------------------------------
000608r 1               SCOWN   = $CE88                 ; their variables, in the system page
000608r 1               SCCNT   = $CE89
000608r 1               SCEND   = $CE8A
000608r 1               SCFIRST = $CE8B
000608r 1               SCN     = $CE8C
000608r 1               
000608r 1               ; A = owner, X = count, Y = zone (0 programs, 1 documents): A = first bank
000608r 1  8D 88 CE     balloc: sta SCOWN
00060Br 1  8E 89 CE             stx SCCNT
00060Er 1  C9 00                cmp #OWN_FREE           ; (an owner, and at least one bank)
000610r 1  F0 40                beq @fail
000612r 1  E0 00                cpx #0
000614r 1  F0 3C                beq @fail
000616r 1  A2 20                ldx #Z_PROGRAMS
000618r 1  A9 80                lda #Z_PROGRAMS_END + 1
00061Ar 1  C0 00                cpy #0
00061Cr 1  F0 04                beq @z
00061Er 1  A2 80                ldx #Z_DOCUMENTS
000620r 1  A9 C0                lda #Z_DOCUMENTS_END + 1
000622r 1  8D 8A CE     @z:     sta SCEND
000625r 1  8E 8B CE     @try:   stx SCFIRST             ; a run of SCCNT free banks from here?
000628r 1  AC 89 CE             ldy SCCNT
00062Br 1  EC 8A CE     @chk:   cpx SCEND
00062Er 1  B0 22                bcs @fail
000630r 1  BD 00 CF             lda BANKMAP,x
000633r 1  D0 19                bne @next
000635r 1  E8                   inx
000636r 1  88                   dey
000637r 1  D0 F2                bne @chk
000639r 1  AE 8B CE             ldx SCFIRST             ; yes: they are the owner's
00063Cr 1  AC 89 CE             ldy SCCNT
00063Fr 1  AD 88 CE             lda SCOWN
000642r 1  9D 00 CF     @mk:    sta BANKMAP,x
000645r 1  E8                   inx
000646r 1  88                   dey
000647r 1  D0 F9                bne @mk
000649r 1  AD 8B CE             lda SCFIRST
00064Cr 1  18                   clc
00064Dr 1  60                   rts
00064Er 1  E8           @next:  inx                     ; a used bank: try after it
00064Fr 1  4C rr rr             jmp @try
000652r 1  38           @fail:  sec
000653r 1  60                   rts
000654r 1               
000654r 1               ; A = bank: free (not a system bank)
000654r 1  AA           bfree:  tax
000655r 1  BD 00 CF             lda BANKMAP,x
000658r 1  C9 FF                cmp #OWN_SYSTEM
00065Ar 1  F0 07                beq @no
00065Cr 1  A9 00                lda #OWN_FREE
00065Er 1  9D 00 CF             sta BANKMAP,x
000661r 1  18                   clc
000662r 1  60                   rts
000663r 1  38           @no:    sec
000664r 1  60                   rts
000665r 1               
000665r 1               ; A = owner: all its banks free
000665r 1               bfreeall:
000665r 1  C9 00                cmp #OWN_FREE
000667r 1  F0 19                beq @r
000669r 1  C9 FF                cmp #OWN_SYSTEM
00066Br 1  F0 15                beq @r
00066Dr 1  8D 88 CE             sta SCOWN
000670r 1  A2 00                ldx #0
000672r 1  BD 00 CF     @l:     lda BANKMAP,x
000675r 1  CD 88 CE             cmp SCOWN
000678r 1  D0 05                bne @n
00067Ar 1  A9 00                lda #OWN_FREE
00067Cr 1  9D 00 CF             sta BANKMAP,x
00067Fr 1  E8           @n:     inx
000680r 1  D0 F0                bne @l
000682r 1  18           @r:     clc
000683r 1  60                   rts
000684r 1               
000684r 1               ; A = owner, X = bank: the owner's, unless someone else has it (carry set)
000684r 1  8D 88 CE     bclaim: sta SCOWN
000687r 1  BD 00 CF             lda BANKMAP,x
00068Ar 1  F0 07                beq @take
00068Cr 1  CD 88 CE             cmp SCOWN
00068Fr 1  F0 02                beq @take
000691r 1  38                   sec
000692r 1  60                   rts
000693r 1  AD 88 CE     @take:  lda SCOWN
000696r 1  9D 00 CF             sta BANKMAP,x
000699r 1  18                   clc
00069Ar 1  60                   rts
00069Br 1               
00069Br 1               ; A = bank: A = its owner
00069Br 1  AA           bowner: tax
00069Cr 1  BD 00 CF             lda BANKMAP,x
00069Fr 1  18                   clc
0006A0r 1  60                   rts
0006A1r 1               
0006A1r 1               ; X/Y = a name: A = its far-call entry, X/Y = the entry's address
0006A1r 1  A5 E6        vfind:  lda SPTR                ; (the monitor's pointer, put back after)
0006A3r 1  48                   pha
0006A4r 1  A5 E7                lda SPTR+1
0006A6r 1  48                   pha
0006A7r 1  86 E6                stx SPTR
0006A9r 1  84 E7                sty SPTR+1
0006ABr 1  A0 00                ldy #0                  ; an empty name finds nothing
0006ADr 1  B1 E6                lda (SPTR),y
0006AFr 1  C9 21                cmp #' '+1
0006B1r 1  B0 03                bcs *+5
0006B3r 1  4C rr rr             jmp @fail
0006B6r 1  A9 00                lda #0
0006B8r 1  8D 8C CE             sta SCN
0006BBr 1  AD 8C CE     @ent:   lda SCN                 ; X = the name's offset in its 256-byte half
0006BEr 1  0A                   asl
0006BFr 1  0A                   asl
0006C0r 1  0A                   asl
0006C1r 1  AA                   tax
0006C2r 1  A9 00                lda #0
0006C4r 1  8D 8A CE             sta SCEND               ; 1 once the name has ended
0006C7r 1  A8                   tay
0006C8r 1  AD 8A CE     @ch:    lda SCEND
0006CBr 1  D0 15                bne @zero
0006CDr 1  B1 E6                lda (SPTR),y
0006CFr 1  C9 61                cmp #'a'
0006D1r 1  90 06                bcc @up
0006D3r 1  C9 7B                cmp #'z'+1
0006D5r 1  B0 02                bcs @up
0006D7r 1  29 DF                and #$DF
0006D9r 1  C9 21        @up:    cmp #' '+1
0006DBr 1  B0 07                bcs @have
0006DDr 1  A9 01                lda #1
0006DFr 1  8D 8A CE             sta SCEND
0006E2r 1  A9 00        @zero:  lda #0
0006E4r 1  8D 89 CE     @have:  sta SCCNT
0006E7r 1  AD 8C CE             lda SCN
0006EAr 1  C9 20                cmp #32
0006ECr 1  B0 06                bcs @hi
0006EEr 1  BD 48 CD             lda VTNAMES,x
0006F1r 1  4C rr rr             jmp @cmp
0006F4r 1  BD 48 CE     @hi:    lda VTNAMES+256,x
0006F7r 1  CD 89 CE     @cmp:   cmp SCCNT
0006FAr 1  D0 3F                bne @miss
0006FCr 1  E8                   inx
0006FDr 1  C8                   iny
0006FEr 1  C0 08                cpy #8
000700r 1  D0 C6                bne @ch
000702r 1  AD 8C CE             lda SCN                 ; found: X/Y = VTENTRY + 8 * entry
000705r 1  8D 8B CE             sta SCFIRST
000708r 1  A9 00                lda #0
00070Ar 1  8D 89 CE             sta SCCNT
00070Dr 1  AD 8C CE             lda SCN
000710r 1  0A                   asl
000711r 1  2E 89 CE             rol SCCNT
000714r 1  0A                   asl
000715r 1  2E 89 CE             rol SCCNT
000718r 1  0A                   asl
000719r 1  2E 89 CE             rol SCCNT
00071Cr 1  18                   clc
00071Dr 1  69 08                adc #<VTENTRY
00071Fr 1  8D 88 CE             sta SCOWN
000722r 1  AD 89 CE             lda SCCNT
000725r 1  69 CC                adc #>VTENTRY
000727r 1  8D 89 CE             sta SCCNT
00072Ar 1  68                   pla
00072Br 1  85 E7                sta SPTR+1
00072Dr 1  68                   pla
00072Er 1  85 E6                sta SPTR
000730r 1  AE 88 CE             ldx SCOWN
000733r 1  AC 89 CE             ldy SCCNT
000736r 1  AD 8B CE             lda SCFIRST
000739r 1  18                   clc
00073Ar 1  60                   rts
00073Br 1  EE 8C CE     @miss:  inc SCN
00073Er 1  AD 8C CE             lda SCN
000741r 1  C9 28                cmp #VTMAX
000743r 1  B0 03                bcs *+5
000745r 1  4C rr rr             jmp @ent
000748r 1  68           @fail:  pla
000749r 1  85 E7                sta SPTR+1
00074Br 1  68                   pla
00074Cr 1  85 E6                sta SPTR
00074Er 1  38                   sec
00074Fr 1  60                   rts
000750r 1               
000750r 1               ; --- far call --------------------------------------------------------------------
000750r 1               
000750r 1               ; JSR farcall / .byte bank / .word address  (entered through $FFD0)
000750r 1               ; Switches to the bank, calls the address with A, X, Y as they were, then
000750r 1               ; switches back to the caller's bank and returns after the 3 inline bytes'
000750r 1               ; owner (a vector table entry returns straight to whoever called the entry).
000750r 1               farcall:
000750r 1  85 E4                sta FA
000752r 1  86 EE                stx FX
000754r 1  84 E5                sty FY
000756r 1  68                   pla                     ; return address = last byte of the JSR
000757r 1  85 E2                sta FP
000759r 1  68                   pla
00075Ar 1  85 E3                sta FP+1
00075Cr 1  AD 20 D0             lda BANK                ; the caller's bank, for farret
00075Fr 1  48                   pha
000760r 1  A9 rr                lda #>(farret-1)        ; the callee's RTS goes to farret
000762r 1  48                   pha
000763r 1  A9 rr                lda #<(farret-1)
000765r 1  48                   pha
000766r 1  A0 03                ldy #3                  ; (the inline bytes are read before the
000768r 1  B1 E2                lda (FP),y              ; switch: they may be in the banked RAM)
00076Ar 1  AA                   tax                     ; target high byte
00076Br 1  88                   dey
00076Cr 1  B1 E2                lda (FP),y              ; target low byte
00076Er 1  38                   sec                     ; push target-1 for RTS
00076Fr 1  E9 01                sbc #1
000771r 1  B0 01                bcs @nb
000773r 1  CA                   dex
000774r 1  A8           @nb:    tay
000775r 1  8A                   txa
000776r 1  48                   pha
000777r 1  98                   tya
000778r 1  48                   pha
000779r 1  A0 01                ldy #1
00077Br 1  B1 E2                lda (FP),y              ; the bank to call into
00077Dr 1  8D 20 D0             sta BANK
000780r 1  A5 E4                lda FA                  ; registers as the caller left them
000782r 1  A6 EE                ldx FX
000784r 1  A4 E5                ldy FY
000786r 1  60                   rts                     ; "return" into the target
000787r 1               
000787r 1               ; The callee returns here: back to the caller's bank, A X Y and carry kept
000787r 1               farret:
000787r 1  85 E4                sta FA
000789r 1  68                   pla
00078Ar 1  8D 20 D0             sta BANK
00078Dr 1  A5 E4                lda FA
00078Fr 1  60                   rts
000790r 1               
000790r 1               ; Returns if the disk command worked; else reports it and goes to the prompt
000790r 1               ; (which resets the stack)
000790r 1               dcheck:
000790r 1  AD 41 D0             lda DSTAT
000793r 1  D0 01                bne diskerr
000795r 1  60                   rts
000796r 1               
000796r 1               ; Prints "? disk: <message>" for the status in A
000796r 1               diskerr:
000796r 1  48                   pha
000797r 1  20 rr rr             jsr newline
00079Ar 1  A9 rr A2 rr          PRINT s_derr
00079Er 1  20 rr rr     
0007A1r 1  68                   pla
0007A2r 1  38                   sec
0007A3r 1  E9 01                sbc #1
0007A5r 1  C9 06                cmp #6
0007A7r 1  B0 0D                bcs @unk
0007A9r 1  AA                   tax
0007AAr 1  BD rr rr             lda errlo,x
0007ADr 1  48                   pha
0007AEr 1  BD rr rr             lda errhi,x
0007B1r 1  AA                   tax
0007B2r 1  68                   pla
0007B3r 1  20 rr rr             jsr puts
0007B6r 1  4C rr rr     @unk:   jmp monitor
0007B9r 1               
0007B9r 1               usage:
0007B9r 1  20 rr rr             jsr newline
0007BCr 1  A9 rr A2 rr          PRINT s_what
0007C0r 1  20 rr rr     
0007C3r 1  4C rr rr             jmp monitor
0007C6r 1               
0007C6r 1               ; Prints DSTART.DEND-1 in hex, then back to the prompt
0007C6r 1               showrange:
0007C6r 1  AD 43 D0             lda DSTART+1
0007C9r 1  20 rr rr             jsr prbyte
0007CCr 1  AD 42 D0             lda DSTART
0007CFr 1  20 rr rr             jsr prbyte
0007D2r 1  A9 rr A2 rr          PRINT s_dot
0007D6r 1  20 rr rr     
0007D9r 1  38                   sec
0007DAr 1  AD 44 D0             lda DEND
0007DDr 1  E9 01                sbc #1
0007DFr 1  AA                   tax
0007E0r 1  AD 45 D0             lda DEND+1
0007E3r 1  E9 00                sbc #0
0007E5r 1  20 rr rr             jsr prbyte
0007E8r 1  8A                   txa
0007E9r 1  20 rr rr             jsr prbyte
0007ECr 1  4C rr rr             jmp monitor
0007EFr 1               
0007EFr 1               ; Skips spaces at IN,Y
0007EFr 1               skipsp:
0007EFr 1  B9 00 02             lda IN,y
0007F2r 1  C9 20                cmp #' '
0007F4r 1  D0 03                bne @done
0007F6r 1  C8                   iny
0007F7r 1  D0 F6                bne skipsp
0007F9r 1  60           @done:  rts
0007FAr 1               
0007FAr 1               ; Reads a file name at IN,Y (up to a space or the end of the line) and puts
0007FAr 1               ; its address and length in DNAME/DNLEN. Carry clear if there was none.
0007FAr 1               getname:
0007FAr 1  20 rr rr             jsr skipsp
0007FDr 1  8C 46 D0             sty DNAME               ; IN is page aligned: the low byte is Y
000800r 1  A9 02                lda #>IN
000802r 1  8D 47 D0             sta DNAME+1
000805r 1  A2 00                ldx #0
000807r 1  B9 00 02     @loop:  lda IN,y
00080Ar 1  C9 20                cmp #' '
00080Cr 1  F0 08                beq @end
00080Er 1  C9 0D                cmp #CR
000810r 1  F0 04                beq @end
000812r 1  C8                   iny
000813r 1  E8                   inx
000814r 1  D0 F1                bne @loop
000816r 1  8E 48 D0     @end:   stx DNLEN
000819r 1  E0 01                cpx #1                  ; carry set if at least one character
00081Br 1  60                   rts
00081Cr 1               
00081Cr 1               ; --- output --------------------------------------------------------------------
00081Cr 1               
00081Cr 1               ; New line, then "HHHH:" for XAM
00081Cr 1               showaddr:
00081Cr 1  20 rr rr             jsr newline
00081Fr 1  A5 E9                lda XAM+1
000821r 1  20 rr rr             jsr prbyte
000824r 1  A5 E8                lda XAM
000826r 1  20 rr rr             jsr prbyte
000829r 1  A9 3A                lda #':'
00082Br 1  4C rr rr             jmp putch
00082Er 1               
00082Er 1               ; " BB" for the byte at XAM
00082Er 1               showbyte:
00082Er 1  A9 20                lda #' '
000830r 1  20 rr rr             jsr putch
000833r 1  A2 00                ldx #0
000835r 1  A1 E8                lda (XAM,x)
000837r 1  4C rr rr             jmp prbyte
00083Ar 1               
00083Ar 1               ; Prints A as two hex digits
00083Ar 1               prbyte:
00083Ar 1  48                   pha
00083Br 1  4A                   lsr
00083Cr 1  4A                   lsr
00083Dr 1  4A                   lsr
00083Er 1  4A                   lsr
00083Fr 1  20 rr rr             jsr prhex
000842r 1  68                   pla
000843r 1               ; Prints the low nibble of A as a hex digit
000843r 1               prhex:
000843r 1  29 0F                and #$0F
000845r 1  09 30                ora #'0'
000847r 1  C9 3A                cmp #'9'+1
000849r 1  90 02                bcc putch
00084Br 1  69 06                adc #6                  ; carry is set: +7 gives 'A'..'F'
00084Dr 1               ; Prints A; A, X and Y are kept
00084Dr 1               putch:
00084Dr 1  8D 12 D0             sta DSP
000850r 1  8D 80 02             sta LASTC
000853r 1  60                   rts
000854r 1               
000854r 1               ; Starts a new line unless the cursor is already at the start of one
000854r 1               newline:
000854r 1  AD 80 02             lda LASTC
000857r 1  C9 0D                cmp #CR
000859r 1  F0 05                beq @done
00085Br 1  A9 0D                lda #CR
00085Dr 1  4C rr rr             jmp putch
000860r 1  60           @done:  rts
000861r 1               
000861r 1               ; Prints the zero-terminated string at X (high) A (low); Y is kept
000861r 1               puts:
000861r 1  85 E6                sta SPTR
000863r 1  86 E7                stx SPTR+1
000865r 1  98                   tya
000866r 1  48                   pha
000867r 1  A0 00                ldy #0
000869r 1  B1 E6        @loop:  lda (SPTR),y
00086Br 1  F0 0A                beq @done
00086Dr 1  20 rr rr             jsr putch
000870r 1  C8                   iny
000871r 1  D0 F6                bne @loop
000873r 1  E6 E7                inc SPTR+1               ; strings may be longer than 255 bytes
000875r 1  D0 F2                bne @loop
000877r 1  68           @done:  pla
000878r 1  A8                   tay
000879r 1  60                   rts
00087Ar 1               
00087Ar 1               ; Waits for a key and returns it in A (bit 7 cleared)
00087Ar 1               getkey:
00087Ar 1  AD 11 D0             lda KBDCR
00087Dr 1  10 FB                bpl getkey
00087Fr 1  AD 10 D0             lda KBD
000882r 1  29 7F                and #$7F
000884r 1  60                   rts
000885r 1               
000885r 1               ; --- BRK -----------------------------------------------------------------------
000885r 1               
000885r 1               irq:
000885r 1  48                   pha
000886r 1  8A                   txa
000887r 1  48                   pha
000888r 1  BA                   tsx
000889r 1  BD 03 01             lda $0103,x             ; P as pushed
00088Cr 1  29 10                and #$10                ; B flag: was this a BRK?
00088Er 1  D0 20                bne @brk
000890r 1  98                   tya                     ; a real IRQ: A, X, Y and the bank kept
000891r 1  48                   pha
000892r 1  AD 20 D0             lda BANK
000895r 1  48                   pha
000896r 1  D8                   cld
000897r 1  AD 09 D0             lda IRQBANK
00089Ar 1  8D 20 D0             sta BANK
00089Dr 1  AD 08 D0             lda IRQFLAGS            ; the sources (reading releases the IRQ)
0008A0r 1  20 rr rr             jsr @call
0008A3r 1  68                   pla
0008A4r 1  8D 20 D0             sta BANK
0008A7r 1  68                   pla
0008A8r 1  A8                   tay
0008A9r 1  68                   pla
0008AAr 1  AA                   tax
0008ABr 1  68                   pla
0008ACr 1  40                   rti
0008ADr 1  6C 0A D0     @call:  jmp (IRQVEC)
0008B0r 1  68           @brk:   pla
0008B1r 1  AA                   tax
0008B2r 1  68                   pla
0008B3r 1  8D 84 02             sta SAVA
0008B6r 1               
0008B6r 1               onbrk:
0008B6r 1  8E 85 02             stx SAVX
0008B9r 1  8C 86 02             sty SAVY
0008BCr 1  68                   pla
0008BDr 1  8D 87 02             sta SAVP
0008C0r 1  68                   pla                     ; return address = BRK + 2
0008C1r 1  38                   sec
0008C2r 1  E9 02                sbc #2
0008C4r 1  85 E8                sta XAM
0008C6r 1  68                   pla
0008C7r 1  E9 00                sbc #0
0008C9r 1  85 E9                sta XAM+1
0008CBr 1  20 rr rr             jsr newline
0008CEr 1  A9 rr A2 rr          PRINT s_brk
0008D2r 1  20 rr rr     
0008D5r 1  A5 E9                lda XAM+1
0008D7r 1  20 rr rr             jsr prbyte
0008DAr 1  A5 E8                lda XAM
0008DCr 1  20 rr rr             jsr prbyte
0008DFr 1  A9 rr A2 rr          PRINT s_a
0008E3r 1  20 rr rr     
0008E6r 1  AD 84 02             lda SAVA
0008E9r 1  20 rr rr             jsr prbyte
0008ECr 1  A9 rr A2 rr          PRINT s_x
0008F0r 1  20 rr rr     
0008F3r 1  AD 85 02             lda SAVX
0008F6r 1  20 rr rr             jsr prbyte
0008F9r 1  A9 rr A2 rr          PRINT s_y
0008FDr 1  20 rr rr     
000900r 1  AD 86 02             lda SAVY
000903r 1  20 rr rr             jsr prbyte
000906r 1  A9 rr A2 rr          PRINT s_p
00090Ar 1  20 rr rr     
00090Dr 1  AD 87 02             lda SAVP
000910r 1  20 rr rr             jsr prbyte
000913r 1  A9 rr A2 rr          PRINT s_s
000917r 1  20 rr rr     
00091Ar 1  BA                   tsx
00091Br 1  8A                   txa
00091Cr 1  20 rr rr             jsr prbyte
00091Fr 1  AD 87 02             lda SAVP                ; interrupts as they were before the BRK
000922r 1  29 04                and #$04
000924r 1  D0 01                bne @sei
000926r 1  58                   cli
000927r 1  4C rr rr     @sei:   jmp monitor
