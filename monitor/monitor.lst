000000r 2               
000000r 1               
000000r 1               SPTR     = $E6           ; 2 bytes: string being printed
000000r 1               XAM     = $E8           ; 2 bytes: last address shown (and R address)
000000r 1               STO     = $EA           ; 2 bytes: next address to store to
000000r 1               VAL     = $EC           ; 2 bytes: hex number just parsed
000000r 1               
000000r 1               IN      = $0200         ; input line, ends with CR
000000r 1               MAXLEN  = 126           ; longest line (one byte left for the CR)
000000r 1               
000000r 1               LASTC   = $0280         ; last character printed (for NEWLINE)
000000r 1               PMODE    = $0281         ; parser mode, see below
000000r 1               DIGITS  = $0282         ; hex digits in the number being parsed
000000r 1               TMP     = $0283
000000r 1               SAVA    = $0284         ; registers saved by BRK
000000r 1               SAVX    = $0285
000000r 1               SAVY    = $0286
000000r 1               SAVP    = $0287
000000r 1               NEWBANK = $0288         ; bank given to L / S
000000r 1               HAVEBANK = $0289        ; nonzero if one was given
000000r 1               OLDBANK = $028A         ; bank to select again afterwards
000000r 1               VNUM    = $028B         ; V: entry number
000000r 1               VADR    = $028C         ; V: 2 bytes, target address
000000r 1               
000000r 1               ; far calls
000000r 1               FP      = $E2           ; 2 bytes: points into the far call's inline bytes
000000r 1               FA      = $E4           ; A, X, Y kept while switching
000000r 1               FY      = $E5
000000r 1               FX      = $EE
000000r 1               
000000r 1               MODE_XAM   = 0          ; a number shows that address
000000r 1               MODE_BLOCK = 1          ; after '.': a number shows a range
000000r 1               MODE_STORE = 2          ; after ':': numbers are stored
000000r 1               
000000r 1               CR      = $0D
000000r 1               BS      = $08
000000r 1               ESC     = $1B
000000r 1               BEL     = $07
000000r 1               
000000r 1               .macro  PRINT str               ; prints a zero-terminated string; Y is kept
000000r 1                       lda #<str
000000r 1                       ldx #>str
000000r 1                       jsr puts
000000r 1               .endmacro
000000r 1               
000000r 1               ;=============================================================================
000000r 1               .segment "CODE"
000000r 1               ;=============================================================================
000000r 1               
000000r 1               ; --- cold start ----------------------------------------------------------------
000000r 1               reset:
000000r 1  D8                   cld
000001r 1  A2 FF                ldx #$FF
000003r 1  9A                   txs
000004r 1  A9 0D                lda #CR
000006r 1  8D 80 02             sta LASTC
000009r 1  A9 rr A2 rr          PRINT s_banner
00000Dr 1  20 rr rr     
000010r 1               
000010r 1               ; boot: only at a cold start, and only if no keys are waiting
000010r 1  AD 00 D0             lda SYSCTL              ; 1 once after power-on / $FF cold reset
000013r 1  F0 60                beq monitor
000015r 1  20 rr rr             jsr mapinit             ; a fresh bank map
000018r 1  AD 11 D0             lda KBDCR               ; keys already typed in? then leave them to
00001Br 1  30 58                bmi monitor             ; the monitor (the key stays waiting)
00001Dr 1  A9 rr                lda #<s_bootn
00001Fr 1  8D 46 D0             sta DNAME
000022r 1  A9 rr                lda #>s_bootn
000024r 1  8D 47 D0             sta DNAME+1
000027r 1  A9 00                lda #0
000029r 1  8D 48 D0             sta DNLEN               ; name ends with $00
00002Cr 1  8D 44 D0             sta DEND                ; no limit
00002Fr 1  8D 45 D0             sta DEND+1
000032r 1  A9 01                lda #1                  ; load at the file's own address
000034r 1  8D 40 D0             sta DCMD
000037r 1  AD 41 D0             lda DSTAT
00003Ar 1  F0 16                beq @booted
00003Cr 1  C9 01                cmp #1                  ; no BOOT file: try the script BOOT.TXT
00003Er 1  D0 0F                bne @prompt             ; (BOOT is there but would not load: prompt)
000040r 1  A9 rr                lda #<s_boottxt
000042r 1  8D 46 D0             sta DNAME
000045r 1  A9 rr                lda #>s_boottxt
000047r 1  8D 47 D0             sta DNAME+1
00004Ar 1  A9 06                lda #6                  ; type it; nothing happens if it is not there
00004Cr 1  8D 40 D0             sta DCMD
00004Fr 1               @prompt:
00004Fr 1  4C rr rr             jmp monitor
000052r 1               @booted:
000052r 1  AD 42 D0             lda DSTART
000055r 1  85 E8                sta XAM
000057r 1  AD 43 D0             lda DSTART+1
00005Ar 1  85 E9                sta XAM+1
00005Cr 1  A9 rr A2 rr          PRINT s_boot
000060r 1  20 rr rr     
000063r 1  A5 E9                lda XAM+1
000065r 1  20 rr rr             jsr prbyte
000068r 1  A5 E8                lda XAM
00006Ar 1  20 rr rr             jsr prbyte
00006Dr 1  A9 0D                lda #CR
00006Fr 1  20 rr rr             jsr putch
000072r 1  4C rr rr             jmp run                 ; JSR to it: an RTS comes back to the prompt
000075r 1               
000075r 1               ; --- main loop: prompt, read a line, run its commands ---------------------------
000075r 1               monitor:
000075r 1  D8                   cld
000076r 1  A2 FF                ldx #$FF                ; fresh stack for every line
000078r 1  9A                   txs
000079r 1  20 rr rr             jsr newline
00007Cr 1  A9 3E                lda #'>'
00007Er 1  20 rr rr             jsr putch
000081r 1  A0 00                ldy #0
000083r 1               
000083r 1               readkey:
000083r 1  20 rr rr             jsr getkey
000086r 1  C9 0D                cmp #CR
000088r 1  F0 45                beq endline
00008Ar 1  C9 1B                cmp #ESC
00008Cr 1  F0 39                beq cancel
00008Er 1  C9 08                cmp #BS
000090r 1  F0 28                beq rubout
000092r 1  C9 7F                cmp #$7F
000094r 1  F0 24                beq rubout
000096r 1  C9 20                cmp #' '
000098r 1  90 E9                bcc readkey             ; other control keys are ignored
00009Ar 1  C9 61                cmp #'a'
00009Cr 1  90 06                bcc @store
00009Er 1  C9 7B                cmp #'z'+1
0000A0r 1  B0 02                bcs @store
0000A2r 1  29 DF                and #$DF                ; lower case -> upper case
0000A4r 1  C0 7E        @store: cpy #MAXLEN
0000A6r 1  B0 0A                bcs @full
0000A8r 1  99 00 02             sta IN,y
0000ABr 1  C8                   iny
0000ACr 1  20 rr rr             jsr putch
0000AFr 1  4C rr rr             jmp readkey
0000B2r 1  A9 07        @full:  lda #BEL                ; line full: beep, ignore the key
0000B4r 1  20 rr rr             jsr putch
0000B7r 1  4C rr rr             jmp readkey
0000BAr 1               
0000BAr 1               rubout:
0000BAr 1  C0 00                cpy #0
0000BCr 1  F0 C5                beq readkey
0000BEr 1  88                   dey
0000BFr 1  A9 08                lda #BS                 ; the terminal moves left and blanks the cell
0000C1r 1  20 rr rr             jsr putch
0000C4r 1  4C rr rr             jmp readkey
0000C7r 1               
0000C7r 1               cancel:
0000C7r 1  A9 5C                lda #'\'
