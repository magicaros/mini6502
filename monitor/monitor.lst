0002E4r 1  20 rr rr             jsr dcheck              ; back to the prompt with a message on error
0002E7r 1  4C rr rr             jmp monitor             ; the prompt then reads the typed lines
0002EAr 1  4C rr rr     @bad:   jmp usage
0002EDr 1               
0002EDr 1               ; K NAME
0002EDr 1               cmd_kill:
0002EDr 1  C8                   iny
0002EEr 1  20 rr rr             jsr getname
0002F1r 1  90 15                bcc @bad
0002F3r 1  A9 05                lda #5
0002F5r 1  8D 40 D0             sta DCMD
0002F8r 1  20 rr rr             jsr dcheck              ; back to the prompt with a message on error
