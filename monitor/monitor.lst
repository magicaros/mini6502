000404r 1  BD 00 02     @nc:    lda IN,x
000407r 1  C9 21                cmp #' '+1              ; a space or the CR ends it
000409r 1  90 0A                bcc @pad
00040Br 1  91 EC                sta (VAL),y
00040Dr 1  E8                   inx
00040Er 1  C8                   iny
00040Fr 1  C0 08                cpy #8
000411r 1  D0 F1                bne @nc
000413r 1  F0 09                beq @named
000415r 1  A9 00        @pad:   lda #0
000417r 1  91 EC        @pd:    sta (VAL),y
000419r 1  C8                   iny
00041Ar 1  C0 08                cpy #8
00041Cr 1  D0 F9                bne @pd
00041Er 1  AE 8B 02     @named: ldx VNUM                ; count = max(count, NN+1)
000421r 1  E8                   inx
000422r 1  EC 02 CC             cpx VTCOUNT
000425r 1  90 03                bcc @shown
