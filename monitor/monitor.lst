000380r 1               ; V                 list the vector table
000380r 1               ; V NN BB HHHH      set entry NN to call HHHH in bank BB
000380r 1               cmd_vec:
000380r 1  C8                   iny
000381r 1  20 rr rr             jsr skipsp
