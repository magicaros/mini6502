000348r 1  4C rr rr     @wait:  jmp @wait
00034Br 1               
00034Br 1               ; Reads an optional bank number after a space: HAVEBANK/NEWBANK
00034Br 1               getbank:
00034Br 1  A9 00                lda #0
00034Dr 1  8D 89 02             sta HAVEBANK
000350r 1  20 rr rr             jsr skipsp
000353r 1  20 rr rr             jsr gethex
000356r 1  90 0A                bcc @none
