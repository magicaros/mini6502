000000r 2               BDXH        = $D31E   ; read/write
000000r 2               BDYH        = $D31F   ; read/write
000000r 2               COLLSS      = $D320   ; read, 4 bytes
000000r 2               COLLBG      = $D324   ; read, 4 bytes
000000r 2               ROP         = $D328   ; read/write
000000r 2               PATON       = $D329   ; read/write
000000r 2               CHR         = $D32A   ; read/write
000000r 2               STYLE       = $D32B   ; read/write
