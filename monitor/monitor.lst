0000CCr 1  4C rr rr             jmp monitor
0000CFr 1               
0000CFr 1               endline:
0000CFr 1  99 00 02             sta IN,y                ; CR ends the buffer
0000D2r 1  20 rr rr             jsr putch
0000D5r 1               
0000D5r 1               ; --- run the commands in the line ----------------------------------------------
0000D5r 1  A0 00                ldy #0
0000D7r 1  8C 81 02             sty PMODE
0000DAr 1               parse:
0000DAr 1  B9 00 02             lda IN,y
0000DDr 1  C9 0D                cmp #CR
0000DFr 1  F0 94                beq monitor
0000E1r 1  C9 2E                cmp #'.'
0000E3r 1  F0 66                beq @block
0000E5r 1  C9 3A                cmp #':'
0000E7r 1  F0 66                beq @store
0000E9r 1  C9 52                cmp #'R'
0000EBr 1  F0 76                beq run
0000EDr 1  C9 3F                cmp #'?'
0000EFr 1  F0 67                beq help
0000F1r 1  C9 53                cmp #'S'
0000F3r 1  D0 03                bne @nos
0000F5r 1  4C rr rr             jmp cmd_save
0000F8r 1  C9 4C        @nos:   cmp #'L'
0000FAr 1  D0 03                bne @nol
0000FCr 1  4C rr rr             jmp cmd_load
0000FFr 1  C9 24        @nol:   cmp #'$'
000101r 1  D0 03                bne @nod
000103r 1  4C rr rr             jmp cmd_dir
000106r 1  C9 54        @nod:   cmp #'T'
000108r 1  D0 03                bne @not
00010Ar 1  4C rr rr             jmp cmd_type
00010Dr 1  C9 4B        @not:   cmp #'K'
00010Fr 1  D0 03                bne @nok
000111r 1  4C rr rr             jmp cmd_kill
000114r 1  C9 57        @nok:   cmp #'W'
000116r 1  D0 0E                bne @now
000118r 1  A9 02                lda #2                  ; clear the screen, cursor home
00011Ar 1  8D 00 D0             sta SYSCTL
00011Dr 1  A9 0D                lda #CR                 ; the cursor is at the start of a line
00011Fr 1  8D 80 02             sta LASTC
000122r 1  C8                   iny
000123r 1  4C rr rr             jmp parse
000126r 1  C9 47        @now:   cmp #'G'
000128r 1  D0 03                bne @nog
00012Ar 1  4C rr rr             jmp cmd_go
00012Dr 1  C9 56        @nog:   cmp #'V'
00012Fr 1  D0 03                bne @nov
000131r 1  4C rr rr             jmp cmd_vec
000134r 1  C9 58        @nov:   cmp #'X'
000136r 1  D0 03                bne @nox
000138r 1  4C rr rr             jmp cmd_exit
00013Br 1  C9 4D        @nox:   cmp #'M'
00013Dr 1  D0 03                bne @nom
00013Fr 1  4C rr rr             jmp cmd_map
000142r 1  20 rr rr     @nom:   jsr gethex              ; number? (Y moves past its digits)
000145r 1  B0 25                bcs number
000147r 1  C8                   iny                     ; anything else separates commands
000148r 1  4C rr rr             jmp parse
00014Br 1  A9 01        @block: lda #MODE_BLOCK
00014Dr 1  D0 02                bne @setmode
00014Fr 1  A9 02        @store: lda #MODE_STORE
000151r 1               @setmode:
000151r 1  8D 81 02             sta PMODE
000154r 1  C8                   iny
000155r 1  4C rr rr             jmp parse
000158r 1               
000158r 1               help:
000158r 1  C8                   iny
000159r 1  A9 rr A2 rr          PRINT s_help
00015Dr 1  20 rr rr     
000160r 1  4C rr rr             jmp parse
000163r 1               
000163r 1               run:
000163r 1  20 rr rr             jsr @go                 ; the program's RTS returns here
000166r 1  4C rr rr             jmp monitor
000169r 1  6C E8 00     @go:    jmp (XAM)
00016Cr 1               
00016Cr 1               number:
00016Cr 1  AD 81 02             lda PMODE
00016Fr 1  C9 02                cmp #MODE_STORE
000171r 1  D0 0E                bne @notst
000173r 1  AD 82 02             lda DIGITS              ; storing: 1-2 digits are a byte, 3-4 digits
000176r 1  C9 03                cmp #3                  ; a new address ("D020: 05 D021: 1E" works)
000178r 1  90 37                bcc @store
00017Ar 1  A9 00                lda #MODE_XAM
00017Cr 1  8D 81 02             sta PMODE
00017Fr 1  F0 04                beq @xam
000181r 1  C9 01        @notst: cmp #MODE_BLOCK
000183r 1  F0 3B                beq @block
000185r 1               
000185r 1                       ; show one address: it becomes the last address shown and the place
000185r 1                       ; where ':' will store
000185r 1  A5 EC        @xam:   lda VAL
000187r 1  85 E8                sta XAM
000189r 1  85 EA                sta STO
00018Br 1  A5 ED                lda VAL+1
00018Dr 1  85 E9                sta XAM+1
00018Fr 1  85 EB                sta STO+1
000191r 1  20 rr rr             jsr showaddr
000194r 1  A5 E9                lda XAM+1               ; an I/O address about to be stored to
000196r 1  29 F0                and #$F0                ; ("D203: 41"): do not read it first, as
000198r 1  C9 D0                cmp #$D0                ; reading can have an effect (a data port
00019Ar 1  D0 0F                bne @show               ; moves on, KBD takes the key)
00019Cr 1  98                   tya
00019Dr 1  48                   pha
00019Er 1  20 rr rr             jsr skipsp
0001A1r 1  B9 00 02             lda IN,y
0001A4r 1  AA                   tax
0001A5r 1  68                   pla
0001A6r 1  A8                   tay
0001A7r 1  E0 3A                cpx #':'
0001A9r 1  F0 03                beq @noshow
0001ABr 1  20 rr rr     @show:  jsr showbyte
0001AEr 1               @noshow:
0001AEr 1  4C rr rr             jmp parse
0001B1r 1               
0001B1r 1  A5 EC        @store: lda VAL
0001B3r 1  A2 00                ldx #0
0001B5r 1  81 EA                sta (STO,x)
0001B7r 1  E6 EA                inc STO
0001B9r 1  D0 02                bne @next
0001BBr 1  E6 EB                inc STO+1
0001BDr 1  4C rr rr     @next:  jmp parse
0001C0r 1               
0001C0r 1  A5 E8        @block: lda XAM                 ; show XAM+1 .. VAL
0001C2r 1  C5 EC                cmp VAL
0001C4r 1  A5 E9                lda XAM+1
0001C6r 1  E5 ED                sbc VAL+1
0001C8r 1  B0 15                bcs @done               ; XAM >= VAL: nothing (more) to show
0001CAr 1  E6 E8                inc XAM
0001CCr 1  D0 02                bne @noc
0001CEr 1  E6 E9                inc XAM+1
0001D0r 1  A5 E8        @noc:   lda XAM
0001D2r 1  29 07                and #$07
0001D4r 1  D0 03                bne @byte
0001D6r 1  20 rr rr             jsr showaddr            ; new line every 8 bytes
0001D9r 1  20 rr rr     @byte:  jsr showbyte
0001DCr 1  4C rr rr             jmp @block
0001DFr 1  A9 00        @done:  lda #MODE_XAM
0001E1r 1  8D 81 02             sta PMODE
0001E4r 1  4C rr rr             jmp parse
0001E7r 1               
0001E7r 1               ; Parses hex digits at IN,Y into VAL (only the last 4 digits count).
0001E7r 1               ; Returns carry set if there was at least one digit; Y is moved past them.
0001E7r 1               gethex:
0001E7r 1  A9 00                lda #0
0001E9r 1  85 EC                sta VAL
0001EBr 1  85 ED                sta VAL+1
0001EDr 1  8D 82 02             sta DIGITS
0001F0r 1  B9 00 02     @loop:  lda IN,y
0001F3r 1  C9 30                cmp #'0'
0001F5r 1  90 2D                bcc @end
0001F7r 1  C9 3A                cmp #'9'+1
0001F9r 1  90 0D                bcc @dec
0001FBr 1  C9 41                cmp #'A'
0001FDr 1  90 25                bcc @end
0001FFr 1  C9 47                cmp #'F'+1
000201r 1  B0 21                bcs @end
000203r 1  E9 36                sbc #'A'-11             ; carry is clear: A - ('A'-11) - 1 = 10..15
000205r 1  4C rr rr             jmp @digit
000208r 1  29 0F        @dec:   and #$0F
00020Ar 1  8D 83 02     @digit: sta TMP
00020Dr 1  A2 04                ldx #4
00020Fr 1  06 EC        @shift: asl VAL
000211r 1  26 ED                rol VAL+1
000213r 1  CA                   dex
000214r 1  D0 F9                bne @shift
000216r 1  A5 EC                lda VAL
000218r 1  0D 83 02             ora TMP
00021Br 1  85 EC                sta VAL
00021Dr 1  EE 82 02             inc DIGITS
000220r 1  C8                   iny
000221r 1  4C rr rr             jmp @loop
000224r 1  AD 82 02     @end:   lda DIGITS
000227r 1  C9 01                cmp #1                  ; carry set if DIGITS >= 1
000229r 1  60                   rts
00022Ar 1               
00022Ar 1               ; --- disk ----------------------------------------------------------------------
00022Ar 1               
00022Ar 1               ; S NAME HHHH.HHHH
00022Ar 1               cmd_save:
00022Ar 1  C8                   iny
00022Br 1  20 rr rr             jsr getname
00022Er 1  90 46                bcc @bad
000230r 1  20 rr rr             jsr skipsp
000233r 1  20 rr rr             jsr gethex
000236r 1  90 3E                bcc @bad
000238r 1  A5 EC                lda VAL
00023Ar 1  8D 42 D0             sta DSTART
00023Dr 1  A5 ED                lda VAL+1
00023Fr 1  8D 43 D0             sta DSTART+1
000242r 1  B9 00 02             lda IN,y
000245r 1  C9 2E                cmp #'.'
000247r 1  D0 2D                bne @bad
000249r 1  C8                   iny
00024Ar 1  20 rr rr             jsr gethex
00024Dr 1  90 27                bcc @bad
00024Fr 1  18                   clc                     ; end + 1 ($FFFF + 1 = 0 means "up to $FFFF")
000250r 1  A5 EC                lda VAL
000252r 1  69 01                adc #1
000254r 1  8D 44 D0             sta DEND
000257r 1  A5 ED                lda VAL+1
000259r 1  69 00                adc #0
00025Br 1  8D 45 D0             sta DEND+1
00025Er 1  20 rr rr             jsr getbank             ; optional bank
000261r 1  A9 02                lda #2
000263r 1  20 rr rr             jsr diskbank            ; run the command with that bank selected
000266r 1  20 rr rr             jsr dcheck              ; back to the prompt with a message on error
000269r 1  20 rr rr             jsr newline
00026Cr 1  A9 rr A2 rr          PRINT s_saved
000270r 1  20 rr rr     
000273r 1  4C rr rr             jmp showrange
000276r 1  4C rr rr     @bad:   jmp usage
000279r 1               
000279r 1               ; L NAME [HHHH]
000279r 1               cmd_load:
000279r 1  C8                   iny
00027Ar 1  20 rr rr             jsr getname
00027Dr 1  90 57                bcc @bad
00027Fr 1  20 rr rr             jsr skipsp
000282r 1  A9 00                lda #0
000284r 1  8D 44 D0             sta DEND                ; no limit
000287r 1  8D 45 D0             sta DEND+1
00028Ar 1  20 rr rr             jsr gethex
00028Dr 1  90 11                bcc @own
00028Fr 1  A5 EC                lda VAL
000291r 1  8D 42 D0             sta DSTART
000294r 1  A5 ED                lda VAL+1
000296r 1  8D 43 D0             sta DSTART+1
000299r 1  20 rr rr             jsr getbank             ; optional bank (only after an address)
00029Cr 1  A9 03                lda #3                  ; load at HHHH
00029Er 1  D0 07                bne @go
0002A0r 1  A9 00        @own:   lda #0
0002A2r 1  8D 89 02             sta HAVEBANK
0002A5r 1  A9 01                lda #1                  ; load at the file's own address
0002A7r 1  20 rr rr     @go:    jsr diskbank            ; run the command with that bank selected
0002AAr 1  20 rr rr             jsr dcheck              ; back to the prompt with a message on error
0002ADr 1  AD 89 02             lda HAVEBANK            ; loaded into a free bank: it is taken now
0002B0r 1  F0 0D                beq @nomark
0002B2r 1  AE 88 02             ldx NEWBANK
0002B5r 1  BD 00 CF             lda BANKMAP,x
0002B8r 1  D0 05                bne @nomark
0002BAr 1  A9 FE                lda #OWN_HAND
0002BCr 1  9D 00 CF             sta BANKMAP,x
0002BFr 1               @nomark:
0002BFr 1  AD 42 D0             lda DSTART              ; R will run what was loaded
0002C2r 1  85 E8                sta XAM
0002C4r 1  AD 43 D0             lda DSTART+1
0002C7r 1  85 E9                sta XAM+1
0002C9r 1  20 rr rr             jsr newline
0002CCr 1  A9 rr A2 rr          PRINT s_loaded
0002D0r 1  20 rr rr     
0002D3r 1  4C rr rr             jmp showrange
0002D6r 1  4C rr rr     @bad:   jmp usage
0002D9r 1               
0002D9r 1               ; T NAME: the host types the file into the keyboard queue
0002D9r 1               cmd_type:
0002D9r 1  C8                   iny
0002DAr 1  20 rr rr             jsr getname
0002DDr 1  90 0B                bcc @bad
0002DFr 1  A9 06                lda #6
