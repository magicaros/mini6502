0003D5r 1  91 EC                sta (VAL),y
0003D7r 1  C8                   iny
0003D8r 1  68                   pla                     ; bank
0003D9r 1  91 EC                sta (VAL),y
0003DBr 1  C8                   iny
0003DCr 1  AD 8C 02             lda VADR
0003DFr 1  91 EC                sta (VAL),y
0003E1r 1  C8                   iny
0003E2r 1  AD 8D 02             lda VADR+1
0003E5r 1  91 EC                sta (VAL),y
0003E7r 1  C8                   iny
0003E8r 1  A9 00                lda #0
0003EAr 1  91 EC                sta (VAL),y
0003ECr 1  C8                   iny
0003EDr 1  91 EC                sta (VAL),y
0003EFr 1  AD 8B 02             lda VNUM                ; the name: up to 8 characters, 0 after
0003F2r 1  20 rr rr             jsr vnaddr
0003F5r 1  AE 83 02             ldx TMP
0003F8r 1  BD 00 02     @sk:    lda IN,x
0003FBr 1  C9 20                cmp #' '
0003FDr 1  D0 03                bne @nm
0003FFr 1  E8                   inx
000400r 1  D0 F6                bne @sk
