00E44D  1               
00E44D  1               ; REDRAW = max(REDRAW, A)
00E44D  1               wantredraw:
00E44D  1  C5 26                cmp REDRAW
00E44F  1  90 02                bcc @keep
00E451  1  85 26                sta REDRAW
00E453  1  60           @keep:  rts
00E454  1               
00E454  1               ; Empty text, cursor at the start
00E454  1               newtext:
00E454  1  A9 00                lda #<BUF
00E456  1  85 10                sta GS
00E458  1  A9 04                lda #>BUF
00E45A  1  85 11                sta GS+1
00E45C  1  A9 F0                lda #<TOP
00E45E  1  85 12                sta GE
00E460  1  A9 CB                lda #>TOP
00E462  1  85 13                sta GE+1
00E464  1  A9 00                lda #0
00E466  1  85 14                sta TOPPOS
00E468  1  85 15                sta TOPPOS+1
00E46A  1  85 16                sta CURLINE
00E46C  1  85 17                sta CURLINE+1
00E46E  1  85 18                sta LEFTCOL
00E470  1  85 19                sta WANTCOL
00E472  1  85 1A                sta COL
00E474  1  85 27                sta MODIFIED
00E476  1  60                   rts
00E477  1               
00E477  1               ; --- swapping the RAM ----------------------------------------------------------
00E477  1               ; The editor and the program that called it (BASIC, the monitor...) each have
00E477  1               ; their own copy of the fixed RAM $0000-$CBFF, kept in banks by DMA:
00E477  1               ;   WORLD  ($F0000, banks $F0-$FC)  the caller's RAM while the editor runs
00E477  1               ;   IMAGE  ($E0000, banks $E0-$EC)  the editor's RAM (text, state) meanwhile
00E477  1               ; Entering saves the caller's RAM to WORLD and (warm start) copies IMAGE in;
00E477  1               ; Esc does the opposite and returns to the caller with RTS, on its own stack.
00E477  1               ; INSIDE (in the editor's bank, not in the swapped RAM) says that the RAM
00E477  1               ; holds the editor's image: after F1, G (or E003R) just carries on.
00E477  1               
00E477  1               ; Copies 9 bytes from a table to the DMA registers and starts a COPY. Inline
00E477  1               ; (a macro, not a subroutine): the copy may replace the stack page.
00E477  1               .macro  DMACOPY tbl
00E477  1                       .local @l
00E477  1                       ldx #8
00E477  1               @l:     lda tbl,x
00E477  1                       sta DMASRC,x
00E477  1                       dex
00E477  1                       bpl @l
00E477  1                       lda #1
00E477  1                       sta DMACMD
00E477  1               .endmacro
00E477  1               
00E477  1               ; Called first by cold and warm (JSR: the return address is on the caller's
00E477  1               ; stack, which is saved with the rest; we come back to it only if nothing was
00E477  1               ; swapped yet, or before the swap replaces it)
00E477  1               enter:
00E477  1  AD 20 D0             lda BANK                ; the editor must not run from a bank the
00E47A  1  C9 E0                cmp #$E0                ; swap uses ($E0-$FF)
00E47C  1  90 08                bcc @bankok
00E47E  1  68                   pla                     ; refused: beep and return to the caller
00E47F  1  68                   pla
00E480  1  A9 01                lda #1
00E482  1  8D 00 D1             sta BEEP
00E485  1  60                   rts
00E486  1               @bankok:
00E486  1  AD F0 EF             lda INSIDE              ; the RAM already holds the editor's image?
00E489  1  C9 A5                cmp #INMAGIC
00E48B  1  D0 0F                bne @swap
00E48D  1  AD 00 03             lda SIG                 ; ...and it still looks like it
00E490  1  C9 45                cmp #'E'
00E492  1  D0 08                bne @swap
00E494  1  AD 01 03             lda SIG+1
00E497  1  C9 44                cmp #'D'
00E499  1  D0 01                bne @swap
00E49B  1  60                   rts                     ; yes: nothing to swap
00E49C  1  68           @swap:  pla                     ; our return address, kept in the bank: the
00E49D  1  8D F5 EF             sta RETLO               ; stack page is about to change
00E4A0  1  68                   pla
00E4A1  1  8D F6 EF             sta RETHI
00E4A4  1  BA                   tsx                     ; the caller's stack pointer (after its JSR)
00E4A5  1  8E F1 EF             stx SAVSP
00E4A8  1  AD 02 D0             lda WARMLO              ; the caller's warm start (G), put back by Esc
00E4AB  1  8D F2 EF             sta SAVWLO
00E4AE  1  AD 03 D0             lda WARMHI
00E4B1  1  8D F3 EF             sta SAVWHI
00E4B4  1  AD 21 D0             lda COLOR
00E4B7  1  8D F4 EF             sta SAVCOL
00E4BA  1  A9 00                lda #0                  ; an interrupt handler in the caller's RAM is
00E4BC  1  8D F8 EF             sta SAVIRQ              ; turned off while it is swapped out (one in
00E4BF  1  AD 0B D0             lda IRQVEC+1            ; a bank keeps running)
00E4C2  1  C9 E0                cmp #$E0
00E4C4  1  B0 0B                bcs @irqok
00E4C6  1  AD 07 D0             lda IRQEN
00E4C9  1  8D F8 EF             sta SAVIRQ
00E4CC  1  A9 00                lda #0
00E4CE  1  8D 07 D0             sta IRQEN
00E4D1  1               @irqok:
00E4D1  1  A2 08 BD 4D          DMACOPY d_save          ; caller's RAM -> WORLD
00E4D5  1  E5 9D 10 D2  
00E4D9  1  CA 10 F7 A9  
00E4E1  1  A2 08 BD 56          DMACOPY d_load          ; IMAGE -> RAM (cold clears it afterwards)
00E4E5  1  E5 9D 10 D2  
00E4E9  1  CA 10 F7 A9  
00E4F1  1  A9 A5                lda #INMAGIC
00E4F3  1  8D F0 EF             sta INSIDE
00E4F6  1  AD F6 EF             lda RETHI               ; return (to cold or warm, which reset the
00E4F9  1  48                   pha                     ; stack anyway)
00E4FA  1  AD F5 EF             lda RETLO
00E4FD  1  48                   pha
00E4FE  1  60                   rts
00E4FF  1               
00E4FF  1               ; Esc: the editor's RAM back to IMAGE, the caller's RAM back, RTS to it.
00E4FF  1               ; Nothing in the zero page may be used after the second copy.
00E4FF  1               leave:
00E4FF  1  A9 02                lda #2
00E501  1  8D 00 D0             sta SYSCTL              ; clear the screen
00E504  1  A2 08 BD 5F          DMACOPY d_keep          ; RAM -> IMAGE
00E508  1  E5 9D 10 D2  
00E50C  1  CA 10 F7 A9  
00E514  1  A2 08 BD 68          DMACOPY d_back          ; WORLD -> RAM
00E518  1  E5 9D 10 D2  
00E51C  1  CA 10 F7 A9  
00E524  1  AD 0B D0             lda IRQVEC+1            ; a handler in the RAM: the caller's again
00E527  1  C9 E0                cmp #$E0
00E529  1  B0 06                bcs @irqok
00E52B  1  AD F8 EF             lda SAVIRQ
00E52E  1  8D 07 D0             sta IRQEN
00E531  1  A9 00        @irqok: lda #0
00E533  1  8D F0 EF             sta INSIDE
00E536  1  AD F2 EF             lda SAVWLO
00E539  1  8D 02 D0             sta WARMLO
00E53C  1  AD F3 EF             lda SAVWHI
00E53F  1  8D 03 D0             sta WARMHI
00E542  1  AD F4 EF             lda SAVCOL
00E545  1  8D 21 D0             sta COLOR
00E548  1  AE F1 EF             ldx SAVSP
00E54B  1  9A                   txs
00E54C  1  60                   rts                     ; to the caller (CALL in BASIC, R, G...)
00E54D  1               
00E54D  1               ; DMA descriptors: source (3 bytes), destination (3), length (3)
00E54D  1  00 00 FF 00  d_save: .byte $00,$00,$FF, <WORLD,>WORLD,^WORLD, <SWAPLEN,>SWAPLEN,0
00E551  1  00 0F 00 CC  
00E555  1  00           
00E556  1  00 00 0E 00  d_load: .byte <IMAGE,>IMAGE,^IMAGE, $00,$00,$FF, <SWAPLEN,>SWAPLEN,0
00E55A  1  00 FF 00 CC  
00E55E  1  00           
00E55F  1  00 00 FF 00  d_keep: .byte $00,$00,$FF, <IMAGE,>IMAGE,^IMAGE, <SWAPLEN,>SWAPLEN,0
00E563  1  00 0E 00 CC  
00E567  1  00           
00E568  1  00 00 0F 00  d_back: .byte <WORLD,>WORLD,^WORLD, $00,$00,$FF, <SWAPLEN,>SWAPLEN,0
00E56C  1  00 FF 00 CC  
00E570  1  00           
00E571  1               
00E571  1               clearram:
00E571  1  A9 00                lda #<$0300
00E573  1  85 1C                sta P
00E575  1  A9 03                lda #>$0300
00E577  1  85 1D                sta P+1
00E579  1  A9 00                lda #0
00E57B  1  A8                   tay
00E57C  1  91 1C        @loop:  sta (P),y
00E57E  1  C8                   iny
00E57F  1  D0 FB                bne @loop
00E581  1  E6 1D                inc P+1
00E583  1  A6 1D                ldx P+1
00E585  1  E0 CB                cpx #>TOP               ; up to $CBFF: the stub is written afterwards
00E587  1  90 F3                bcc @loop
00E589  1  F0 F1                beq @loop
00E58B  1  60                   rts
00E58C  1               
00E58C  1               ; G -> this bank, warm start
00E58C  1               setstub:
00E58C  1  A9 A9                lda #$A9                ; LDA #bank
00E58E  1  8D F0 CB             sta STUB
00E591  1  A5 29                lda MYBANK
00E593  1  8D F1 CB             sta STUB+1
00E596  1  A9 8D                lda #$8D                ; STA BANK
00E598  1  8D F2 CB             sta STUB+2
00E59B  1  A9 20                lda #<BANK
00E59D  1  8D F3 CB             sta STUB+3
00E5A0  1  A9 D0                lda #>BANK
00E5A2  1  8D F4 CB             sta STUB+4
00E5A5  1  A9 4C                lda #$4C                ; JMP warm
00E5A7  1  8D F5 CB             sta STUB+5
00E5AA  1  A9 42                lda #<warm
00E5AC  1  8D F6 CB             sta STUB+6
00E5AF  1  A9 E0                lda #>warm
00E5B1  1  8D F7 CB             sta STUB+7
00E5B4  1  A9 F0                lda #<STUB
00E5B6  1  8D 02 D0             sta WARMLO
00E5B9  1  A9 CB                lda #>STUB
00E5BB  1  8D 03 D0             sta WARMHI
00E5BE  1  60                   rts
00E5BF  1               
00E5BF  1               ; Moves the text after the gap down to GS: the text becomes BUF..GS+T
00E5BF  1               ; (T = its length). The cursor stays logically at GS.
00E5BF  1               closegap:
00E5BF  1  38                   sec
00E5C0  1  A9 F0                lda #<TOP
00E5C2  1  E5 12                sbc GE
00E5C4  1  85 20                sta T
00E5C6  1  A9 CB                lda #>TOP
00E5C8  1  E5 13                sbc GE+1
00E5CA  1  85 21                sta T+1
00E5CC  1  A5 12                lda GE                  ; from GE
00E5CE  1  85 1E                sta Q
00E5D0  1  A5 13                lda GE+1
00E5D2  1  85 1F                sta Q+1
00E5D4  1  A5 10                lda GS                  ; to GS
00E5D6  1  85 1C                sta P
00E5D8  1  A5 11                lda GS+1
00E5DA  1  85 1D                sta P+1
00E5DC  1  4C 2E E6             jmp copyup              ; forward copy (destination is lower)
00E5DF  1               
00E5DF  1               ; Puts it back: GS..GS+T moves to GE..TOP
00E5DF  1               opengap:
00E5DF  1  A5 10                lda GS
00E5E1  1  85 1E                sta Q
00E5E3  1  A5 11                lda GS+1
00E5E5  1  85 1F                sta Q+1
00E5E7  1  A5 12                lda GE
00E5E9  1  85 1C                sta P
00E5EB  1  A5 13                lda GE+1
00E5ED  1  85 1D                sta P+1
00E5EF  1  4C 4F E6             jmp copydown            ; backward copy (destination is higher)
00E5F2  1               
00E5F2  1               ; After a load: text BUF..GS, gap GS..TOP. Moves the text to the top, so
00E5F2  1               ; the cursor is at the start: GE = TOP - length, GS = BUF.
00E5F2  1               gaptostart:
00E5F2  1  38                   sec
00E5F3  1  A5 10                lda GS
00E5F5  1  E9 00                sbc #<BUF
00E5F7  1  85 20                sta T
00E5F9  1  A5 11                lda GS+1
00E5FB  1  E9 04                sbc #>BUF
00E5FD  1  85 21                sta T+1
00E5FF  1  38                   sec
00E600  1  A9 F0                lda #<TOP
00E602  1  E5 20                sbc T
00E604  1  85 12                sta GE
00E606  1  85 1C                sta P
00E608  1  A9 CB                lda #>TOP
00E60A  1  E5 21                sbc T+1
00E60C  1  85 13                sta GE+1
00E60E  1  85 1D                sta P+1
00E610  1  A9 00                lda #<BUF
00E612  1  85 1E                sta Q
00E614  1  85 10                sta GS
00E616  1  A9 04                lda #>BUF
00E618  1  85 1F                sta Q+1
00E61A  1  85 11                sta GS+1
00E61C  1  20 4F E6             jsr copydown
00E61F  1  A9 00                lda #0
00E621  1  85 16                sta CURLINE
00E623  1  85 17                sta CURLINE+1
00E625  1  85 14                sta TOPPOS
00E627  1  85 15                sta TOPPOS+1
00E629  1  85 18                sta LEFTCOL
00E62B  1  85 19                sta WANTCOL
00E62D  1  60                   rts
00E62E  1               
00E62E  1               ; Copies T bytes from (Q) to (P), lowest address first (P < Q)
00E62E  1               copyup:
00E62E  1  A0 00                ldy #0
00E630  1  A6 21                ldx T+1
00E632  1  F0 0E                beq @last
00E634  1  B1 1E        @page:  lda (Q),y
00E636  1  91 1C                sta (P),y
00E638  1  C8                   iny
00E639  1  D0 F9                bne @page
00E63B  1  E6 1F                inc Q+1
00E63D  1  E6 1D                inc P+1
00E63F  1  CA                   dex
00E640  1  D0 F2                bne @page
00E642  1  A6 20        @last:  ldx T
00E644  1  F0 08                beq @done
00E646  1  B1 1E        @byte:  lda (Q),y
00E648  1  91 1C                sta (P),y
00E64A  1  C8                   iny
00E64B  1  CA                   dex
00E64C  1  D0 F8                bne @byte
00E64E  1  60           @done:  rts
00E64F  1               
00E64F  1               ; Copies T bytes from (Q) to (P), highest address first (P > Q)
00E64F  1               copydown:
00E64F  1  A5 20                lda T                   ; nothing to do?
00E651  1  05 21                ora T+1
00E653  1  F0 3E                beq @done
00E655  1  18                   clc                     ; point at the last byte of each block
00E656  1  A5 1E                lda Q
00E658  1  65 20                adc T
00E65A  1  85 1E                sta Q
00E65C  1  A5 1F                lda Q+1
00E65E  1  65 21                adc T+1
00E660  1  85 1F                sta Q+1
00E662  1  18                   clc
00E663  1  A5 1C                lda P
00E665  1  65 20                adc T
00E667  1  85 1C                sta P
00E669  1  A5 1D                lda P+1
00E66B  1  65 21                adc T+1
00E66D  1  85 1D                sta P+1
00E66F  1  A5 1E        @loop:  lda Q
00E671  1  D0 02                bne :+
00E673  1  C6 1F                dec Q+1
00E675  1  C6 1E        :       dec Q
00E677  1  A5 1C                lda P
00E679  1  D0 02                bne :+
00E67B  1  C6 1D                dec P+1
00E67D  1  C6 1C        :       dec P
00E67F  1  A0 00                ldy #0
00E681  1  B1 1E                lda (Q),y
00E683  1  91 1C                sta (P),y
00E685  1  A5 20                lda T
00E687  1  D0 02                bne :+
00E689  1  C6 21                dec T+1
00E68B  1  C6 20        :       dec T
00E68D  1  A5 20                lda T
00E68F  1  05 21                ora T+1
00E691  1  D0 DC                bne @loop
00E693  1  60           @done:  rts
00E694  1               
00E694  1               ; In BUF..GS: CR LF -> CR, LF -> CR (the text gets shorter, GS moves down)
00E694  1               fixlf:
00E694  1  A9 00                lda #<BUF
00E696  1  85 1C                sta P                   ; read
00E698  1  85 1E                sta Q                   ; write
00E69A  1  A9 04                lda #>BUF
00E69C  1  85 1D                sta P+1
00E69E  1  85 1F                sta Q+1
00E6A0  1  A9 00                lda #0
00E6A2  1  85 2F                sta KEY                 ; previous character
00E6A4  1  A5 1C        @loop:  lda P
00E6A6  1  C5 10                cmp GS
00E6A8  1  D0 06                bne @go
00E6AA  1  A5 1D                lda P+1
00E6AC  1  C5 11                cmp GS+1
00E6AE  1  F0 25                beq @end
00E6B0  1  A0 00        @go:    ldy #0
00E6B2  1  B1 1C                lda (P),y
00E6B4  1  E6 1C                inc P
00E6B6  1  D0 02                bne :+
00E6B8  1  E6 1D                inc P+1
00E6BA  1  C9 0A        :       cmp #LF
00E6BC  1  D0 08                bne @store
00E6BE  1  A6 2F                ldx KEY                 ; LF after CR: drop it
00E6C0  1  E0 0D                cpx #CR
00E6C2  1  F0 0C                beq @next
00E6C4  1  A9 0D                lda #CR
00E6C6  1  A0 00        @store: ldy #0
00E6C8  1  91 1E                sta (Q),y
00E6CA  1  E6 1E                inc Q
00E6CC  1  D0 02                bne :+
00E6CE  1  E6 1F                inc Q+1
00E6D0  1               :
00E6D0  1  85 2F        @next:  sta KEY
00E6D2  1  4C A4 E6             jmp @loop
00E6D5  1  A5 1E        @end:   lda Q
00E6D7  1  85 10                sta GS
00E6D9  1  A5 1F                lda Q+1
00E6DB  1  85 11                sta GS+1
00E6DD  1  60                   rts
00E6DE  1               
00E6DE  1               ; --- screen --------------------------------------------------------------------
00E6DE  1               
00E6DE  1               ; Logical position (POS) -> character in A, carry set past the end
00E6DE  1               getc:
00E6DE  1  A5 22                lda POS
00E6E0  1  85 1C                sta P
00E6E2  1  18                   clc
00E6E3  1  A5 23                lda POS+1
00E6E5  1  69 04                adc #>BUF
00E6E7  1  85 1D                sta P+1                 ; P = BUF + POS
00E6E9  1  A5 1C                lda P
00E6EB  1  C5 10                cmp GS
00E6ED  1  A5 1D                lda P+1
00E6EF  1  E5 11                sbc GS+1
00E6F1  1  90 24                bcc @read               ; before the gap
00E6F3  1  38                   sec                     ; after it: P = GE + (P - GS)
00E6F4  1  A5 1C                lda P
00E6F6  1  E5 10                sbc GS
00E6F8  1  85 20                sta T
00E6FA  1  A5 1D                lda P+1
00E6FC  1  E5 11                sbc GS+1
00E6FE  1  85 21                sta T+1
00E700  1  18                   clc
00E701  1  A5 20                lda T
00E703  1  65 12                adc GE
00E705  1  85 1C                sta P
00E707  1  A5 21                lda T+1
00E709  1  65 13                adc GE+1
00E70B  1  85 1D                sta P+1
00E70D  1  A5 1C                lda P
00E70F  1  C9 F0                cmp #<TOP
00E711  1  A5 1D                lda P+1
00E713  1  E9 CB                sbc #>TOP
00E715  1  B0 06                bcs @end
00E717  1  A0 00        @read:  ldy #0
00E719  1  B1 1C                lda (P),y
00E71B  1  18                   clc
00E71C  1  60                   rts
00E71D  1  38           @end:   sec
00E71E  1  60                   rts
00E71F  1               
00E71F  1               incpos:
00E71F  1  E6 22                inc POS
00E721  1  D0 02                bne :+
00E723  1  E6 23                inc POS+1
00E725  1  60           :       rts
00E726  1               
00E726  1               ; Keeps the cursor on screen: TOPPOS, CURROW, LEFTCOL, COL
00E726  1               fixview:
00E726  1  20 B8 E3             jsr column
00E729  1                       ; cursor position (logical) = GS - BUF
00E729  1  38                   sec
00E72A  1  A5 10                lda GS
00E72C  1  E9 00                sbc #<BUF
00E72E  1  85 20                sta T
00E730  1  A5 11                lda GS+1
00E732  1  E9 04                sbc #>BUF
00E734  1  85 21                sta T+1
00E736  1                       ; above the screen? TOPPOS = start of the cursor line
00E736  1  A5 20                lda T
00E738  1  C5 14                cmp TOPPOS
00E73A  1  A5 21                lda T+1
00E73C  1  E5 15                sbc TOPPOS+1
00E73E  1  B0 11                bcs @below
00E740  1  38                   sec
00E741  1  A5 20                lda T
00E743  1  E5 1A                sbc COL
00E745  1  85 14                sta TOPPOS
00E747  1  A5 21                lda T+1
00E749  1  E9 00                sbc #0
00E74B  1  85 15                sta TOPPOS+1
00E74D  1  A9 02                lda #2
00E74F  1  85 26                sta REDRAW
00E751  1               @below: ; rows between TOPPOS and the cursor (all before the gap)
00E751  1  20 8A E7             jsr countrows
00E754  1  C9 18                cmp #TEXTROWS
00E756  1  90 10                bcc @rowok
00E758  1                       ; too far down: move TOPPOS down one line at a time
00E758  1  20 BA E7     @down:  jsr topnext
00E75B  1  20 8A E7             jsr countrows
00E75E  1  C9 18                cmp #TEXTROWS
00E760  1  B0 F6                bcs @down
00E762  1  48                   pha
00E763  1  A9 02                lda #2
00E765  1  85 26                sta REDRAW
00E767  1  68                   pla
00E768  1  85 1B        @rowok: sta CURROW
00E76A  1                       ; sideways
00E76A  1  A5 1A                lda COL
