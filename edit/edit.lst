000000r 1               ;=============================================================================
000000r 1               ; edit.asm - full-screen text editor for mini6502          (bank RAM $E000-$EFFF)
000000r 1               ;-----------------------------------------------------------------------------
000000r 1               ; Public domain.
000000r 1               ;
000000r 1               ;   L EDIT E000 13      load the editor into bank $13 (any bank below $E0)
000000r 1               ; Start it from the monitor or from BASIC, with its bank selected:
000000r 1               ;   E000R / CALL $E000  start with an empty text
000000r 1               ;   E003R / CALL $E003  carry on with the text from last time (empty if none)
000000r 1               ; The whole fixed RAM ($0000-$CBFF) of the caller is saved to banks $F0-$FC
000000r 1               ; first, and the editor gets its own copy (kept in banks $E0-$EC while away),
000000r 1               ; so BASIC and its program stay alive. Esc puts the caller's RAM back and
000000r 1               ; returns to it (RTS): to BASIC after a CALL, to the monitor after R.
000000r 1               ; While editing, G is pointed at a stub at $CBF0 (in the editor's RAM) that
000000r 1               ; selects the editor's bank: after F1, G resumes; Esc then still returns to
000000r 1               ; the caller, and the caller's G is put back.
000000r 1               ;
000000r 1               ; Keys
000000r 1               ;   arrows, Home, End, PgUp, PgDn    move           Enter       new line
000000r 1               ;   Backspace / Delete               erase          Tab         spaces to
000000r 1               ;   Ctrl+S  save    Ctrl+L  load    Ctrl+N  new                 the next 8th
000000r 1               ;   Esc     back to the caller (text kept)                      column
000000r 1               ;   Typed letters follow F6 (CAPS): switch it off for lower case.
000000r 1               ;
000000r 1               ; Files are plain text in the mini6502 disk folder (the usual 2-byte load
000000r 1               ; address first). Lines end with CR; LF and CR LF are turned into CR when a
000000r 1               ; file is loaded, so text from elsewhere works too.
000000r 1               ;
000000r 1               ; Memory (in the editor's own RAM image): text $0400-$CBEF (51,184 bytes, as
000000r 1               ; a gap buffer), state in zero page $10-$3F and page 3 ($0300-$035F), stub
000000r 1               ; $CBF0-$CBF7. Banks $E0-$EC and $F0-$FC hold the two RAM images; $EFF0-$EFF6
000000r 1               ; in the editor's bank says which one is in the RAM.
000000r 1               ; Limits: columns past 255 are not shown; lines longer than 80 columns
000000r 1               ; scroll the whole screen sideways.
000000r 1               ;=============================================================================
000000r 1               
000000r 1               ; --- mini6502 I/O --------------------------------------------------------------
000000r 1                       .include "mini6502.inc"     ; the registers (hw/mini6502.inc)
000000r 2               ; mini6502.inc - made by hw/gen.py from hw/mini6502.def: edit that, not this.
000000r 2               ; The mini6502's registers, banks, far-call entries and system calls.
000000r 2               ; In a program: .include "mini6502.inc" (ca65 -I path/to/hw). Including it
000000r 2               ; twice is fine.
000000r 2               
000000r 2               .ifndef MINI6502_INC
000000r 2               MINI6502_INC = 1
000000r 2               
000000r 2               ; registers
000000r 2               SYSCTL      = $D000   ; read/write
000000r 2               FRAME       = $D001   ; read
000000r 2               WARMLO      = $D002   ; read/write
000000r 2               WARMHI      = $D003   ; read/write
000000r 2               CLOCKH      = $D004   ; read
000000r 2               CLOCKM      = $D005   ; read
000000r 2               CLOCKS      = $D006   ; read
000000r 2               IRQEN       = $D007   ; read/write
000000r 2               IRQFLAGS    = $D008   ; read
000000r 2               IRQBANK     = $D009   ; read/write
000000r 2               IRQVEC      = $D00A   ; read/write, 2 bytes
000000r 2               KBD         = $D010   ; read
000000r 2               KBDCR       = $D011   ; read
000000r 2               DSP         = $D012   ; write
000000r 2               DSPCR       = $D013   ; reads 0
000000r 2               KBDPEEK     = $D014   ; read
000000r 2               CURX        = $D015   ; read/write
000000r 2               CURY        = $D016   ; read/write
000000r 2               VCHR        = $D017   ; read/write
000000r 2               VCOL        = $D018   ; read/write
000000r 2               KBDEXT      = $D019   ; read
000000r 2               BANK        = $D020   ; read/write
000000r 2               COLOR       = $D021   ; read/write
000000r 2               SND         = $D030   ; read/write, 16 bytes
000000r 2               V1          = $D030   ; read/write, 4 bytes
000000r 2               V2          = $D034   ; read/write, 4 bytes
000000r 2               V3          = $D038   ; read/write, 4 bytes
000000r 2               V4          = $D03C   ; read/write, 4 bytes
000000r 2               SHP         = $D050   ; read/write, 16 bytes
000000r 2               S1          = $D050   ; read/write, 4 bytes
000000r 2               S2          = $D054   ; read/write, 4 bytes
000000r 2               S3          = $D058   ; read/write, 4 bytes
000000r 2               S4          = $D05C   ; read/write, 4 bytes
000000r 2               BEEP        = $D100   ; read/write
000000r 2               DCMD        = $D040   ; read/write
000000r 2               DSTAT       = $D041   ; read/write
000000r 2               DSTART      = $D042   ; read/write, 2 bytes
000000r 2               DEND        = $D044   ; read/write, 2 bytes
000000r 2               DNAME       = $D046   ; read/write, 2 bytes
000000r 2               DNLEN       = $D048   ; read/write
000000r 2               PADR        = $D200   ; read/write, 3 bytes
000000r 2               PDATA       = $D203   ; read/write
000000r 2               PSTEP       = $D204   ; read/write
000000r 2               PBADR       = $D208   ; read/write, 3 bytes
000000r 2               PBDATA      = $D20B   ; read/write
000000r 2               PBSTEP      = $D20C   ; read/write
000000r 2               DMASRC      = $D210   ; read/write, 3 bytes
000000r 2               DMADST      = $D213   ; read/write, 3 bytes
000000r 2               DMALEN      = $D216   ; read/write, 3 bytes
000000r 2               DMACMD      = $D219   ; read/write
000000r 2               DMAFILL     = $D21A   ; read/write
000000r 2               DMASTAT     = $D21B   ; read
000000r 2               VID         = $D300   ; read/write, 64 bytes
000000r 2               MODE        = $D300   ; read/write
000000r 2               SHOW        = $D301   ; read/write
000000r 2               DRAW        = $D302   ; read/write
000000r 2               INTENS      = $D303   ; read/write
000000r 2               MASTER      = $D304   ; read/write
000000r 2               TRANSP      = $D305   ; read/write
000000r 2               INK         = $D306   ; read/write
000000r 2               PAPER       = $D307   ; read/write
000000r 2               PALIDX      = $D308   ; read/write
000000r 2               PALR        = $D309   ; read/write
000000r 2               PALG        = $D30A   ; read/write
000000r 2               PALB        = $D30B   ; read/write
000000r 2               BX0         = $D310   ; read/write
000000r 2               BY0         = $D311   ; read/write
000000r 2               BX1         = $D312   ; read/write
000000r 2               BY1         = $D313   ; read/write
000000r 2               BCOL        = $D314   ; read/write
000000r 2               BDX         = $D315   ; read/write
000000r 2               BDY         = $D316   ; read/write
000000r 2               BSRC        = $D317   ; read/write
000000r 2               BCMD        = $D318   ; read/write
000000r 2               BPIXEL      = $D319   ; read
000000r 2               BX0H        = $D31A   ; read/write
000000r 2               BY0H        = $D31B   ; read/write
000000r 2               BX1H        = $D31C   ; read/write
000000r 2               BY1H        = $D31D   ; read/write
000000r 2               BDXH        = $D31E   ; read/write
000000r 2               BDYH        = $D31F   ; read/write
000000r 2               COLLSS      = $D320   ; read, 4 bytes
000000r 2               COLLBG      = $D324   ; read, 4 bytes
000000r 2               ROP         = $D328   ; read/write
000000r 2               PATON       = $D329   ; read/write
000000r 2               CHR         = $D32A   ; read/write
000000r 2               STYLE       = $D32B   ; read/write
000000r 2               CHOUT       = $D32C   ; read/write
000000r 2               PATTERN     = $D330   ; read/write, 8 bytes
000000r 2               CLIPR       = $D338   ; read/write, 8 bytes
000000r 2               SPR         = $D400   ; read/write, 256 bytes
000000r 2               MOUSEX      = $D500   ; read, 2 bytes
000000r 2               MOUSEY      = $D502   ; read, 2 bytes
000000r 2               BUTTONS     = $D504   ; read
000000r 2               WHEEL       = $D505   ; read
000000r 2               CLICKS      = $D506   ; read
000000r 2               PTR         = $D508   ; read/write
000000r 2               PTRX        = $D509   ; read/write, 2 bytes
000000r 2               PTRY        = $D50B   ; read/write, 2 bytes
000000r 2               HOTX        = $D50D   ; read/write
000000r 2               HOTY        = $D50E   ; read/write
000000r 2               PTRIMG      = $D510   ; read/write, 32 bytes
000000r 2               PTRMASK     = $D530   ; read/write, 32 bytes
000000r 2               MOUSELX     = $D550   ; read
000000r 2               MOUSELY     = $D551   ; read
000000r 2               MOUSECOL    = $D552   ; read
000000r 2               MOUSEROW    = $D553   ; read
000000r 2               ; numbers
000000r 2               IRQ_FRAME   = 1
000000r 2               IRQ_KEY     = 2
000000r 2               IRQ_MOUSE   = 4
000000r 2               V_NOTE      = 0
000000r 2               V_VOL       = 1
000000r 2               V_WAVE      = 2
000000r 2               V_DUR       = 3
000000r 2               S_DECAY     = 0
000000r 2               S_SWEEP     = 1
000000r 2               S_PULSE     = 2
000000r 2               S_BEND      = 3
000000r 2               C_CLEAR     = 1
000000r 2               C_PSET      = 2
000000r 2               C_LINE      = 3
000000r 2               C_BOX       = 4
000000r 2               C_BOXF      = 5
000000r 2               C_COPY      = 6
000000r 2               C_COPYT     = 7
000000r 2               C_DIM       = 8
000000r 2               C_UNDIM     = 9
000000r 2               C_STAMP     = $0A
000000r 2               C_CHAR      = $0B
000000r 2               VTAB        = $CC00
000000r 2               VTCOUNT     = $CC02
000000r 2               VTENTRY     = $CC08
000000r 2               VTMAX       = $28
000000r 2               VTNAMES     = $CD48
000000r 2               BANKMAP     = $CF00
000000r 2               FARCALL     = $FFD0
000000r 2               ; bank zones (first, last)
000000r 2               Z_BASICEXT  = 0       ; EhBASIC extensions (kept free for them)
000000r 2               Z_BASICEXT_END= 7
000000r 2               Z_USER      = 8       ; yours: load by hand; never handed out
000000r 2               Z_USER_END  = $0F
000000r 2               Z_SYSTEM    = $10     ; the system's programs
000000r 2               Z_SYSTEM_END= $1F
000000r 2               Z_PROGRAMS  = $20     ; programs (the allocator hands these out)
000000r 2               Z_PROGRAMS_END= $7F
000000r 2               Z_DOCUMENTS = $80     ; documents, songs, data (handed out too)
000000r 2               Z_DOCUMENTS_END= $BF
000000r 2               Z_SWAP      = $C0     ; the fixed RAM's copies while programs swap it
000000r 2               Z_SWAP_END  = $FF
000000r 2               ; fixed banks
000000r 2               B_LULLABY   = 8       ; the lullaby demo (BOOT.TXT loads it)
000000r 2               B_TK1       = $10     ; the toolkit, part 1 (TK1)
000000r 2               B_TK2       = $11     ; the toolkit, part 2 (TK2)
000000r 2               B_MUSIC     = $12     ; the music engine (MUSIC)
000000r 2               B_EDIT      = $13     ; the editor (EDIT)
000000r 2               B_DESK1     = $14     ; the desktop, part 1 (DESK1)
000000r 2               B_DESK2     = $15     ; the desktop, part 2 (DESK2)
000000r 2               B_DESK3     = $16     ; the desktop, part 3: icons (DESK3)
000000r 2               B_LAUNCH    = $20     ; where the desktop loads bank programs
000000r 2               B_DESKSAVE  = $C0     ; the desktop's RAM while a program runs
000000r 2               B_TKSWAP    = $D0     ; the caller's RAM while a toolkit program runs
000000r 2               B_EDITIMG   = $E0     ; the editor's RAM while away
000000r 2               B_EDITWORLD = $F0     ; the caller's RAM while editing
000000r 2               ; far-call entries: E_NAME = its address (JSR E_NAME), EN_NAME = its number
000000r 2               E_LULLABY   = $CC08   ; plays the lullaby
000000r 2               EN_LULLABY  = 0
000000r 2               E_EDITNEW   = $CC10   ; the editor, with an empty text
000000r 2               EN_EDITNEW  = 1
000000r 2               E_EDIT      = $CC18   ; the editor, with the text as it was (BASIC: CALL EDIT)
000000r 2               EN_EDIT     = 2
000000r 2               E_TOOLKIT   = $CC88   ; the toolkit: LDA #function, JSR
000000r 2               EN_TOOLKIT  = $10
000000r 2               E_DESKTOP   = $CC90   ; the desktop (BASIC: CALL DESKTOP)
000000r 2               EN_DESKTOP  = $11
000000r 2               E_MUSIC     = $CCD0   ; the music engine: LDA #function, LDX #arg, JSR
000000r 2               EN_MUSIC    = $19
000000r 2               E_MUSICB    = $CCD8   ; the music engine from BASIC (mailbox $CCDE)
000000r 2               EN_MUSICB   = $1A
000000r 2               E_RESUME    = $CC98   ; the desktop: back from a program (G after F1)
000000r 2               EN_RESUME   = $12
000000r 2               E_LAUNCH    = $CCA0   ; the desktop: calls a program, then RESUME
000000r 2               EN_LAUNCH   = $13
000000r 2               E_TARGET    = $CCB0   ; the desktop: the program being started
000000r 2               EN_TARGET   = $15
000000r 2               E_BANKLD    = $CCB8   ; the desktop: disk LOAD into the launch bank
000000r 2               EN_BANKLD   = $16
000000r 2               ; bank map owners
000000r 2               OWN_FREE    = 0       ; free
000000r 2               OWN_MAIN    = $FD     ; a main-RAM program (started from the desktop)
000000r 2               OWN_HAND    = $FE     ; loaded by hand (L ... BB in the monitor)
000000r 2               OWN_SYSTEM  = $FF     ; reserved: zones and banks that are never handed out
000000r 2               ; system calls in the ROM
000000r 2               BALLOC      = $FFB0   ; A = owner, X = how many banks (next to each other), Y = 0 pr
000000r 2               BFREE       = $FFB3   ; A = bank
000000r 2               BFREEALL    = $FFB6   ; A = owner
000000r 2               BCLAIM      = $FFB9   ; A = owner, X = bank
000000r 2               VFIND       = $FFBC   ; X/Y = address of a name (low, high; up to 8 characters, endi
000000r 2               BOWNER      = $FFBF   ; A = bank
000000r 2               
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               MONITOR = $FF1F
000000r 1               
000000r 1               ; --- memory --------------------------------------------------------------------
000000r 1               BUF     = $0400         ; text buffer start (page aligned: low byte 0)
000000r 1               TOP     = $CBF0         ; text buffer end (exclusive)
000000r 1               STUB    = $CBF0         ; 8 bytes: LDA #bank / STA BANK / JMP warm
000000r 1               
000000r 1               SWAPLEN = $CC00         ; RAM swapped with the caller: $0000-$CBFF
000000r 1               IMAGE   = $0E0000       ; the editor's RAM while away (banks $E0-$EC)
000000r 1               WORLD   = $0F0000       ; the caller's RAM while editing (banks $F0-$FC)
000000r 1               
000000r 1               ; in the editor's own bank, after the code (not swapped, not in EDIT's file)
000000r 1               INSIDE  = $EFF0         ; INMAGIC while the RAM holds the editor's image
000000r 1               INMAGIC = $A5
000000r 1               SAVSP   = $EFF1         ; the caller's stack pointer
000000r 1               SAVWLO  = $EFF2         ; the caller's warm start (WARMLO/HI)
000000r 1               SAVWHI  = $EFF3
000000r 1               SAVCOL  = $EFF4         ; the caller's COLOR
000000r 1               RETLO   = $EFF5         ; enter's return address
000000r 1               RETHI   = $EFF6
000000r 1               OPENREQ = $EFF7         ; 1: started by $E006
000000r 1               SAVIRQ  = $EFF8         ; the caller's IRQEN, when its handler is in its RAM
000000r 1               OPENNAME = $EF80        ; the file name for $E006 (up to 40 characters + 0)
000000r 1               
000000r 1               GS      = $10           ; 2: gap start = the cursor (text before it: BUF..GS)
000000r 1               GE      = $12           ; 2: gap end (text after the cursor: GE..TOP)
000000r 1               TOPPOS  = $14           ; 2: logical position of the first line on screen
000000r 1               CURLINE = $16           ; 2: cursor line, 0-based
000000r 1               LEFTCOL = $18           ; first column shown
000000r 1               WANTCOL = $19           ; column kept while moving up and down
000000r 1               COL     = $1A           ; cursor column (0-255, saturates)
000000r 1               CURROW  = $1B           ; cursor row on screen
000000r 1               P       = $1C           ; 2: pointer
000000r 1               Q       = $1E           ; 2: pointer
000000r 1               T       = $20           ; 2: temporary / count
000000r 1               POS     = $22           ; 2: logical position while drawing
000000r 1               ROW     = $24
000000r 1               CNT     = $25
000000r 1               REDRAW  = $26           ; 0 nothing, 1 cursor line, 2 everything
000000r 1               MODIFIED = $27          ; nonzero: unsaved changes
000000r 1               TXTCOL  = $28           ; COLOR for text
000000r 1               MYBANK  = $29           ; the bank the editor runs in
000000r 1               NUM     = $2A           ; 2: number to print in decimal
000000r 1               NZ      = $2C           ; digit printed (leading zero suppression)
000000r 1               MSG     = $2D           ; 2: message for the status line, 0 = none
000000r 1               KEY     = $2F
000000r 1               DP      = $30           ; 2: text pointer while drawing (jumps over the gap)
000000r 1               
000000r 1               SIG     = $0300         ; "ED" when the state below is valid
000000r 1               NAMELEN = $0302
000000r 1               NAME    = $0310         ; file name (up to 40 characters)
000000r 1               INLEN   = $0340
000000r 1               INBUF   = $0350         ; name being typed (up to 40 characters)
000000r 1               NAMEMAX = 40
000000r 1               
000000r 1               CR      = $0D
000000r 1               LF      = $0A
000000r 1               ESC     = $1B
000000r 1               STATUSROW = 24
000000r 1               TEXTROWS  = 24
000000r 1               STCOLOR = $70           ; status line: black on light grey
000000r 1               
000000r 1               ; --- entry points --------------------------------------------------------------
000000r 1                       .org $E000
00E000  1               
00E000  1  4C 11 E0             jmp cold                ; $E000
00E003  1  4C 42 E0             jmp warm                ; $E003
00E006  1  4C 09 E0             jmp open                ; $E006: empty text, then load the file whose
00E009  1                                               ; name (0-terminated) is at OPENNAME
00E009  1               
00E009  1  D8           open:   cld
00E00A  1  A9 01                lda #1
00E00C  1  8D F7 EF             sta OPENREQ
00E00F  1  D0 06                bne cold2
00E011  1               cold:
00E011  1  D8                   cld
00E012  1  A9 00                lda #0
00E014  1  8D F7 EF             sta OPENREQ
00E017  1  20 77 E4     cold2:  jsr enter               ; BASIC/the caller's RAM goes to the banks
00E01A  1               newimage:
00E01A  1  A2 FF                ldx #$FF
00E01C  1  9A                   txs
00E01D  1  AD 20 D0             lda BANK                ; remember where we live
00E020  1  85 29                sta MYBANK
00E022  1  AD F4 EF             lda SAVCOL
00E025  1  85 28                sta TXTCOL
00E027  1  20 71 E5             jsr clearram            ; the editor's RAM image: $0300-$CBEF = 0
00E02A  1  20 54 E4             jsr newtext
00E02D  1  A9 45                lda #'E'
00E02F  1  8D 00 03             sta SIG
00E032  1  A9 44                lda #'D'
00E034  1  8D 01 03             sta SIG+1
00E037  1  A9 00                lda #0
00E039  1  8D 02 03             sta NAMELEN
00E03C  1  20 8C E5             jsr setstub
00E03F  1  4C 5F E0             jmp start
00E042  1               
00E042  1               warm:
00E042  1  D8                   cld
00E043  1  20 77 E4             jsr enter               ; swap in the editor's RAM image (text kept)
00E046  1  A2 FF                ldx #$FF
00E048  1  9A                   txs
00E049  1  AD 00 03             lda SIG                 ; state there?
00E04C  1  C9 45                cmp #'E'
00E04E  1  D0 CA                bne newimage            ; no: an empty text (already swapped in)
00E050  1  AD 01 03             lda SIG+1
00E053  1  C9 44                cmp #'D'
00E055  1  D0 C3                bne newimage
00E057  1  AD 20 D0             lda BANK
00E05A  1  85 29                sta MYBANK
00E05C  1  20 8C E5             jsr setstub
00E05F  1               start:
00E05F  1  A5 28                lda TXTCOL
00E061  1  8D 21 D0             sta COLOR
00E064  1  A9 02                lda #2
00E066  1  8D 00 D0             sta SYSCTL              ; clear the screen
00E069  1  A9 02                lda #2
00E06B  1  85 26                sta REDRAW
00E06D  1  A9 00                lda #0
00E06F  1  85 2E                sta MSG+1
00E071  1  AD F7 EF             lda OPENREQ             ; started by $E006: load the file
00E074  1  F0 1A                beq mainloop
00E076  1  A9 00                lda #0
00E078  1  8D F7 EF             sta OPENREQ
00E07B  1  A2 00                ldx #0
00E07D  1  BD 80 EF     @n:     lda OPENNAME,x
00E080  1  F0 08                beq @nd
00E082  1  9D 50 03             sta INBUF,x
00E085  1  E8                   inx
00E086  1  E0 28                cpx #NAMEMAX
00E088  1  D0 F3                bne @n
00E08A  1  8E 40 03     @nd:    stx INLEN
00E08D  1  20 95 E2             jsr doload
00E090  1               
00E090  1               ; --- main loop -----------------------------------------------------------------
00E090  1               mainloop:
00E090  1  20 26 E7             jsr fixview
00E093  1  A5 26                lda REDRAW
00E095  1  F0 0D                beq @status
00E097  1  C9 01                cmp #1
00E099  1  F0 06                beq @line
00E09B  1  20 D7 E7             jsr drawall
00E09E  1  4C A4 E0             jmp @status
00E0A1  1  20 F2 E7     @line:  jsr drawcur
00E0A4  1               @status:
00E0A4  1  20 97 E8             jsr drawstatus
00E0A7  1  A9 00                lda #0
00E0A9  1  85 26                sta REDRAW
00E0AB  1  A5 1B                lda CURROW              ; put the cursor where it belongs
00E0AD  1  8D 16 D0             sta CURY
00E0B0  1  38                   sec
00E0B1  1  A5 1A                lda COL
00E0B3  1  E5 18                sbc LEFTCOL
00E0B5  1  8D 15 D0             sta CURX
00E0B8  1  20 C7 E0             jsr getkey
00E0BB  1  85 2F                sta KEY
00E0BD  1  A9 00                lda #0
00E0BF  1  85 2E                sta MSG+1               ; a message lasts until the next key
00E0C1  1  20 DB E0             jsr dokey
00E0C4  1  4C 90 E0             jmp mainloop
00E0C7  1               
00E0C7  1               ; Waits for a key: A = character, or $81-$8A for the extended keys
00E0C7  1               getkey:
00E0C7  1  AD 11 D0             lda KBDCR
00E0CA  1  10 FB                bpl getkey
00E0CC  1  AD 10 D0             lda KBD
00E0CF  1  29 7F                and #$7F
00E0D1  1  D0 07                bne @done
00E0D3  1  AD 19 D0             lda KBDEXT
00E0D6  1  F0 EF                beq getkey              ; a real NUL: ignore it
00E0D8  1  09 80                ora #$80
00E0DA  1  60           @done:  rts
00E0DB  1               
00E0DB  1               dokey:
00E0DB  1  A5 2F                lda KEY
00E0DD  1  C9 81                cmp #$81
00E0DF  1  D0 03                bne :+
00E0E1  1  4C 08 E2             jmp k_up
00E0E4  1  C9 82        :       cmp #$82
00E0E6  1  D0 03                bne :+
00E0E8  1  4C 0C E2             jmp k_down
00E0EB  1  C9 83        :       cmp #$83
00E0ED  1  D0 03                bne :+
00E0EF  1  4C F0 E1             jmp k_left
00E0F2  1  C9 84        :       cmp #$84
00E0F4  1  D0 03                bne :+
